generator client {
  provider        = "prisma-client-js"
  // Carrega as relações (include) numa consulta só, com JOIN, em vez de uma consulta por
  // relação. Cada ida ao Supabase custa caro a partir do Render: telas com include ficaram
  // várias vezes mais rápidas. Não muda o banco nem as migrações, só o SQL gerado.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                   String         @id @default(uuid())
  nome                 String
  email                String         @unique
  tipoDocumento        TipoDocumento?
  cpfCnpj              String?        @unique
  passaporte           String?        @unique
  paisOrigem           String?
  senhaHash            String?
  papel                Papel          @default(ALUNO)
  escolaridade         String?
  escolaridadeSituacao String?
  genero               String?
  cep                  String?
  logradouro           String?
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String?
  uf                   String?
  emailVerificado      Boolean        @default(false)
  loginFalhas          Int            @default(0)
  bloqueadoAte         DateTime?
  loginStrikes         Int            @default(0)
  bloqueioTotal        Boolean        @default(false)
  avatarUrl            String?
  consentimentoLgpdEm  DateTime?
  consentimentoVersao  String?
  criadoEm             DateTime       @default(now())
  atualizadoEm         DateTime       @updatedAt
  celular              String?
  rg                   String?
  ultimoLogin          DateTime?
  ultimaAtividade      DateTime?
  matriculas           Matricula[]
  inscricoesOnline     InscricaoOnline[]

  @@index([papel])
  @@index([ultimaAtividade])
}

model Curso {
  id                 String     @id @default(uuid())
  nome               String
  descricao          String?
  cargaHoraria       Int
  escolaridadeMinima String?
  imagemUrl          String?
  precoAvista        Decimal    @db.Decimal(10, 2)
  precoCheio         Decimal    @db.Decimal(10, 2)
  parcelas           Int        @default(1)
  valorParcela       Decimal    @db.Decimal(10, 2)
  taxaMatricula      Decimal?   @db.Decimal(10, 2)
  ativo              Boolean    @default(true)
  criadoEm          DateTime   @default(now())
  descricaoLonga     String?
  // Escola Digital: PRESENCIAL (padrão, tudo como era) ou ONLINE. Os dois prazos só
  // valem para curso ONLINE; nulos nos cursos existentes.
  modalidade               ModalidadeCurso @default(PRESENCIAL)
  prazoAcessoDias          Int?
  validadeCertificadoMeses Int?
  faqs               FaqCurso[]
  turmas             Turma[]
  modulosOnline      ModuloOnline[]
  inscricoesOnline   InscricaoOnline[]
}

model FaqCurso {
  id       String   @id @default(uuid())
  cursoId  String
  pergunta String
  resposta String
  ordem    Int      @default(0)
  criadoEm DateTime @default(now())
  curso    Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@index([cursoId])
}

model Turma {
  id             String      @id @default(uuid())
  cursoId        String
  inicioPrevisto DateTime @default(now())
  vagas          Int         @default(30)
  minimoAlunos   Int         @default(15)
  status         StatusTurma @default(ABERTA)
  criadoEm       DateTime    @default(now())
  aulas          AulaData[]
  matriculas     Matricula[]
  curso          Curso       @relation(fields: [cursoId], references: [id])
}

model AulaData {
  id      String   @id @default(uuid())
  turmaId String
  data    DateTime @db.Date
  horario String
  turma   Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([turmaId])
  @@index([data])
}

model Matricula {
  id                  String             @id @default(uuid())
  alunoId             String
  turmaId             String
  plano               PlanoPagamento
  forma               FormaPagamento
  valorCurso          Decimal            @db.Decimal(10, 2)
  valorTaxaMatricula  Decimal            @default(0) @db.Decimal(10, 2)
  alimentoEntregue    Boolean            @default(false)
  alimentoEntreguePor String?
  alimentoEntregueEm  DateTime?
  taxaConfirmada      Boolean            @default(false)
  taxaConfirmadaPor   String?
  taxaConfirmadaEm    DateTime?
  statusPagamento     StatusPagamento    @default(PENDENTE)
  // avisoPagamentoEm    DateTime?
  // avisoPagamentoPor   String?
  // Prazo pra pagar o curso (3 dias antes do início da turma), calculado
  // no momento em que a taxa é confirmada. Null enquanto a taxa não foi
  // paga, ou se o plano não for PARCELADO (único que separa taxa/curso).
  prazoPagamentoCurso DateTime?
  lembreteImediatoEm  DateTime?
  lembreteVesperaEm   DateTime?
  nota                Float?
  situacao            SituacaoAcademica?
  confirmadaPor       String?
  confirmadaEm        DateTime?
  criadoEm            DateTime           @default(now())
  atualizadoEm        DateTime           @updatedAt
  avaliacoes          Avaliacao[]
  aluno               Usuario            @relation(fields: [alunoId], references: [id])
  turma               Turma              @relation(fields: [turmaId], references: [id])
  pagamentos          Pagamento[]
  diferencaTransferencia Decimal?

  @@unique([alunoId, turmaId])
}

model Pagamento {
  id              String          @id @default(uuid())
  matriculaId     String

  // NOVO: distingue se este Pagamento é a taxa de inscrição ou o valor do
  // curso. O webhook usa este campo para saber se deve atualizar
  // Matricula.taxaConfirmada ou Matricula.statusPagamento quando confirma.
  tipo            TipoPagamento   @default(CURSO)

  gateway         String?
  gatewayRef      String?
  gatewayHash     String?
  gatewayStatus   String?
  gatewayResponse Json?
  pixQrCode       String?         @db.Text
  pixUrl          String?         @db.Text
  pixBase64       String?         @db.Text
  metodo          FormaPagamento
  valor           Decimal         @db.Decimal(10, 2)
  status          StatusPagamento @default(PENDENTE)
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt
  matricula       Matricula       @relation(fields: [matriculaId], references: [id])

  @@index([matriculaId])
  @@index([gatewayRef])
  @@index([gatewayHash])
  @@index([status])
}

model TokenAuth {
  id        String    @id @default(uuid())
  usuarioId String
  tipo      String
  tokenHash String
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@index([usuarioId, tipo])
}

model Configuracao {
  chave String @id
  valor String
}

model LogAuditoria {
  id       String   @id @default(uuid())
  atorId   String
  acao     String
  alvoTipo String
  alvoId   String?
  detalhe  Json?
  criadoEm DateTime @default(now())

  @@index([atorId])
  @@index([acao])
  @@index([criadoEm])
}

model Avaliacao {
  id          String    @id @default(uuid())
  matriculaId String
  nome        String
  nota        Float
  peso        Float     @default(1)
  criadoEm    DateTime  @default(now())
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  @@index([matriculaId])
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

enum Papel {
  ALUNO
  SECRETARIA
  COORDENADOR
  FINANCEIRO
  CONSULTA
  DEV
}

enum TipoDocumento {
  CPF
  CNPJ
  PASSAPORTE
}

enum StatusTurma {
  ABERTA
  CONFIRMADA
  CANCELADA
  ENCERRADA
  CONGELADA
}

enum PlanoPagamento {
  A_VISTA
  PARCELADO
  PRESENCIAL
}

enum FormaPagamento {
  PIX
  DEBITO
  CREDITO
  DINHEIRO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  CANCELADO
  ESTORNADO
  PARCELADO
}

// NOVO: o que este Pagamento representa dentro da Matricula.
enum TipoPagamento {
  TAXA
  CURSO
}

enum SituacaoAcademica {
  APROVADO
  REPROVADO
}

// ---------------------------------------------------------------------------
// Escola Digital CVB-RJ (curso online). Só acréscimos: nada acima foi alterado
// além das colunas/relações novas em Curso e Usuario.
// ---------------------------------------------------------------------------

enum ModalidadeCurso {
  PRESENCIAL
  ONLINE
}

enum SituacaoInscricaoOnline {
  AGUARDANDO_PAGAMENTO
  ATIVA
  CONCLUIDA
  EXPIRADA
  CANCELADA
}

// Como o módulo foi dado por concluído.
enum ComoConcluiu {
  TELAS
  PRE_TESTE
  CENARIOS
}

enum TipoTeste {
  TOPICO
  PRE_TESTE
}

model ModuloOnline {
  id          String  @id @default(uuid())
  cursoId     String
  chave       String
  ordem       Int
  titulo      String
  minutos     Int     @default(0)
  abertura    String?
  imagemUrl   String?
  temPreTeste Boolean @default(true)
  final       Boolean @default(false)

  curso      Curso             @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  topicos    TopicoOnline[]
  cenarios   CenarioOnline[]
  concluidos ModuloConcluido[]
  tentativas TentativaTeste[]

  @@unique([cursoId, chave])
  @@index([cursoId])
}

model TopicoOnline {
  id       String @id @default(uuid())
  moduloId String
  chave    String
  ordem    Int
  titulo   String

  modulo     ModuloOnline     @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  telas      TelaOnline[]
  perguntas  PerguntaOnline[]
  tentativas TentativaTeste[]

  @@unique([moduloId, chave])
}

model TelaOnline {
  id            String  @id @default(uuid())
  topicoId      String
  chave         String
  ordem         Int
  titulo        String
  ancora        String
  imagemUrl     String?
  imagemAlt     String?
  videoId       String?
  videoTitulo   String?
  videoSegundos Int?
  revisao       Json    @default("[]")
  alerta        String?
  dica          String?

  topico TopicoOnline @relation(fields: [topicoId], references: [id], onDelete: Cascade)
  vistas TelaVista[]

  @@unique([topicoId, chave])
}

model PerguntaOnline {
  id           String  @id @default(uuid())
  topicoId     String
  chave        String
  enunciado    String
  alternativas Json
  correta      Int
  porque       String
  ativa        Boolean @default(true)

  topico TopicoOnline @relation(fields: [topicoId], references: [id], onDelete: Cascade)

  @@unique([topicoId, chave])
}

model CenarioOnline {
  id            String  @id @default(uuid())
  moduloId      String
  chave         String
  ordem         Int
  titulo        String
  cena          String
  imagemUrl     String?
  tempoSugerido Int

  modulo   ModuloOnline     @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  decisoes DecisaoCenario[]
  feitos   CenarioFeito[]

  @@unique([moduloId, chave])
}

model DecisaoCenario {
  id        String @id @default(uuid())
  cenarioId String
  ordem     Int
  pergunta  String
  opcoes    Json
  correta   Int
  fala      String

  cenario CenarioOnline @relation(fields: [cenarioId], references: [id], onDelete: Cascade)

  @@unique([cenarioId, ordem])
}

// Matrícula do aluno num curso ONLINE. alunoId e cursoId sem cascade (como Matricula):
// apagar aluno ou curso com inscrição tem que ser decisão explícita.
model InscricaoOnline {
  id                   String                  @id @default(uuid())
  alunoId              String
  cursoId              String
  situacao             SituacaoInscricaoOnline @default(AGUARDANDO_PAGAMENTO)
  plano                PlanoPagamento?
  forma                FormaPagamento?
  parcelas             Int                     @default(1)
  valor                Decimal?                @db.Decimal(10, 2)
  ativadaEm            DateTime?
  acessoAte            DateTime?
  concluidaEm          DateTime?
  certificadoValidoAte DateTime?
  codigoCertificado    String?                 @unique
  criadoEm             DateTime                @default(now())
  atualizadoEm         DateTime                @updatedAt

  aluno             Usuario           @relation(fields: [alunoId], references: [id])
  curso             Curso             @relation(fields: [cursoId], references: [id])
  pagamentos        PagamentoOnline[]
  telasVistas       TelaVista[]
  tentativas        TentativaTeste[]
  modulosConcluidos ModuloConcluido[]
  cenariosFeitos    CenarioFeito[]

  @@unique([alunoId, cursoId])
  @@index([cursoId])
}

// Pagamento é registro financeiro: apagar a inscrição com pagamentos falha (Restrict).
model PagamentoOnline {
  id              String          @id @default(uuid())
  inscricaoId     String
  metodo          FormaPagamento
  parcelas        Int             @default(1)
  valor           Decimal         @db.Decimal(10, 2)
  status          StatusPagamento @default(PENDENTE)
  gateway         String?
  gatewayRef      String?
  gatewayHash     String?
  gatewayStatus   String?
  gatewayResponse Json?
  pixQrCode       String?         @db.Text
  pixUrl          String?         @db.Text
  pixBase64       String?         @db.Text
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  inscricao InscricaoOnline @relation(fields: [inscricaoId], references: [id], onDelete: Restrict)

  @@index([inscricaoId])
  @@index([gatewayRef])
  @@index([gatewayHash])
  @@index([status])
}

model TelaVista {
  inscricaoId String
  telaId      String
  vistaEm     DateTime @default(now())

  inscricao InscricaoOnline @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  tela      TelaOnline      @relation(fields: [telaId], references: [id], onDelete: Cascade)

  @@id([inscricaoId, telaId])
  @@index([telaId])
}

model TentativaTeste {
  id          String    @id @default(uuid())
  inscricaoId String
  tipo        TipoTeste
  topicoId    String?
  moduloId    String?
  perguntas   Json
  respostas   Json      @default("[]")
  acertos     Int       @default(0)
  total       Int
  aprovado    Boolean   @default(false)
  finalizada  Boolean   @default(false)
  criadoEm    DateTime  @default(now())

  inscricao InscricaoOnline @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  topico    TopicoOnline?   @relation(fields: [topicoId], references: [id], onDelete: Cascade)
  modulo    ModuloOnline?   @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@index([inscricaoId])
  @@index([topicoId])
  @@index([moduloId])
}

model ModuloConcluido {
  inscricaoId String
  moduloId    String
  como        ComoConcluiu
  em          DateTime     @default(now())

  inscricao InscricaoOnline @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  modulo    ModuloOnline    @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@id([inscricaoId, moduloId])
  @@index([moduloId])
}

model CenarioFeito {
  inscricaoId String
  cenarioId   String
  escolhas    Json
  acertos     Int
  segundos    Int
  em          DateTime @default(now())

  inscricao InscricaoOnline @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  cenario   CenarioOnline   @relation(fields: [cenarioId], references: [id], onDelete: Cascade)

  @@id([inscricaoId, cenarioId])
  @@index([cenarioId])
}
