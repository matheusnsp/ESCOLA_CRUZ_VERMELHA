<%- include('partials/head', { titulo: 'Criar conta' }) %>

<main class="auth-wrap">
  <div class="auth-card auth-card-wide">

    <div class="auth-brand">
      <img src="/img/logo-cvb-rj.webp" alt="Cruz Vermelha Brasileira — Rio de Janeiro" class="auth-logo">
      <div class="auth-brand-text">
        <strong>ESCOLA DE EDUCAÇÃO</strong>
        <span>E SAÚDE CVB-RJ</span>
      </div>
    </div>

    <h1>Criar conta</h1>
    <p class="auth-sub">Preencha seus dados para se inscrever nos cursos.</p>

    <% if (erros && erros.length) { %>
      <div class="auth-erros" role="alert">
        <% erros.forEach(function (e) { %>
          <p><i class="fa-solid fa-circle-exclamation"></i> <%= e %></p>
        <% }) %>
      </div>
    <% } %>

    <form method="POST" action="/cadastro" class="auth-form-grid" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Nome -->
      <label class="auth-field full">
        <span>Nome completo</span>
        <input type="text" name="nome" value="<%= valores.nome || '' %>" required autocomplete="name">
        <small>Nome e sobrenome. Será usado no certificado.</small>
      </label>

      <!-- E-mail -->
      <label class="auth-field full">
        <span>E-mail</span>
        <input type="email" name="email" value="<%= valores.email || '' %>" required autocomplete="email">
      </label>

      <!-- Tipo de documento -->
      <div class="auth-field full">
        <span class="auth-bloco-rot">Tipo de cadastro</span>
        <div class="tipo-pessoa-toggle" role="group">
          <button type="button" class="tp-btn" data-tipo="CPF"><i class="fa-solid fa-user"></i> Pessoa física (CPF)</button>
          <button type="button" class="tp-btn" data-tipo="CNPJ"><i class="fa-solid fa-building"></i> Pessoa jurídica (CNPJ)</button>
          <button type="button" class="tp-btn" data-tipo="PASSAPORTE"><i class="fa-solid fa-passport"></i> Estrangeiro (Passaporte)</button>
        </div>
        <small id="tipo-hint" class="auth-hint">Escolha o tipo para preencher o documento.</small>
      </div>

      <input type="hidden" name="tipoDocumento" id="tipoDocumentoInput" value="<%= valores.tipoDocumento || '' %>">

      <label class="auth-field" id="campo-documento" hidden>
        <span id="label-documento">CPF</span>
        <input type="text" name="documento" value="<%= valores.documento || '' %>" inputmode="numeric"
               placeholder="000.000.000-00" maxlength="18" data-mask="cpfCnpj">
      </label>

      <label class="auth-field" id="campo-passaporte" hidden>
        <span>Número do passaporte</span>
        <input type="text" name="passaporte" value="<%= valores.passaporte || '' %>" maxlength="20"
               placeholder="Ex: AB1234567" autocomplete="off">
      </label>

      <label class="auth-field" id="campo-pais-origem" hidden>
        <span>País de origem</span>
        <input type="text" name="paisOrigem" value="<%= valores.paisOrigem || '' %>" placeholder="Ex: Argentina">
      </label>

      <label class="auth-field" id="campo-rg" hidden>
        <span>RG <span class="auth-opcional">(opcional)</span></span>
        <input type="text" name="rg" value="<%= valores.rg || '' %>" maxlength="20" placeholder="Número do RG">
      </label>

      <!-- Celular — opcional no cadastro, obrigatório ao completar -->
      <label class="auth-field">
        <span>Celular</span>
        <input type="text" name="celular" value="<%= valores.celular || '' %>" inputmode="numeric"
               placeholder="(21) 90000-0000" maxlength="15" data-mask="celular">
        <small>Com DDD.</small>
      </label>

      <!-- Escolaridade -->
      <label class="auth-field">
        <span>Escolaridade</span>
        <select name="escolaridade" required>
          <option value="" disabled <%= valores.escolaridade ? '' : 'selected' %>>Selecione...</option>
          <% escolaridades.forEach(function (e) { %>
            <option value="<%= e %>" <%= (valores.escolaridade === e) ? 'selected' : '' %>><%= e %></option>
          <% }) %>
        </select>
      </label>

      <label class="auth-field">
        <span>Situação</span>
        <select name="escolaridadeSituacao" required>
          <option value="" disabled <%= valores.escolaridadeSituacao ? '' : 'selected' %>>Cursando ou completo?</option>
          <% situacoes.forEach(function (s) { %>
            <option value="<%= s %>" <%= (valores.escolaridadeSituacao === s) ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </label>

      <!-- Senha -->

      <div class="auth-field full" style="background:#eef6ff;border:1px solid #b6d8ff;border-radius:8px;padding:12px 14px;">
        <p style="margin:0;font-size:.9rem;">
          <i class="fa-solid fa-circle-info"></i>
          Sua senha inicial será os <strong>4 últimos dígitos do seu CPF/CNPJ (ou passaporte)</strong>.
          No primeiro acesso, vamos pedir pra você trocá-la por uma senha só sua.
        </p>
      </div>
      <!-- <label class="auth-field">
        <span>Senha</span>
        <input type="password" name="senha" required minlength="10" autocomplete="new-password">
        <small>Mínimo de 10 caracteres.</small>
        <div class="senha-forca" id="senhaForca" hidden>
          <div class="senha-barra"><span></span></div>
          <small class="senha-label"></small>
        </div>
      </label>

      <label class="auth-field">
        <span>Confirmar senha</span>
        <input type="password" name="confirmarSenha" required autocomplete="new-password">
      </label> -->

      <!-- Consentimento -->
      <label class="auth-check full">
        <input type="checkbox" name="consentimento">
        <span>
          Li e aceito a
          <a href="/arquivo/privacidade.pdf" target="_blank">Política de Privacidade</a>
          e o tratamento dos meus dados conforme a LGPD.
        </span>
      </label>

      <button type="submit" class="auth-btn full">Criar conta</button>
    </form>

    <p class="auth-alt">Já tem conta? <a href="/login">Entrar</a></p>
  </div>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/zxcvbn/4.4.2/zxcvbn.js"></script>
<script src="/js/senha.js"></script>
<script src="/js/mascaras.js"></script>
<script src="/js/cadastro.js"></script>

<%- include('partials/foot') %>