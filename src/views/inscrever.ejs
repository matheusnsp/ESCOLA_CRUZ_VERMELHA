<%- include('partials/site-head', { titulo: 'Inscrição', cssExtra: '/inscrever.css' }) %>
<%- include('partials/site-header') %>

<%
// ═══════════════════════════════════════════════════════════════════════════
// INSCRIÇÃO — v3 (layout de aplicativo, pensado primeiro para o celular)
//
// A lógica é a mesma de sempre: mesmas etapas, rotas, names de campo e CSRF.
// O que mudou na v2:
//   • Topo fixo com o nome do curso e as marcas de passo.
//   • Contrato em sanfona: 5 grupos fechados no lugar da caixa rolável.
//   • Barra de ação fixa no rodapé, com o valor ao lado do botão.
//
// O que mudou na v3:
//   • O CARTÃO SAIU DAQUI. Assim como o PIX, o crédito agora tem tela própria
//     de retorno (/inscricao/cartao/:matriculaId), com timer, validação e a
//     mesma trilha de etapas. Esta tela só escolhe o plano e a forma.
//   • Sem campos de cartão, sem máscaras: os botões levam para a tela de
//     pagamento em vez de cobrar no clique — e os textos dizem isso.
//
// etapaAtual: 'escolha' | 'pagar-taxa' | 'pagar-curso'
//
// 💡 PLANO PRESENCIAL DESATIVADO: blocos preservados sob condição sempre
// falsa. Religar exige também reativar 'PRESENCIAL' no cursos.js.
// ═══════════════════════════════════════════════════════════════════════════

const _planoBody = typeof plano !== 'undefined' ? plano : '';

// Voltou com erro de validação → o aluno já tinha aceitado o contrato,
// então reabre direto no passo de pagamento.
const _abrirNoPagamento = !!erro;

// ── Passos ───────────────────────────────────────────────────────────────
// À vista / passaporte → contrato, pagamento                       = 2
// Parcelado            → contrato, plano, taxa, curso              = 4
const _totalPassos = etapaAtual === 'escolha' ? 2 : 4;
const _passoAtual  = etapaAtual === 'escolha' ? (_abrirNoPagamento ? 2 : 1)
                   : etapaAtual === 'pagar-taxa' ? 3 : 4;
const _trilha = _totalPassos === 2
  ? ['Contrato', 'Pagamento']
  : ['Contrato', 'Plano', 'Taxa de inscrição', 'Curso'];
%>

<main class="chk">
  <div class="chk-quadro">

    <!-- ════════════════════════════════════════════════════════════════════
         TOPO FIXO
         ════════════════════════════════════════════════════════════════════ -->
    <header class="chk-topo">
      <div class="chk-topo-linha">
        <% if (etapaAtual === 'escolha') { %>
        <a href="/cursos/<%= curso.id %>" class="chk-voltar" aria-label="Voltar ao curso">
          <i class="fa-solid fa-arrow-left"></i>
        </a>
        <% } else { %>
        <a href="/inscrever/<%= turma.id %>" class="chk-voltar" aria-label="Voltar">
          <i class="fa-solid fa-arrow-left"></i>
        </a>
        <% } %>
        <div class="chk-topo-txt">
          <strong><%= curso.nome %></strong>
          <span class="num">
            <% if (turma.aulas && turma.aulas.length) { %><%= turma.aulas[0].horario %> · <% } %>início
            <%= new Date(turma.inicioPrevisto).toLocaleDateString('pt-BR') %>
          </span>
        </div>
      </div>

      <div class="chk-passos" id="barraProgresso" aria-hidden="true">
        <% for (let i = 1; i <= _totalPassos; i++) { %>
        <div class="chk-passo <%= i < _passoAtual ? 'feito' : i === _passoAtual ? 'agora' : '' %>"><span></span></div>
        <% } %>
      </div>
      <p class="chk-rot" id="rotuloEtapa" aria-live="polite">
        <span id="rotuloTitulo"><%= _trilha[_passoAtual - 1] %></span>
        <i class="num" id="rotuloContagem"><%= _passoAtual %>/<%= _totalPassos %></i>
      </p>
    </header>

    <div class="chk-corpo">

      <% if (erro) { %>
      <div class="chk-erro anima" role="alert">
        <i class="fa-solid fa-circle-exclamation"></i>
        <div><strong>Não foi possível continuar</strong><%= erro %></div>
      </div>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════
           ETAPA 1 — contrato e escolha do plano na mesma tela
           ══════════════════════════════════════════════════════════════════ -->
      <% if (etapaAtual === 'escolha') { %>

      <!-- ───────────────── PASSO A: contrato ───────────────── -->
      <div id="passoContrato" <% if (_abrirNoPagamento) { %>hidden<% } %>>
        <div class="chk-cab anima" style="--d:0">
          <h2>Contrato de matrícula</h2>
          <p>Toque em cada item para ler. Depois de concordar, você escolhe como pagar.</p>
        </div>

        <div class="chk-sanfona anima" style="--d:1">
          <details class="chk-grupo">
            <summary>
              <span class="chk-grupo-n num">1</span>
              <span class="chk-grupo-t">O curso e a turma<em>Objeto, início e vigência</em></span>
              <i class="fa-solid fa-chevron-down chk-seta"></i>
            </summary>
            <div class="chk-corpo-grupo">
              <h4>Contratada</h4>
              <p>CRUZ VERMELHA BRASILEIRA — FILIAL DO ESTADO DO RIO DE JANEIRO, neste ato
              representada por seu Presidente, LUIZ CARLOS DOS SANTOS. Fundamento legal:
              Constituição Federal art. 209; Lei 9.394/96; Lei 8.078/90; Lei 13.709/18;
              arts. 421, 422 e 593 a 609 do Código Civil; legislação educacional aplicável.</p>

              <h4>Cláusula 1 — Objeto</h4>
              <p>A prestação de serviços educacionais relativos ao curso identificado neste
              instrumento, compreendendo aulas, atividades práticas, avaliações, material
              institucional quando previsto, certificação e demais atividades constantes do
              plano pedagógico.</p>

              <h4>Cláusula 2 — Início da turma</h4>
              <p>O curso somente terá início após a confirmação de, no mínimo, 15 (quinze)
              alunos regularmente matriculados. Caso o número mínimo não seja atingido, a
              CONTRATADA poderá remarcar a data de início ou cancelar a turma, assegurando a
              restituição integral dos valores pagos, observada a legislação consumerista.</p>

              <h4>Cláusula 3 — Vigência</h4>
              <p>O contrato vigorará da assinatura até a conclusão do curso ou sua rescisão.</p>
            </div>
          </details>

          <details class="chk-grupo">
            <summary>
              <span class="chk-grupo-n num">2</span>
              <span class="chk-grupo-t">Deveres das partes<em>Escola, aluno e matrícula</em></span>
              <i class="fa-solid fa-chevron-down chk-seta"></i>
            </summary>
            <div class="chk-corpo-grupo">
              <h4>Cláusula 4 — Obrigações da contratada</h4>
              <p>Executar o curso; disponibilizar docentes qualificados; infraestrutura
              adequada; calendário; avaliações; certificados; substituir docentes quando
              necessário; alterar cronograma por motivo pedagógico, força maior ou caso
              fortuito.</p>

              <h4>Cláusula 5 — Obrigações do contratante</h4>
              <p>Cumprir o regimento; manter frequência mínima; respeitar docentes e alunos;
              manter adimplência; apresentar documentação; utilizar corretamente instalações
              e materiais.</p>

              <h4>Cláusula 6 — Matrícula</h4>
              <p>A matrícula somente será efetivada após entrega dos documentos exigidos e
              pagamento previsto.</p>
            </div>
          </details>

          <details class="chk-grupo">
            <summary>
              <span class="chk-grupo-n num">3</span>
              <span class="chk-grupo-t">Valores e cancelamento<em>Pagamento, atraso e desistência</em></span>
              <i class="fa-solid fa-chevron-down chk-seta"></i>
            </summary>
            <div class="chk-corpo-grupo">
              <h4>Cláusula 7 — Preço e pagamento</h4>
              <p>Os valores constantes neste contrato poderão ser pagos conforme plano
              financeiro acima. Incidirão reajustes apenas na forma da legislação aplicável.</p>

              <h4>Cláusula 8 — Inadimplemento</h4>
              <p>Multa de 2%, juros de 1% ao mês e correção monetária, sem prejuízo da
              cobrança judicial ou extrajudicial.</p>

              <h4>Cláusula 9 — Cancelamento</h4>
              <p>O cancelamento deverá ser solicitado por escrito, observadas as regras do
              regimento escolar e do Código de Defesa do Consumidor.</p>
            </div>
          </details>

          <details class="chk-grupo">
            <summary>
              <span class="chk-grupo-n num">4</span>
              <span class="chk-grupo-t">Certificado<em>O que é exigido para receber</em></span>
              <i class="fa-solid fa-chevron-down chk-seta"></i>
            </summary>
            <div class="chk-corpo-grupo">
              <h4>Cláusula 10 — Certificação</h4>
              <p>A certificação dependerá da aprovação acadêmica, frequência mínima, estágio
              quando exigido e inexistência de pendências documentais.</p>
            </div>
          </details>

          <details class="chk-grupo">
            <summary>
              <span class="chk-grupo-n num">5</span>
              <span class="chk-grupo-t">Seus dados e disposições finais<em>LGPD, direitos autorais e foro</em></span>
              <i class="fa-solid fa-chevron-down chk-seta"></i>
            </summary>
            <div class="chk-corpo-grupo">
              <h4>Cláusula 11 — LGPD</h4>
              <p>A CONTRATADA atuará como Controladora dos dados pessoais coletados para
              execução deste contrato. Os dados serão tratados exclusivamente para matrícula,
              gestão acadêmica, emissão de certificados, obrigações legais e comunicações
              institucionais, observando a Lei nº 13.709/2018. O aluno poderá exercer os
              direitos previstos no art. 18 da LGPD. Os dados somente serão compartilhados
              quando exigido por lei, determinação judicial ou indispensáveis à execução
              deste contrato.</p>

              <h4>Cláusula 12 — Propriedade intelectual</h4>
              <p>Todo material didático permanece protegido pela legislação de direitos
              autorais, sendo vedada sua reprodução sem autorização.</p>

              <h4>Cláusula 13 — Anticorrupção e integridade</h4>
              <p>As partes comprometem-se a observar a Lei nº 12.846/2013 e princípios de
              integridade institucional.</p>

              <h4>Cláusula 14 — Assinatura eletrônica</h4>
              <p>As partes reconhecem a validade de assinatura eletrônica, conforme Lei nº
              14.063/2020.</p>

              <h4>Cláusula 15 — Disposições gerais</h4>
              <p>Aplicam-se subsidiariamente o Regimento Escolar e a legislação vigente.</p>

              <h4>Cláusula 16 — Foro</h4>
              <p>Fica eleito o foro da Comarca da Capital do Estado do Rio de Janeiro.</p>
            </div>
          </details>
        </div>

        <label class="chk-aceite anima" style="--d:2">
          <input type="checkbox" id="aceiteContrato" <% if (_abrirNoPagamento) { %>checked<% } %>>
          <span class="chk-chave" aria-hidden="true"></span>
          <span>Li e concordo com os termos do contrato de matrícula.</span>
        </label>

        <div class="chk-acao">
          <button id="btnIrPagamento" class="chk-btn" type="button" disabled>
            Continuar <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
        <p class="chk-nota-acao">Nada é cobrado neste passo.</p>
      </div><!-- /passoContrato -->

      <!-- ───────────────── PASSO B: pagamento ───────────────── -->
      <div id="passoPagamento" <% if (!_abrirNoPagamento) { %>hidden<% } %>>

        <button id="btnVoltarContrato" type="button" class="chk-link">
          <i class="fa-solid fa-arrow-left"></i> Rever o contrato
        </button>

        <div class="chk-aviso chk-aviso-ok">
          <i class="fa-solid fa-circle-check"></i>
          <span>Contrato aceito. O pagamento acontece <strong>na próxima tela deste site</strong>.</span>
        </div>

        <% if (ehPassaporte) { %>
        <!-- ── Passaporte: à vista, pago na secretaria ─────────────────── -->
        <form method="POST" action="/inscrever/<%= turma.id %>" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="plano" value="A_VISTA">

          <div class="chk-resumo">
            <div class="chk-linha">
              <span>Valor do curso</span><strong class="num"><%= formatBRL(aVista.valorCurso) %></strong>
            </div>
            <% if (Number(aVista.valorTaxaMatricula) > 0) { %>
            <div class="chk-linha">
              <span>Taxa de matrícula</span><strong class="num"><%= formatBRL(aVista.valorTaxaMatricula) %></strong>
            </div>
            <% } %>
            <div class="chk-linha chk-linha-total">
              <span>Total</span><strong class="num"><%= formatBRL(aVista.total) %></strong>
            </div>
            <p class="chk-nota">+ 1 kg de alimento não perecível, entregue na secretaria.</p>
          </div>

          <div class="chk-aviso">
            <i class="fa-solid fa-building-columns"></i>
            <span>A inscrição é registrada agora e o <strong>pagamento é feito na
            secretaria</strong>. Nenhuma cobrança é gerada online.</span>
          </div>

          <p class="chk-secao">Como você vai pagar na secretaria</p>
          <div class="chk-formas chk-formas-4">
            <label class="chk-forma">
              <input type="radio" name="forma" value="PIX" required>
              <i class="fa-solid fa-mobile-screen-button"></i>PIX
            </label>
            <label class="chk-forma">
              <input type="radio" name="forma" value="CREDITO">
              <i class="fa-solid fa-credit-card"></i>Crédito
            </label>
            <label class="chk-forma">
              <input type="radio" name="forma" value="DEBITO">
              <i class="fa-regular fa-credit-card"></i>Débito
            </label>
            <label class="chk-forma">
              <input type="radio" name="forma" value="DINHEIRO">
              <i class="fa-solid fa-money-bill-wave"></i>Dinheiro
            </label>
          </div>

          <div class="chk-acao">
            <div class="chk-acao-valor"><em>Total</em><strong class="num"><%= formatBRL(aVista.total) %></strong></div>
            <button id="btnConfirmar" class="chk-btn" type="submit" disabled>
              Confirmar inscrição <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>
        </form>

        <% } else { %>
        <!-- ── CPF/CNPJ: à vista online ou parcelado ───────────────────── -->

        <p class="chk-secao">Plano de pagamento</p>
        <div class="chk-planos">
          <label id="labelAVista" class="chk-plano ativo">
            <input type="radio" name="_planoUI" value="A_VISTA" checked>
            <span class="chk-plano-rot">À vista</span>
            <span class="chk-plano-v num"><%= formatBRL(aVista.total) %></span>
            <span class="chk-plano-o">um pagamento só</span>
          </label>

          <%
            // ══════════════════════════════════════════════════════════════
            // CARD "PRESENCIAL" — DESATIVADO. `if (false)` preserva o markup.
            // Religar: trocar por `if (true)` E reativar PRESENCIAL no
            // cursos.js (validação, POST /inscrever, guards das rotas).
            // ══════════════════════════════════════════════════════════════
          %>
          <% if (false) { %>
          <label id="labelPresencial" class="chk-plano">
            <input type="radio" name="_planoUI" value="PRESENCIAL">
            <span class="chk-plano-rot">Presencial</span>
            <span class="chk-plano-v num"><%= formatBRL(aVista.total) %></span>
            <span class="chk-plano-o">só a taxa online</span>
          </label>
          <% } %>

          <% if (parcelado && parceladoComJuros) { %>
          <label id="labelParcelado" class="chk-plano">
            <input type="radio" name="_planoUI" value="PARCELADO">
            <span class="chk-plano-rot">Parcelado</span>
            <span class="chk-plano-v num"><%= parceladoComJuros.numParcelas %>× <%= formatBRL(parceladoComJuros.valorParcela) %></span>
            <span class="chk-plano-o">total <%= formatBRL(parceladoComJuros.total) %></span>
          </label>
          <% } %>
        </div>

        <!-- ── À vista ──────────────────────────────────────────────────── -->
        <div id="blocoAVista">
          <form method="POST" action="/inscrever/<%= turma.id %>" novalidate id="formAVista">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="plano" value="A_VISTA">

            <div class="chk-resumo">
              <div class="chk-linha">
                <span>Valor do curso</span><strong class="num"><%= formatBRL(aVista.valorCurso) %></strong>
              </div>
              <% if (Number(aVista.valorTaxaMatricula) > 0) { %>
              <div class="chk-linha">
                <span>Taxa de matrícula</span><strong class="num"><%= formatBRL(aVista.valorTaxaMatricula) %></strong>
              </div>
              <% } %>
              <div class="chk-linha chk-linha-total">
                <span>Total</span><strong class="num"><%= formatBRL(aVista.total) %></strong>
              </div>
            </div>

            <p class="chk-secao">Forma de pagamento</p>
            <div class="chk-formas">
              <label id="formaAvistaPix" class="chk-forma">
                <input type="radio" name="forma" value="PIX">
                <i class="fa-solid fa-mobile-screen-button"></i>PIX
              </label>
              <label id="formaAvistaCredito" class="chk-forma">
                <input type="radio" name="forma" value="CREDITO">
                <i class="fa-solid fa-credit-card"></i>Crédito
              </label>
            </div>

            <div class="chk-aviso" id="avisoAVistaPix" hidden>
              <i class="fa-solid fa-qrcode"></i>
              <span>O <strong>QR Code aparece na próxima tela deste site</strong>. Pague pelo
              app do banco e volte: a página avança sozinha quando o banco confirmar.
              <strong>Não feche esta janela.</strong></span>
            </div>
            <div class="chk-aviso" id="avisoAVistaCredito" hidden>
              <i class="fa-solid fa-credit-card"></i>
              <span>Você preenche o cartão <strong>na próxima tela deste site</strong> e
              acompanha a autorização do banco por lá. O prazo para concluir é de
              <strong>5 minutos</strong>.</span>
            </div>

            <div class="chk-acao">
              <div class="chk-acao-valor"><em>Total</em><strong class="num"><%= formatBRL(aVista.total) %></strong></div>
              <button class="chk-btn" type="submit" id="btnAVista" disabled>
                <span id="txtBtnAVista">Escolha como pagar</span> <i class="fa-solid fa-arrow-right"></i>
              </button>
            </div>
          </form>
        </div>

        <!-- ── Parcelado ────────────────────────────────────────────────── -->
        <% if (parcelado && parceladoComJuros) { %>
        <div id="blocoParcelado" hidden>
          <form method="POST" action="/inscrever/<%= turma.id %>" novalidate id="formParcelado">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="plano" value="PARCELADO">

            <div class="chk-aviso">
              <i class="fa-solid fa-list-check"></i>
              <span>São <strong>dois pagamentos</strong>: a taxa de inscrição agora (PIX ou
              cartão) e, em seguida, o curso parcelado no cartão. Cada um tem a sua tela.</span>
            </div>

            <div class="chk-resumo">
              <div class="chk-linha">
                <span>Taxa de inscrição (agora)</span><strong class="num"><%= formatBRL(parcelado.valorTaxaMatricula) %></strong>
              </div>
              <div class="chk-linha">
                <span>Curso, <%= parcelado.numParcelas %>× no cartão</span><strong class="num"><%= formatBRL(parceladoComJuros.valorParcela) %>/mês</strong>
              </div>
              <div class="chk-linha chk-linha-total">
                <span>Total</span><strong class="num"><%= formatBRL(parceladoComJuros.total) %></strong>
              </div>
              <% if (parceladoComJuros.taxaJuros > 0) { %>
              <p class="chk-nota">Inclui <%= parceladoComJuros.taxaJuros %>% de juros.</p>
              <% } %>
            </div>

            <div class="chk-acao">
              <div class="chk-acao-valor"><em>Agora</em><strong class="num"><%= formatBRL(parcelado.valorTaxaMatricula) %></strong></div>
              <button class="chk-btn" type="submit">Continuar <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </form>
        </div>
        <% } %>

        <%
          // ══════════════════════════════════════════════════════════════
          // SUB-BLOCO "PRESENCIAL" — DESATIVADO (ver nota no card acima).
          // ══════════════════════════════════════════════════════════════
        %>
        <% if (false) { %>
        <div id="blocoPresencial" hidden>
          <form method="POST" action="/inscrever/<%= turma.id %>" novalidate id="formPresencial">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="plano" value="PRESENCIAL">

            <div class="chk-aviso">
              <i class="fa-solid fa-building-columns"></i>
              <span>Você paga apenas a <strong>taxa de inscrição</strong> agora. O curso é
              pago na secretaria.</span>
            </div>

            <div class="chk-resumo">
              <div class="chk-linha">
                <span>Taxa de inscrição</span><strong class="num"><%= formatBRL(aVista.valorTaxaMatricula) %></strong>
              </div>
              <div class="chk-linha">
                <span>Curso</span><strong class="num"><%= formatBRL(aVista.valorCurso) %></strong>
              </div>
              <div class="chk-linha chk-linha-total">
                <span>Total</span><strong class="num"><%= formatBRL(aVista.total) %></strong>
              </div>
            </div>

            <div class="chk-acao">
              <button class="chk-btn" type="submit">Pagar a taxa <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </form>
        </div>
        <% } %>

        <% } // fim else CPF/CNPJ %>
      </div><!-- /passoPagamento -->

      <!-- ══════════════════════════════════════════════════════════════════
           ETAPA 2 — Pagar taxa (PIX ou cartão)
           ══════════════════════════════════════════════════════════════════ -->
      <% } else if (etapaAtual === 'pagar-taxa') { %>

      <div class="chk-cab anima" style="--d:0">
        <h2>Taxa de inscrição</h2>
        <p>Pague a taxa para reservar sua vaga. O curso vem no passo seguinte.</p>
      </div>

      <div class="chk-resumo anima" style="--d:1">
        <div class="chk-linha chk-linha-total">
          <span>Taxa de inscrição</span><strong class="num"><%= formatBRL(valorTaxa) %></strong>
        </div>
      </div>

      <p class="chk-secao anima" style="--d:2">Forma de pagamento</p>
      <div class="chk-formas anima" style="--d:2">
        <label id="formaTaxaPix" class="chk-forma">
          <input type="radio" name="_formaTaxaUI" value="PIX">
          <i class="fa-solid fa-mobile-screen-button"></i>PIX
        </label>
        <label id="formaTaxaCredito" class="chk-forma">
          <input type="radio" name="_formaTaxaUI" value="CREDITO">
          <i class="fa-solid fa-credit-card"></i>Crédito
        </label>
      </div>

      <div id="blocoTaxaPix" hidden class="anima" style="--d:3">
        <form method="POST" action="/inscrever/<%= turma.id %>/pagar-taxa" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="forma" value="PIX">
          <div class="chk-aviso">
            <i class="fa-solid fa-qrcode"></i>
            <span>O QR Code aparece <strong>na próxima tela deste site</strong>. Pague pelo app
            do banco e volte: assim que o banco confirmar, você segue direto para o curso.</span>
          </div>
          <div class="chk-acao">
            <div class="chk-acao-valor"><em>Taxa</em><strong class="num"><%= formatBRL(valorTaxa) %></strong></div>
            <button class="chk-btn" type="submit">Gerar QR Code <i class="fa-solid fa-arrow-right"></i></button>
          </div>
        </form>
      </div>

      <div id="blocoTaxaCredito" hidden class="anima" style="--d:3">
        <form method="POST" action="/inscrever/<%= turma.id %>/pagar-taxa" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="forma" value="CREDITO">
          <div class="chk-aviso">
            <i class="fa-solid fa-credit-card"></i>
            <span>Você preenche o cartão <strong>na próxima tela</strong>, com prazo de
            5 minutos. Aprovada a taxa, você segue para o pagamento do curso.</span>
          </div>
          <div class="chk-acao">
            <div class="chk-acao-valor"><em>Taxa</em><strong class="num"><%= formatBRL(valorTaxa) %></strong></div>
            <button class="chk-btn" type="submit">Ir para o cartão <i class="fa-solid fa-arrow-right"></i></button>
          </div>
        </form>
      </div>

      <!-- ══════════════════════════════════════════════════════════════════
           ETAPA 3 — Pagar curso (parcelado no cartão)
           ══════════════════════════════════════════════════════════════════ -->
      <% } else if (etapaAtual === 'pagar-curso') { %>

      <%
        // ══════════════════════════════════════════════════════════════════
        // RAMO "PRESENCIAL" — DESATIVADO. O `false &&` curto-circuita sem
        // apagar o markup. Religar: remover o `false &&`.
        // ══════════════════════════════════════════════════════════════════
      %>
      <% if (false && plano === 'PRESENCIAL') { %>

      <div class="chk-aviso chk-aviso-ok anima">
        <i class="fa-solid fa-circle-check"></i>
        <span>Taxa de inscrição confirmada.</span>
      </div>

      <div class="chk-resumo anima" style="--d:1">
        <div class="chk-linha">
          <span>Valor do curso</span><strong class="num"><%= formatBRL(valorCurso) %></strong>
        </div>
        <div class="chk-linha chk-linha-total">
          <span>A pagar na secretaria</span><strong class="num"><%= formatBRL(valorCurso) %></strong>
        </div>
      </div>

      <div class="chk-aviso anima" style="--d:2">
        <i class="fa-solid fa-building-columns"></i>
        <span>O restante é pago presencialmente. A forma (PIX, crédito, débito ou dinheiro)
        você escolhe na hora.</span>
      </div>

      <form method="POST" action="/inscrever/<%= turma.id %>/pagar-curso" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="plano" value="PRESENCIAL">
        <div class="chk-acao">
          <button class="chk-btn" type="submit">Confirmar inscrição <i class="fa-solid fa-arrow-right"></i></button>
        </div>
      </form>

      <% } else { %>

      <div class="chk-aviso chk-aviso-ok anima">
        <i class="fa-solid fa-circle-check"></i>
        <span>Taxa confirmada. Falta só o pagamento do curso.</span>
      </div>

      <div class="chk-cab anima" style="--d:1">
        <h2>Pagamento do curso</h2>
        <p>Parcelado no cartão de crédito, em <%= numParcelas %> vezes.</p>
      </div>

      <div class="chk-resumo anima" style="--d:2">
        <div class="chk-linha">
          <span>Valor do curso</span><strong class="num"><%= formatBRL(valorCurso) %></strong>
        </div>
        <% if (parceladoComJuros) { %>
        <div class="chk-linha">
          <span><%= numParcelas %>× de</span><strong class="num"><%= formatBRL(parceladoComJuros.valorParcela) %></strong>
        </div>
        <div class="chk-linha chk-linha-total">
          <span>Total com juros</span><strong class="num"><%= formatBRL(parceladoComJuros.total) %></strong>
        </div>
        <% if (parceladoComJuros.taxaJuros > 0) { %>
        <p class="chk-nota">Juros de <%= parceladoComJuros.taxaJuros %>% incluídos.</p>
        <% } %>
        <% } else { %>
        <div class="chk-linha chk-linha-total">
          <span>Total</span><strong class="num"><%= formatBRL(valorCurso) %></strong>
        </div>
        <% } %>
      </div>

      <form method="POST" action="/inscrever/<%= turma.id %>/pagar-curso" novalidate class="anima" style="--d:3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="forma" value="CREDITO">
        <input type="hidden" name="parcelas" value="<%= numParcelas %>">
        <div class="chk-aviso">
          <i class="fa-solid fa-credit-card"></i>
          <span>Você preenche o cartão <strong>na próxima tela</strong>, com prazo de
          5 minutos para concluir. Não feche a janela durante a autorização.</span>
        </div>
        <div class="chk-acao">
          <div class="chk-acao-valor">
            <em><%= numParcelas %>× de</em>
            <strong class="num"><%= parceladoComJuros ? formatBRL(parceladoComJuros.valorParcela) : formatBRL(valorCurso) %></strong>
          </div>
          <button class="chk-btn" type="submit">Ir para o cartão <i class="fa-solid fa-arrow-right"></i></button>
        </div>
      </form>

      <% } %>

      <% } %>

    </div><!-- /chk-corpo -->
  </div><!-- /chk-quadro -->
</main>

<!-- ═══════════════════════════════════════════════════════════════════════
     Scripts — sempre ANTES do footer, que já fecha </body></html>
     Sem máscaras de cartão: elas moraram aqui até a v2 e agora vivem na tela
     /inscricao/cartao/:matriculaId, junto com os campos.
     ═══════════════════════════════════════════════════════════════════════ -->
<% if (etapaAtual === 'escolha') { %>
<script>
(function () {
  // Troca entre contrato e pagamento: só mostrar/esconder. Nada vai ao
  // servidor no meio, então voltar não descarta o que foi preenchido.
  var chk            = document.getElementById('aceiteContrato');
  var btnIrPagamento = document.getElementById('btnIrPagamento');
  var btnVoltar      = document.getElementById('btnVoltarContrato');
  var passoContrato  = document.getElementById('passoContrato');
  var passoPagamento = document.getElementById('passoPagamento');
  var barra          = document.getElementById('barraProgresso');
  var rotTitulo      = document.getElementById('rotuloTitulo');
  var rotContagem    = document.getElementById('rotuloContagem');

  // Quantos passos o fluxo tem depende do plano: parcelado passa por taxa e
  // curso (4); à vista e passaporte terminam no pagamento (2).
  var planoAtual = 'A_VISTA';
  var TITULOS = {
    A_VISTA:   ['Contrato', 'Pagamento'],
    PARCELADO: ['Contrato', 'Plano', 'Taxa de inscrição', 'Curso']
  };

  function atualizarProgresso(passo) {
    var lista = TITULOS[planoAtual] || TITULOS.A_VISTA;
    if (barra) {
      barra.innerHTML = '';
      for (var i = 1; i <= lista.length; i++) {
        var d = document.createElement('div');
        d.className = 'chk-passo' + (i < passo ? ' feito' : i === passo ? ' agora' : '');
        d.appendChild(document.createElement('span'));
        barra.appendChild(d);
      }
    }
    if (rotTitulo)   rotTitulo.textContent = lista[passo - 1];
    if (rotContagem) rotContagem.textContent = passo + '/' + lista.length;
  }

  if (btnIrPagamento && chk) btnIrPagamento.disabled = !chk.checked;
  if (chk) chk.addEventListener('change', function () {
    if (btnIrPagamento) btnIrPagamento.disabled = !this.checked;
  });

  if (btnIrPagamento) btnIrPagamento.addEventListener('click', function () {
    passoContrato.hidden = true;
    passoPagamento.hidden = false;
    atualizarProgresso(2);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  if (btnVoltar) btnVoltar.addEventListener('click', function () {
    passoPagamento.hidden = true;
    passoContrato.hidden = false;
    atualizarProgresso(1);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  <% if (ehPassaporte) { %>
  // Passaporte: confirmar só libera depois de escolher a forma.
  var btnConfirmar = document.getElementById('btnConfirmar');
  document.querySelectorAll('input[name="forma"]').forEach(function (r) {
    r.addEventListener('change', function () {
      if (btnConfirmar) btnConfirmar.disabled = false;
    });
  });

  <% } else { %>
  // ── Troca de plano ───────────────────────────────────────────────────
  // 💡 PRESENCIAL desativado: linhas comentadas. Os guards `if (...)` já
  // dariam conta (o markup não renderiza), mas assim fica explícito o que
  // precisa voltar.
  var labelAVista     = document.getElementById('labelAVista');
  var labelParcelado  = document.getElementById('labelParcelado');
  // var labelPresencial = document.getElementById('labelPresencial');

  var blocoAVista     = document.getElementById('blocoAVista');
  var blocoParcelado  = document.getElementById('blocoParcelado');
  // var blocoPresencial = document.getElementById('blocoPresencial');

  function selecionarPlano(p) {
    var avista    = p === 'A_VISTA';
    var parcelado = p === 'PARCELADO';
    // var presencial = p === 'PRESENCIAL';

    planoAtual = p;
    if (passoPagamento && !passoPagamento.hidden) atualizarProgresso(2);

    if (labelAVista)    labelAVista.classList.toggle('ativo', avista);
    if (labelParcelado) labelParcelado.classList.toggle('ativo', parcelado);
    // if (labelPresencial) labelPresencial.classList.toggle('ativo', presencial);

    if (labelAVista)    labelAVista.querySelector('input').checked = avista;
    if (labelParcelado) labelParcelado.querySelector('input').checked = parcelado;

    if (blocoAVista)    blocoAVista.hidden = !avista;
    if (blocoParcelado) blocoParcelado.hidden = !parcelado;
    // if (blocoPresencial) blocoPresencial.hidden = !presencial;
  }

  if (labelAVista)    labelAVista.addEventListener('click', function () { selecionarPlano('A_VISTA'); });
  if (labelParcelado) labelParcelado.addEventListener('click', function () { selecionarPlano('PARCELADO'); });
  // if (labelPresencial) labelPresencial.addEventListener('click', function () { selecionarPlano('PRESENCIAL'); });

  // ── Troca de forma à vista ───────────────────────────────────────────
  // O botão muda de nome junto: o clique leva para telas diferentes.
  var formaAvistaPix     = document.getElementById('formaAvistaPix');
  var formaAvistaCredito = document.getElementById('formaAvistaCredito');
  var avisoAVistaPix     = document.getElementById('avisoAVistaPix');
  var avisoAVistaCredito = document.getElementById('avisoAVistaCredito');
  var txtBtnAVista       = document.getElementById('txtBtnAVista');
  var btnAVista          = document.getElementById('btnAVista');

  // Nada vem pré-selecionado: os dois avisos nascem escondidos e o botão
  // nasce desabilitado. Só o aviso da forma escolhida aparece — mostrar os
  // dois de uma vez faria o aluno ler uma instrução que não vale pra ele.
  function selecionarFormaAVista(forma) {
    var eCredito = forma === 'CREDITO';
    if (formaAvistaPix)     formaAvistaPix.classList.toggle('ativa', !eCredito);
    if (formaAvistaCredito) formaAvistaCredito.classList.toggle('ativa', eCredito);
    if (avisoAVistaPix)     avisoAVistaPix.hidden     = eCredito;
    if (avisoAVistaCredito) avisoAVistaCredito.hidden = !eCredito;
    if (txtBtnAVista)       txtBtnAVista.textContent  = eCredito ? 'Ir para o cartão' : 'Gerar QR Code';
    if (btnAVista)          btnAVista.disabled = false;
    // Sincroniza o radio real para o form enviar o valor certo
    if (formaAvistaPix)     formaAvistaPix.querySelector('input').checked     = !eCredito;
    if (formaAvistaCredito) formaAvistaCredito.querySelector('input').checked = eCredito;
  }

  if (formaAvistaPix)     formaAvistaPix.addEventListener('click', function () { selecionarFormaAVista('PIX'); });
  if (formaAvistaCredito) formaAvistaCredito.addEventListener('click', function () { selecionarFormaAVista('CREDITO'); });
  <% } %>
})();
</script>
<% } %>

<% if (etapaAtual === 'pagar-taxa') { %>
<script>
(function () {
  // Os dois blocos nascem escondidos: o aviso e o botão só aparecem depois
  // que o aluno escolhe a forma.
  var pix     = document.getElementById('formaTaxaPix');
  var credito = document.getElementById('formaTaxaCredito');
  var bPix    = document.getElementById('blocoTaxaPix');
  var bCred   = document.getElementById('blocoTaxaCredito');

  function selecionar(forma) {
    var ePix = forma === 'PIX';
    pix.classList.toggle('ativa', ePix);
    credito.classList.toggle('ativa', !ePix);
    bPix.hidden  = !ePix;
    bCred.hidden = ePix;
    pix.querySelector('input').checked     = ePix;
    credito.querySelector('input').checked = !ePix;
  }

  pix.addEventListener('click', function () { selecionar('PIX'); });
  credito.addEventListener('click', function () { selecionar('CREDITO'); });
})();
</script>
<% } %>

<%- include('partials/site-footer') %>