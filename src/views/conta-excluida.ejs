<%- include('partials/head', { titulo: 'Conta excluída' }) %>

<main class="auth-wrap">
  <div class="auth-card auth-card-center">
    <div class="auth-icone-info"><i class="fa-regular fa-circle-check"></i></div>
    <h1>Conta excluída</h1>
    <% if (typeof anonimizada !== 'undefined' && anonimizada) { %>
      <p class="auth-sub">Apagamos o seu e-mail, telefone, endereço, senha e os outros dados da conta. Por obrigação legal, guardamos só o seu nome e documento junto dos registros de pagamento e do certificado. Sentiremos sua falta!</p>
    <% } else { %>
      <p class="auth-sub">Seus dados foram removidos. Sentiremos sua falta!</p>
    <% } %>
    <a href="/" class="auth-btn auth-btn-link">Voltar ao início</a>
  </div>
</main>

<%- include('partials/foot') %>
