<%- include('partials/site-head', {
  titulo: curso.nome,
  bodyClass: 'v-claro',
  preloadImg: curso.imagemUrl || undefined,
  imagemCompartilhar: curso.imagemUrl ? '/compartilhar/curso/' + curso.id + '.jpg' : undefined,
  // Resumo curto demais não serve sozinho de descrição no Google/WhatsApp. Se for um complemento do
  // nome (ex.: "(+Lei Lucas)"), fica junto do nome; se for uma frase (ex.: "Técnica de acesso venoso
  // periférico com segurança."), vem primeiro, com o resto depois do ponto.
  descricao: (function (d) {
    var lugar = 'na Escola de Educação e Saúde da Cruz Vermelha Brasileira, no Centro do Rio de Janeiro. Com certificado.';
    d = String(d || '').trim();
    if (d.length >= 60) return d;
    if (!d || d.charAt(0) === '(') return 'Curso presencial de ' + curso.nome + (d ? ' ' + d : '') + ' ' + lugar;
    return d.replace(/[.!…\s]+$/, '') + '. Curso presencial de ' + curso.nome + ' ' + lugar;
  })(curso.descricao)
}) %>
<%- include('partials/site-header', { menuAtivo: 'cursos' }) %>

<%
var agora = new Date();
var turmas = curso.turmas || [];
var prox = turmas.find(function (t) { return new Date(t.inicioPrevisto) > agora; });
var temTurma = turmas.length > 0;
var alvoCta = temTurma ? (turmas.length === 1 ? '/inscrever/' + turmas[0].id : '#turmas') : null;
var textoCta = turmas.length > 1 ? 'Escolher turma' : 'Inscrever-se';
var taxa = Number(taxaExibicao(curso, cfgMap));
var whats = 'https://wa.me/5521999922864?text=' + encodeURIComponent('Olá! Quero saber a próxima turma do curso ' + curso.nome + '.');
function dataLonga(d) {
  return new Date(d).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Sao_Paulo' });
}
%>

<main>

  <!-- ══ Topo com a foto do curso ══════════════════════════════════════ -->
  <section class="v-curso-topo">
    <% if (curso.imagemUrl) { %>
      <img class="v-curso-foto" src="<%= curso.imagemUrl %>" alt="">
    <% } %>
    <div class="v-wrap v-curso-topo-grid">
      <div class="v-curso-titulo">
        <a class="v-voltar" href="/cursos"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Todos os cursos</a>
        <p class="v-olho"><%= curso.categoria || 'Curso presencial' %></p>
        <h1><%= curso.nome %></h1>
        <% if (curso.descricao) { %><p class="v-curso-lead"><%= curso.descricao %></p><% } %>
        <div class="v-curso-chips">
          <span><i class="fa-regular fa-clock" aria-hidden="true"></i> <%= curso.cargaHoraria %> horas</span>
          <% if (curso.escolaridadeMinima) { %><span><i class="fa-solid fa-user-graduate" aria-hidden="true"></i> <%= curso.escolaridadeMinima %></span><% } %>
          <span><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Presencial no Centro do Rio</span>
          <span><i class="fa-solid fa-award" aria-hidden="true"></i> Certificado</span>
        </div>
      </div>

      <aside class="v-curso-card">
        <% if (prox) { var d = vitrine.dataTurma(prox.inicioPrevisto); %>
          <span class="v-rotulo">Próxima turma</span>
          <div class="v-curso-turma">
            <div class="v-data"><b><%= d.dia %></b><span><%= d.mes %></span></div>
            <div>
              <strong>Início em <%= dataLonga(prox.inicioPrevisto) %></strong>
              <% if (prox.aulas && prox.aulas.length) { %><em><i class="fa-regular fa-clock" aria-hidden="true"></i> <%= prox.aulas[0].horario %></em><% } %>
            </div>
          </div>
          <div class="curso-countdown v-contagem" data-inicio="<%= new Date(prox.inicioPrevisto).toISOString() %>">
            <span class="v-contagem-rot">Começa em</span>
            <div class="cd-nums v-contagem-nums">
              <span><b data-d>--</b><i>dias</i></span>
              <span><b data-h>--</b><i>horas</i></span>
              <span><b data-m>--</b><i>min</i></span>
              <span><b data-s>--</b><i>seg</i></span>
            </div>
          </div>
        <% } else { %>
          <span class="v-rotulo">Turmas em breve</span>
          <h3>Ainda não há turma aberta</h3>
          <p>A secretaria publica as datas aqui assim que abre as inscrições. Fale com a gente para saber a próxima turma.</p>
        <% } %>

        <div class="v-curso-preco">
          <div>
            <small>Matrícula à vista</small>
            <strong><%= vitrine.reais(curso.precoAvista) %></strong>
            <% if (taxa > 0) { %><em>+ <%= vitrine.reais(taxa) %> de taxa de inscrição</em><% } %>
          </div>
        </div>

        <% if (temTurma) { %>
          <a class="v-btn v-btn-red v-btn-grande v-btn-bloco" href="<%= alvoCta %>"><%= textoCta %> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          <p class="v-curso-obs">PIX ou cartão, à vista ou parcelado. As parcelas aparecem na hora da inscrição.</p>
        <% } else { %>
          <a class="v-btn v-btn-red v-btn-grande v-btn-bloco" href="<%= whats %>" target="_blank" rel="noopener">Saber a próxima turma</a>
          <a class="v-curso-link" href="/cursos">Ver outros cursos <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        <% } %>
      </aside>
    </div>
  </section>

  <!-- ══ Corpo ═════════════════════════════════════════════════════════ -->
  <section class="v-secao v-curso-corpo">
    <div class="v-wrap v-curso-grid">
      <div class="v-curso-principal">

        <% if (curso.descricaoLonga) { %>
          <div class="v-bloco">
            <p class="v-kicker">Sobre o curso</p>
            <h2>O que você vai aprender</h2>
            <div class="v-prosa">
              <% curso.descricaoLonga.split(/\n\s*\n/).forEach(function (par) { %>
                <% if (par.trim()) { %><p><%= par.trim() %></p><% } %>
              <% }) %>
            </div>
          </div>
        <% } %>

        <div class="v-bloco" id="turmas">
          <p class="v-kicker">Turmas abertas</p>
          <h2><%= temTurma ? (turmas.length === 1 ? 'Escolha sua turma' : 'Escolha a sua turma') : 'Sem turma aberta no momento' %></h2>
          <% if (!temTurma) { %>
            <div class="v-vazio v-vazio-esq">
              <i class="fa-regular fa-calendar-xmark" aria-hidden="true"></i>
              Nenhuma turma aberta agora. Volte em breve para conferir as próximas datas ou fale com a secretaria pelo WhatsApp.
              <div class="v-vazio-acoes">
                <a class="v-btn v-btn-red" href="<%= whats %>" target="_blank" rel="noopener">Falar com a secretaria</a>
                <a class="v-btn v-btn-contorno" href="/cursos">Ver outros cursos</a>
              </div>
            </div>
          <% } else { %>
            <div class="v-turmas">
              <% turmas.forEach(function (t) { var dt = vitrine.dataTurma(t.inicioPrevisto); %>
                <div class="v-turma">
                  <div class="v-data"><b><%= dt.dia %></b><span><%= dt.mes %></span></div>
                  <div class="v-turma-txt">
                    <strong>Início em <%= dataLonga(t.inicioPrevisto) %></strong>
                    <span><%= t.aulas && t.aulas.length ? t.aulas[0].horario + ' · ' : '' %>Praça da Cruz Vermelha, 10 · Centro</span>
                  </div>
                  <a class="v-btn v-btn-red" href="/inscrever/<%= t.id %>">Inscrever-se <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </div>
              <% }) %>
            </div>
            <p class="v-aviso">
              <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
              <span>A participação nas aulas é liberada só com a <strong>matrícula paga</strong>, além da taxa de inscrição. Quem pagou apenas a inscrição não tem a entrada liberada.</span>
            </p>
          <% } %>
        </div>
      </div>

      <aside class="v-curso-lado">
        <div class="v-invest">
          <p class="v-kicker">Investimento</p>
          <div class="v-invest-linha"><span>Valor da matrícula, à vista</span><b><%= formatBRL(curso.precoAvista) %></b></div>
          <div class="v-invest-linha"><span>Taxa de inscrição</span><b><%= formatBRL(total - curso.precoAvista) %></b></div>
          <div class="v-invest-linha v-invest-total"><span>Total à vista, com a inscrição</span><b><%= formatBRL(total) %></b></div>
          <p class="v-invest-obs">Valores para pagamento à vista. No parcelamento no cartão incide juros, então o total parcelado é maior; o valor exato de cada parcela aparece na hora da inscrição.</p>
          <% if (temTurma) { %>
            <a class="v-btn v-btn-red v-btn-grande v-btn-bloco" href="<%= alvoCta %>"><%= textoCta %> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          <% } %>
          <a class="v-invest-whats" href="<%= whats %>" target="_blank" rel="noopener">Dúvidas? Fale com a secretaria</a>
        </div>
      </aside>
    </div>
  </section>

  <% if (curso.faqs && curso.faqs.length) { %>
  <!-- ══ Dúvidas do curso ══════════════════════════════════════════════ -->
  <section class="v-secao v-curso-faq" id="duvidas-curso">
    <div class="v-wrap v-faq">
      <div>
        <p class="v-kicker">Dúvidas frequentes</p>
        <h2>Sobre este curso.</h2>
        <p class="v-faq-intro">Não encontrou o que procura? Fale com a secretaria pelo WhatsApp.</p>
      </div>
      <div class="v-faq-lista">
        <% curso.faqs.forEach(function (f, i) { %>
          <details<%= i === 0 ? ' open' : '' %>>
            <summary><%= f.pergunta %></summary>
            <p><%= f.resposta %></p>
          </details>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (outros && outros.length) { %>
  <!-- ══ Outros cursos ═════════════════════════════════════════════════ -->
  <section class="v-secao v-curso-outros">
    <div class="v-wrap">
      <div class="v-secao-head">
        <div>
          <p class="v-kicker">Veja também</p>
          <h2>Outros cursos da Escola.</h2>
        </div>
        <a class="v-btn v-btn-escuro v-btn-grande" href="/cursos">Ver todos os cursos <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
      <div class="v-grade">
        <% outros.forEach(function (o) { %>
          <%- include('partials/v-card', { curso: o, largura: 4, vitrine: vitrine, taxaExibicao: taxaExibicao, cfgMap: cfgMap }) %>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (temTurma) { %>
  <!-- Barra fixa no celular -->
  <div class="v-barra-cel">
    <div><small>Total à vista</small><b><%= vitrine.reais(total) %></b></div>
    <a class="v-btn v-btn-red" href="<%= alvoCta %>"><%= textoCta %> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
  </div>
  <% } %>

</main>

<script src="<%= asset('/js/countdown.js') %>"></script>
<%- include('partials/site-footer') %>
