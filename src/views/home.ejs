<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Escola de Educação e Saúde CVB-RJ | Cruz Vermelha</title>
    <link rel="icon" type="image/png" href="/img/logo-cvb-rj.webp">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/site-extra.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Manrope e Bricolage Grotesque: fontes do bloco .cx, usado da vitrine de cursos pra baixo. -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Manrope:wght@400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800;12..96,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Meta Pixel Code -->
    <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '2224500131617302');
    fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=2224500131617302&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
</head>
<body>

    <!-- HEADER / NAVBAR -->
    <%- include('partials/site-header') %>

    <% var agora = new Date(); %>

    <main>

        <!-- ══ HERO (desenho original) ═════════════════════════════════════ -->
        <section class="hero-section">
            <div class="hero-container">
                <div class="hero-text-content">
                    <h1>CAPACITAÇÃO QUE<br><span>SALVA VIDAS.</span></h1>
                    <p>Aprenda com quem mais entende de emergência.<br>Cursos oficiais da Cruz Vermelha Brasileira.</p>
                    <div class="hero-buttons">
                        <a href="/cursos" class="btn-hero-primary">VER CURSOS DISPONÍVEIS</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══ NOSSOS DIFERENCIAIS (cartão flutuante original) ═════════════ -->
        <section class="features-section">
            <div class="features-container">
                <h2>Por que escolher a Cruz Vermelha</h2>
                <div class="features-row">
                    <div class="feature-item">
                        <i class="fa-solid fa-shield-halved icon-red"></i>
                        <div class="feature-text">
                            <strong>Ambiente 100% Seguro &amp; LGPD</strong>
                            <span>Seus dados sempre protegidos</span>
                        </div>
                    </div>
                    <div class="feature-item">
                        <i class="fa-solid fa-award icon-red"></i>
                        <div class="feature-text">
                            <strong>Certificação Oficial Reconhecida</strong>
                            <span>Validade nacional e internacional</span>
                        </div>
                    </div>
                    <div class="feature-item">
                        <i class="fa-solid fa-bolt icon-red"></i>
                        <div class="feature-text">
                            <strong>Acesso Imediato Após Pagamento</strong>
                            <span>Sem espera, comece agora</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══ Daqui pra baixo, o padrão .cx (igual /cursos) ═══════════════ -->
        <div class="cx">

          <!-- ── Vitrine de cursos ──────────────────────────────────────── -->
          <section class="cxh-secao" id="cursos">
            <div class="cxh-cabeca">
              <p class="cxg-olho">Formação oficial</p>
              <h2 class="cxh-h2">Cursos disponíveis</h2>
              <p class="cxh-sub">
                Turmas abertas para inscrição. Clique no curso para ver as datas,
                a carga horária e os valores.
              </p>
            </div>

            <% if (!cursos.length) { %>

              <div class="cx-vazio">
                <i class="fa-regular fa-folder-open"></i>
                <p>Nenhum curso disponível no momento. Novas capacitações são
                publicadas com frequência — volte em breve para conferir.</p>
              </div>

            <% } else { %>

              <div class="cxh-carrossel">

                <button type="button" class="cxh-seta cxh-seta-antes" data-antes
                        aria-label="Curso anterior">
                  <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button type="button" class="cxh-seta cxh-seta-depois" data-depois
                        aria-label="Próximo curso">
                  <i class="fa-solid fa-chevron-right"></i>
                </button>

                <div class="cxh-trilha">
                <% cursos.forEach(function (curso) {
                     var total  = totalExibicao(curso, cfgMap);
                     var turmas = curso.turmas || [];
                     var prox   = turmas.find(function (t) { return new Date(t.inicioPrevisto) > agora; });
                     var turma  = prox || turmas[0];
                %>
                <article class="cxg-card">

                  <a class="card-link-overlay" href="/cursos/<%= curso.id %>"
                     aria-label="Ver <%= curso.nome %>"></a>

                  <div class="cxg-card-capa">
                    <% if (curso.imagemUrl) { %>
                      <img src="<%= curso.imagemUrl %>" alt="<%= curso.nome %>" loading="lazy">
                    <% } else { %>
                      <div class="cxg-card-semfoto"><i class="fa-solid fa-kit-medical"></i></div>
                    <% } %>

                    <span class="cxg-selo <%= prox ? 'cxg-selo-on' : 'cxg-selo-off' %>">
                      <i class="fa-solid <%= prox ? 'fa-circle-check' : 'fa-clock' %>"></i>
                      <%= prox ? 'Inscrições abertas' : 'Turmas em breve' %>
                    </span>

                    <% if (curso.escolaridadeMinima) { %>
                    <span class="cxg-tag">
                      <i class="fa-solid fa-user-graduate"></i> <%= curso.escolaridadeMinima %>
                    </span>
                    <% } %>
                  </div>

                  <div class="cxg-card-corpo">
                    <h3 class="cxg-card-titulo"><%= curso.nome %></h3>
                    <p class="cxg-card-desc">
                      <%= curso.descricao || 'Curso de capacitação da Cruz Vermelha.' %>
                    </p>

                    <ul class="cxg-card-infos">
                      <li>
                        <i class="fa-regular fa-clock"></i>
                        <span><%= curso.cargaHoraria %> horas</span>
                      </li>
                      <% if (turma) { %>
                      <li>
                        <i class="fa-solid fa-flag-checkered"></i>
                        <span class="num">
                          Início <%= new Date(turma.inicioPrevisto).toLocaleDateString('pt-BR') %>
                        </span>
                      </li>
                      <% } else { %>
                      <li>
                        <i class="fa-regular fa-calendar-xmark"></i>
                        <span>Data a definir</span>
                      </li>
                      <% } %>
                    </ul>

                    <div class="cxg-card-preco">
                      <em>A partir de (à vista)</em>
                      <strong class="num"><%= formatBRL(curso.precoAvista) %></strong>
                      <span>Total com matrícula: <b class="num"><%= formatBRL(total) %></b></span>
                    </div>

                    <a class="cxg-card-btn" href="/cursos/<%= curso.id %>">
                      Ver curso e turmas <i class="fa-solid fa-arrow-right"></i>
                    </a>
                  </div>

                </article>
                <% }) %>
                </div><!-- /cxh-trilha -->

                <div class="cxh-bolinhas"></div>
              </div><!-- /cxh-carrossel -->

              <% if (temMais) { %>
              <div class="cxh-mais">
                <a href="/cursos" class="cxh-btn-linha">
                  Ver todos os cursos <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
              <% } %>

            <% } %>
          </section>

          <!-- ── Dúvidas frequentes ─────────────────────────────────────── -->
          <section class="cxh-secao cxh-secao-borda">
            <div class="cxh-cabeca">
              <p class="cxg-olho">Tire suas dúvidas</p>
              <h2 class="cxh-h2">Perguntas frequentes</h2>
              <p class="cxh-sub">
                Não encontrou o que procura? Fale com a nossa equipe pelo WhatsApp.
              </p>
            </div>

            <div class="cxh-faq">
              <div class="cx-sanfona">
                <details class="cx-grupo">
                  <summary>
                    <span class="cx-grupo-t">Como faço minha matrícula?</span>
                    <i class="fa-solid fa-chevron-down cx-seta"></i>
                  </summary>
                  <div class="cx-grupo-corpo">
                    Escolha o curso, clique em "Inscrever-se" e siga o passo a passo.
                    Se preferir, fale com nossa equipe de atendimento — orientamos
                    sobre documentação, datas de início e formas de pagamento.
                  </div>
                </details>

                <details class="cx-grupo">
                  <summary>
                    <span class="cx-grupo-t">Os cursos possuem certificado?</span>
                    <i class="fa-solid fa-chevron-down cx-seta"></i>
                  </summary>
                  <div class="cx-grupo-corpo">
                    Sim. Todos os cursos oferecem certificado aos alunos que
                    concluírem os requisitos previstos.
                  </div>
                </details>

                <details class="cx-grupo">
                  <summary>
                    <span class="cx-grupo-t">A Cruz Vermelha tem tradição na formação de profissionais?</span>
                    <i class="fa-solid fa-chevron-down cx-seta"></i>
                  </summary>
                  <div class="cx-grupo-corpo">
                    Sim. A Cruz Vermelha Brasileira é reconhecida por sua atuação
                    humanitária e por oferecer capacitações voltadas para qualidade,
                    responsabilidade e excelência.
                  </div>
                </details>

                <details class="cx-grupo">
                  <summary>
                    <span class="cx-grupo-t">Posso parcelar o curso?</span>
                    <i class="fa-solid fa-chevron-down cx-seta"></i>
                  </summary>
                  <div class="cx-grupo-corpo">
                    Sim. As opções de pagamento (PIX ou cartão, à vista ou parcelado)
                    aparecem com o valor exato de cada parcela na hora da inscrição.
                    No parcelamento incide juros, então o total parcelado é maior
                    que o valor à vista.
                  </div>
                </details>

                <details class="cx-grupo">
                  <summary>
                    <span class="cx-grupo-t">Ainda estou em dúvida. Posso falar com um consultor?</span>
                    <i class="fa-solid fa-chevron-down cx-seta"></i>
                  </summary>
                  <div class="cx-grupo-corpo">
                    Claro. Nossa equipe está pronta para esclarecer suas dúvidas e
                    ajudar a escolher o curso ideal para seus objetivos.
                  </div>
                </details>
              </div>
            </div>
          </section>

        </div><!-- /.cx -->

    </main>

    <!-- RODAPÉ -->
    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="footer-logo">
            <img src="/img/logo-cvb-rj.webp" alt="Cruz Vermelha Brasileira — Rio de Janeiro" class="footer-logo-img">
          </div>
          <p style="font-size:13px;line-height:1.7;margin-top:14px;">Escola de Educação e Saúde CVB-RJ, capacitando pessoas para salvar vidas.</p>
        </div>
        <div class="footer-col">
          <h4>Sobre</h4>
          <p>Cruz Vermelha Brasileira<br>Filial Rio de Janeiro<br>Escola de Educação e Saúde CVB-RJ</p>
        </div>
        <div class="footer-col">
          <h4>Contato</h4>
          <p><i class="fa-solid fa-location-dot"></i> Praça Cruz Vermelha, 10</p>
          <p><i class="fa-solid fa-phone"></i> (21) 99992-2864</p>
          <p><i class="fa-regular fa-envelope"></i> contato@cruzvermelhariodejaneiro.org</p>
        </div>
        <div class="footer-col">
          <h4>Siga-nos</h4>
          <div class="footer-social">
            <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
            <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
            <a href="#" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="container footer-inner">
          <span>&copy; 2026 Desenvolvido por Matheus Neves</span>
          <span class="sep">|</span>
          <span> Cruz Vermelha Brasileira do Rio de Janeiro</span>
          <span class="sep">|</span>
          <span>Escola de Educação e Saúde CVB-RJ</span>
          <span class="sep">|</span>
          <a href="/arquivo/privacidade.pdf" target="_blank">Política de Privacidade</a>
        </div>
      </div>
    </footer>

    <!-- BOTÃO FLUTUANTE WHATSAPP -->
    <a class="wpp-float" href="https://wa.me/5521999922864?text=Ol%C3%A1!%20Tenho%20uma%20d%C3%BAvida%20sobre%20os%20cursos%20da%20Escola%20de%20Capacita%C3%A7%C3%A3o." target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
        <span class="wpp-float-text"><strong>Suporte rápido</strong><small>Dúvidas? Fale conosco</small></span>
        <i class="fa-brands fa-whatsapp"></i>
