    <!-- ══ Carrossel da vitrine de cursos ═════════════════════════════ -->
    <script>
    /* ============================================================
       carrossel.js — vitrine de cursos da home
       Rola automaticamente entre os cursos, com setas e bolinhas.
       ============================================================ */
    (function () {
      'use strict';

      var INTERVALO = 5000; // ms entre um curso e outro
      var semAnimacao = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      document.querySelectorAll('.cxh-carrossel').forEach(function (car) {
        var trilha = car.querySelector('.cxh-trilha');
        var bolinhas = car.querySelector('.cxh-bolinhas');
        var antes = car.querySelector('[data-antes]');
        var depois = car.querySelector('[data-depois]');
        if (!trilha) return;

        var cards = Array.prototype.filter.call(trilha.children, function (el) {
          return el.classList.contains('cxg-card');
        });
        if (cards.length < 2) {
          car.classList.add('cxh-carrossel-parado'); // some com setas/bolinhas
          return;
        }

        var atual = 0;
        var timer = null;

        /* Quantos cards cabem na largura visível. Muda com o breakpoint,
           então é recalculado sempre que precisamos — não dá pra fixar em 3. */
        function visiveis() {
          return Math.max(1, Math.round(trilha.clientWidth / cards[0].offsetWidth));
        }
        function ultimoIndice() {
          return Math.max(0, cards.length - visiveis());
        }

        function irPara(i, suave) {
          atual = Math.max(0, Math.min(i, ultimoIndice()));
          trilha.scrollTo({
            left: cards[atual].offsetLeft - trilha.offsetLeft,
            behavior: suave === false ? 'auto' : 'smooth'
          });
          pintarBolinhas();
        }

        function proximo() {
          irPara(atual >= ultimoIndice() ? 0 : atual + 1);
        }

        /* ── Bolinhas ─────────────────────────────────────────── */
        function montarBolinhas() {
          if (!bolinhas) return;
          bolinhas.innerHTML = '';
          for (var i = 0; i <= ultimoIndice(); i++) {
            (function (i) {
              var b = document.createElement('button');
              b.type = 'button';
              b.className = 'cxh-bolinha';
              b.setAttribute('aria-label', 'Ir para o curso ' + (i + 1));
              b.addEventListener('click', function () { irPara(i); reiniciar(); });
              bolinhas.appendChild(b);
            })(i);
          }
          pintarBolinhas();
        }

        function pintarBolinhas() {
          if (!bolinhas) return;
          Array.prototype.forEach.call(bolinhas.children, function (b, i) {
            b.classList.toggle('ativa', i === atual);
            b.setAttribute('aria-current', i === atual ? 'true' : 'false');
          });
        }

        /* ── Rotação automática ───────────────────────────────── */
        function comecar() {
          if (semAnimacao || timer) return;
          timer = setInterval(proximo, INTERVALO);
        }
        function parar() {
          clearInterval(timer);
          timer = null;
        }
        function reiniciar() { parar(); comecar(); }

        /* Pausa quando o usuário está interagindo — nada pior que o
           carrossel virar a página no meio de uma leitura ou de um clique. */
        car.addEventListener('mouseenter', parar);
        car.addEventListener('mouseleave', comecar);
        car.addEventListener('focusin', parar);
        car.addEventListener('focusout', comecar);
        trilha.addEventListener('touchstart', parar, { passive: true });
        document.addEventListener('visibilitychange', function () {
          document.hidden ? parar() : comecar();
        });

        /* Arrastar/rolar na mão também atualiza a bolinha ativa */
        var rolando;
        trilha.addEventListener('scroll', function () {
          clearTimeout(rolando);
          rolando = setTimeout(function () {
            var pos = trilha.scrollLeft + trilha.offsetLeft;
            var maisPerto = 0, menorDist = Infinity;
            cards.forEach(function (c, i) {
              var d = Math.abs(c.offsetLeft - pos);
              if (d < menorDist) { menorDist = d; maisPerto = i; }
            });
            atual = maisPerto;
            pintarBolinhas();
          }, 90);
        }, { passive: true });

        if (antes)  antes.addEventListener('click',  function () { irPara(atual - 1); reiniciar(); });
        if (depois) depois.addEventListener('click', function () { irPara(atual + 1); reiniciar(); });

        var redim;
        window.addEventListener('resize', function () {
          clearTimeout(redim);
          redim = setTimeout(function () { montarBolinhas(); irPara(atual, false); }, 150);
        });

        montarBolinhas();
        comecar();
      });
    })();
    </script>

</body>
</html>