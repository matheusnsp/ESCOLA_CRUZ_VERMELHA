<%- include('_topo', { titulo: modulo.titulo, voltarMenu: true }) %>
<section class="ea-heroi">
  <div class="ea-wrap ea-heroi-grid" style="min-height:0">
    <div>
      <a class="ea-pilula ea-pilula-escura ea-voltar" href="<%= base %>">← Todos os módulos</a>
      <p class="ea-kicker">Módulo <%= numero %> · <%= modulo.minutosEstimados %> min<%= modulo.final ? ' · cenários' : '' %></p>
      <h1><%= modulo.titulo %><span>.</span></h1>
    </div>
  </div>
</section>
<main class="ea-wrap ea-intro-grid">
  <article class="ea-prosa">
    <% if (modulo.fotoIntroUrl) { %><img src="<%= modulo.fotoIntroUrl %>" alt=""><% } %>
    <div>
      <p class="ea-kicker">Antes de começar</p>
      <% (modulo.introducao || '').split(/\n\s*\n/).filter(Boolean).forEach(function (p) { %><p><%= p %></p><% }) %>
    </div>
  </article>
  <aside class="ea-cartao">
    <% if (modulo.final) { %>
      <p class="ea-kicker">Cenários</p>
      <h2>Decida sob pressão<span style="color:var(--r)">.</span></h2>
      <ol class="ea-lista-top"><% modulo.cenarios.forEach(function (c) { %><li><%= c.titulo %></li><% }) %></ol>
      <p class="ea-obs">Os cenários com cronômetro e as decisões entram na próxima etapa da plataforma.</p>
      <a class="ea-pilula ea-pilula-clara" href="<%= base %>">Voltar ao menu</a>
    <% } else { %>
      <p class="ea-kicker">Neste módulo</p>
      <h2><%= modulo.topicos.length %> tópico<%= modulo.topicos.length === 1 ? '' : 's' %><span style="color:var(--r)">.</span></h2>
      <ol class="ea-lista-top"><% modulo.topicos.forEach(function (t) { %><li><span><%= t.titulo %> <small>· <%= t.telas.length %> tela<%= t.telas.length === 1 ? '' : 's' %></small></span></li><% }) %></ol>
      <% if (primeira) { %><a class="ea-pilula ea-pilula-red" href="<%= base %>/tela/<%= primeira.id %>">Começar o módulo →</a>
      <% } else if (proximo) { %><a class="ea-pilula ea-pilula-red" href="<%= base %>/modulo/<%= proximo.id %>">Próximo módulo →</a><% } %>
    <% } %>
  </aside>
</main>
<%- include('_fim') %>
