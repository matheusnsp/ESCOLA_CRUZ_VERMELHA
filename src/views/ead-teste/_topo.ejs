<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<% if (typeof indexavel === 'undefined' || !indexavel) { %><meta name="robots" content="noindex, nofollow"><% } %>
<meta name="referrer" content="strict-origin-when-cross-origin">
<title><%= titulo %> · Escola Digital CVB-RJ</title>
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<% if (typeof canonicalOnline !== 'undefined' && canonicalOnline) { %><link rel="canonical" href="<%= (typeof urlSite !== 'undefined' && urlSite ? urlSite.replace(/\/+$/, '') : '') + canonicalOnline %>"><% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="<%= asset('/ead.css') %>">
<%# Medição só no curso pago (etapa 8). No link de teste, nunca: Analytics/Pixel gravariam o endereço, que tem o código secreto. %>
<% if (typeof medir !== 'undefined' && medir) { %>
<%- include('../partials/rastreamento') %>
<% (typeof eventosMedicao !== 'undefined' ? eventosMedicao : []).forEach(function (ev) { %>
<script>gtag('event', <%- jsonSeguro(ev.ga[0]) %>, <%- jsonSeguro(ev.ga[1]) %>);fbq('track', <%- ev.meta.map(jsonSeguro).join(', ') %>);</script>
<% }) %>
<% } %>
<% if (typeof jsonLd !== 'undefined' && jsonLd) { %><script type="application/ld+json"><%- jsonSeguro(jsonLd) %></script><% } %>
</head>
<body class="ea-pagina">
<%_
  // Escola Digital (2026-11, vistoria H1): topo igual ao do site em função — caminho de volta, conta e "Sair".
  var _ed = typeof escolaDigital !== 'undefined' && escolaDigital;
  var _u = typeof usuario !== 'undefined' && usuario ? usuario : null;
  var _links = typeof contaLinks !== 'undefined' && contaLinks ? contaLinks : {};
  var _csrf = typeof csrfToken !== 'undefined' ? csrfToken : '';
_%>
<%# Faixa de cima e nome iguais aos do site (2026-11-09). %>
<div class="ea-topbar"><div class="ea-wrap"><a href="https://cruzvermelhariodejaneiro.org/" target="_blank" rel="noopener"><span class="ea-so-pc">Cruz Vermelha Brasileira · Filial do Estado do Rio de Janeiro</span><span class="ea-so-cel">Cruz Vermelha Brasileira · Rio de Janeiro</span> <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a><span class="ea-so-pc">Praça da Cruz Vermelha, 10 · Centro · Rio de Janeiro</span></div></div>
<%# Cabeçalho igual ao do site (partials/site-header.ejs), com classes ea- (as páginas do curso não carregam o
    CSS do site). O menu do celular é um <details> (sem JS: CSP). "Menu do curso" é a única coisa a mais. %>
<header class="ea-header<%= typeof voltarMenu !== 'undefined' && voltarMenu ? ' ea-header-curso' : '' %>">
  <div class="ea-wrap">
    <a class="ea-logo" href="/">
      <img src="/img/logo-cvb-rj.webp" alt="Cruz Vermelha Brasileira — Rio de Janeiro">
      <span><b>ESCOLA DE EDUCAÇÃO</b><small>E SAÚDE CVB-RJ</small></span>
    </a>
    <nav class="ea-menu" aria-label="Principal">
      <a href="/">Início</a>
      <% if (_ed) { %><a href="/escola-digital">Escola Digital</a><% } %>
      <a href="/#como">Como funciona</a>
      <a href="/#escola">Quem somos</a>
      <a href="/#duvidas">Dúvidas</a>
    </nav>
    <div class="ea-acoes">
      <% if (typeof voltarMenu !== 'undefined' && voltarMenu) { %><a class="ea-btn ea-btn-contorno ea-curso-pc" href="<%= base %>"><i class="fa-solid fa-list" aria-hidden="true"></i> Menu do curso</a><% } %>
      <% if (_u) { %>
        <details class="ea-user ea-acao-pc">
          <summary><i class="fa-solid fa-circle-user" aria-hidden="true"></i> Olá, <%= String(_u.nome || '').split(' ')[0] %> <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
          <div class="ea-user-drop">
            <a href="/minha-conta?sec=inscricoes"><i class="fa-solid fa-graduation-cap"></i> Minhas inscrições</a>
            <% if (_links.cursosOnline) { %><a href="/minha-conta?sec=online"><i class="fa-solid fa-laptop"></i> Cursos online</a><% } %>
            <% if (_links.ebooks) { %><a href="/minha-conta?sec=ebooks"><i class="fa-solid fa-book-open"></i> E-books</a><% } %>
            <% if (_links.gestor) { %><a href="/minha-escola"><i class="fa-solid fa-school"></i> Minha escola</a><% } %>
            <a href="/minha-conta?sec=dados"><i class="fa-solid fa-id-card"></i> Meus dados</a>
            <a href="/minha-conta?sec=excluir"><i class="fa-solid fa-trash"></i> Excluir conta</a>
            <form method="POST" action="/logout"><input type="hidden" name="_csrf" value="<%= _csrf %>"><button type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i> Sair</button></form>
          </div>
        </details>
      <% } else { %>
        <a class="ea-btn ea-btn-contorno ea-acao-pc" href="/login">Entrar</a>
      <% } %>
      <a class="ea-btn ea-btn-red ea-acao-pc" href="/cursos">Ver cursos</a>
      <details class="ea-gaveta">
        <summary class="ea-burger" aria-label="Abrir menu"><i class="fa-solid fa-bars" aria-hidden="true"></i></summary>
        <div class="ea-gaveta-in">
          <% if (typeof voltarMenu !== 'undefined' && voltarMenu) { %><a class="ea-btn ea-btn-red ea-gaveta-curso" href="<%= base %>"><i class="fa-solid fa-list" aria-hidden="true"></i> Menu do curso</a><% } %>
          <nav aria-label="Menu">
            <p class="ea-gaveta-rotulo" aria-hidden="true">Menu</p>
            <ul>
              <% [['/', 'Início'], ['/cursos', 'Cursos']].concat(_ed ? [['/escola-digital', 'Escola Digital']] : []).concat([['/#como', 'Como funciona'], ['/#escola', 'Quem somos'], ['/#duvidas', 'Dúvidas']]).forEach(function (it, n) { %>
                <li><a href="<%= it[0] %>"><span class="ea-gaveta-num" aria-hidden="true"><%= ('0' + (n + 1)).slice(-2) %></span> <%= it[1] %></a></li>
              <% }) %>
            </ul>
          </nav>
          <% if (_u) { %>
            <div class="ea-gaveta-conta">
              <p>Olá, <b><%= String(_u.nome || '').split(' ')[0] %></b></p>
              <a href="/minha-conta?sec=inscricoes"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> Minhas inscrições</a>
              <% if (_links.cursosOnline) { %><a href="/minha-conta?sec=online"><i class="fa-solid fa-laptop" aria-hidden="true"></i> Cursos online</a><% } %>
              <% if (_links.ebooks) { %><a href="/minha-conta?sec=ebooks"><i class="fa-solid fa-book-open" aria-hidden="true"></i> E-books</a><% } %>
              <% if (_links.gestor) { %><a href="/minha-escola"><i class="fa-solid fa-school" aria-hidden="true"></i> Minha escola</a><% } %>
              <a href="/minha-conta?sec=dados"><i class="fa-solid fa-id-card" aria-hidden="true"></i> Meus dados</a>
              <form method="POST" action="/logout"><input type="hidden" name="_csrf" value="<%= _csrf %>"><button type="submit"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Sair</button></form>
            </div>
          <% } else { %>
            <div class="ea-gaveta-acoes">
              <a class="ea-btn ea-btn-contorno" href="/login">Entrar</a>
              <a class="ea-btn ea-btn-red" href="/cadastro">Criar conta</a>
            </div>
          <% } %>
          <a class="ea-gaveta-wpp" href="https://wa.me/5521999922864" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Secretaria no WhatsApp · <b>(21) 99992-2864</b></a>
        </div>
      </details>
    </div>
  </div>
</header>
<% if (typeof eadModo === 'undefined' || eadModo !== 'pago') { %><div class="ea-teste">Versão de teste · só quem tem este link consegue abrir · não divulgue</div><% } %>
