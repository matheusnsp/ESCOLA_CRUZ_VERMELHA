<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof titulo !== 'undefined' ? titulo : 'Escola de Educação e Saúde CVB-RJ' %> | Cruz Vermelha</title>
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/img/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">

<link rel="stylesheet" href="<%= asset('/style.css') %>">
<link rel="stylesheet" href="<%= asset('/site-extra.css') %>">
<link rel="stylesheet" href="<%= asset('/inscrever.css') %>">

<%
// CSS específico da página. Precisa vir DEPOIS dos globais para poder
// sobrescrevê-los — e dentro do <head>, senão o navegador reposiciona a tag
// por conta própria e o estilo pode não ser aplicado.
// Uso: include('partials/site-head', { titulo: 'Inscrição', cssExtra: '/inscrever.css' })
%>
<% if (typeof cssExtra !== 'undefined') { %>
<link rel="stylesheet" href="<%= asset(cssExtra) %>">
<% } %>
<%# Visual novo: faixa vermelha, cabeçalho e rodapé de todas as páginas + home e catálogo. %>
<link rel="stylesheet" href="<%= asset('/vitrine.css') %>">
<% if (typeof preloadImg !== 'undefined') { %><link rel="preload" as="image" href="<%= preloadImg %>"><% } %>
<% if (typeof descricao !== 'undefined') { %><meta name="description" content="<%= descricao %>"><% } %>
<%
  // Prévia do link (WhatsApp, Facebook, LinkedIn) e endereço canônico. urlSite/urlPagina vêm de server.js
  // (o domínio por onde a pessoa entrou). Uso: include('partials/site-head', { ..., imagemCompartilhar: '/caminho.jpg' })
  var _site = typeof urlSite !== 'undefined' ? urlSite : '';
  var _img = typeof imagemCompartilhar !== 'undefined' && imagemCompartilhar ? imagemCompartilhar : '/img/compartilhar.jpg';
  if (_img.charAt(0) === '/') _img = _site + _img;
%>
<% if (typeof urlPagina !== 'undefined') { %><link rel="canonical" href="<%= urlPagina %>">
<meta property="og:url" content="<%= urlPagina %>"><% } %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Escola de Educação e Saúde CVB-RJ">
<meta property="og:locale" content="pt_BR">
<meta property="og:title" content="<%= typeof titulo !== 'undefined' ? titulo : 'Escola de Educação e Saúde CVB-RJ' %>">
<% if (typeof descricao !== 'undefined') { %><meta property="og:description" content="<%= descricao %>"><% } %>
<meta property="og:image" content="<%= _img %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= typeof titulo !== 'undefined' ? titulo : 'Escola de Educação e Saúde CVB-RJ' %>">
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800&family=Azeret+Mono:wght@400;500;700&family=Instrument+Sans:wght@400;500;600&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<%- include('rastreamento') %>
</head>
<body<%- typeof bodyClass !== 'undefined' ? ' class="' + bodyClass + '"' : '' %>>