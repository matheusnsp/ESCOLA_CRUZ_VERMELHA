<%
  // Cabeçalho do site do aluno: branco, com o logotipo oficial igual ao de sempre (classes
  // logo-area/logo-img/brand-* de style.css e site-extra.css). O resto em public/vitrine.css.
  // Uso: include('partials/site-header')                          → todas as páginas
  //      include('partials/site-header', { menuAtivo: 'inicio' }) → marca o item do menu (os cursos ficam no botão "Ver cursos")
  var _ativo = typeof menuAtivo !== 'undefined' ? menuAtivo : '';
  var _logado = typeof usuario !== 'undefined' && usuario;
%>
<% if (typeof cursoPendente !== 'undefined' && cursoPendente) { %>
  <%# Quem pagou só a taxa de inscrição (server.js): aviso em todas as páginas até pagar a matrícula. %>
  <div class="aviso-pagamento" role="alert">
    <div class="aviso-pagamento-in">
      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
      <p><b>Falta pagar a matrícula do curso <%= cursoPendente.curso %></b> (início em <%= cursoPendente.inicio %>).
        Sem o pagamento da matrícula confirmado, a entrada na aula não é liberada.</p>
      <a href="<%= cursoPendente.link %>" class="aviso-pagamento-btn">Pagar a matrícula agora <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </div>
<% } %>

<div class="v-topbar">
  <div class="v-wrap">
    <%# O nome da instituição leva ao site dela; o menu fica só com as seções desta página. %>
    <a class="v-topbar-inst" href="https://cruzvermelhariodejaneiro.org/" target="_blank" rel="noopener" title="Site da Cruz Vermelha Brasileira – RJ"><span class="v-topbar-longo">Cruz Vermelha Brasileira · Filial do Estado do Rio de Janeiro</span><span class="v-topbar-curto">Cruz Vermelha Brasileira · Rio de Janeiro</span> <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
    <span>Praça da Cruz Vermelha, 10 · Centro · Rio de Janeiro</span>
  </div>
</div>

<header class="v-header">
  <div class="v-wrap v-nav">
    <a href="/" class="logo-area" style="text-decoration:none;color:inherit;">
      <img src="/img/logo-cvb-rj.webp" alt="Cruz Vermelha Brasileira — Rio de Janeiro" class="logo-img">
      <div class="brand-text">
        <span class="brand-title">ESCOLA DE EDUCAÇÃO</span>
        <span class="brand-subtitle">E SAÚDE CVB-RJ</span>
      </div>
    </a>

    <nav class="v-menu" aria-label="Principal">
      <a href="/"<%- _ativo === 'inicio' ? ' aria-current="page"' : '' %>>Início</a>
      <a href="/#como">Como funciona</a>
      <a href="/#escola">Quem somos</a>
      <a href="/#duvidas">Dúvidas</a>
    </nav>

    <div class="v-acoes">
      <% if (_logado) { %>
        <details class="v-user">
          <summary><i class="fa-solid fa-circle-user" aria-hidden="true"></i> Olá, <%= usuario.nome.split(' ')[0] %> <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
          <div class="v-user-drop">
            <a href="/minha-conta?sec=inscricoes"><i class="fa-solid fa-graduation-cap"></i> Minhas inscrições</a>
            <a href="/minha-conta?sec=dados"><i class="fa-solid fa-id-card"></i> Meus dados</a>
            <a href="/minha-conta?sec=excluir"><i class="fa-solid fa-trash"></i> Excluir conta</a>
            <form method="POST" action="/logout">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i> Sair</button>
            </form>
          </div>
        </details>
      <% } else { %>
        <a class="v-btn v-btn-contorno v-so-pc" href="/login">Entrar</a>
      <% } %>
      <a class="v-btn v-btn-red v-so-pc" href="/cursos">Ver cursos</a>
      <button class="v-burger" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="vGaveta">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <%# Menu do celular em tela cheia (até 1060 px): ocupa tudo abaixo do cabeçalho; abre/fecha em main.js. %>
  <%
    var _itens = [
      { href: '/', nome: 'Início', ativo: _ativo === 'inicio' },
      { href: '/cursos', nome: 'Cursos', ativo: _ativo === 'cursos' },
      { href: '/#como', nome: 'Como funciona' },
      { href: '/#escola', nome: 'Quem somos' },
      { href: '/#duvidas', nome: 'Dúvidas' }
    ];
  %>
  <div class="v-gaveta" id="vGaveta" hidden>
    <div class="v-wrap v-gaveta-in">
      <nav class="v-gaveta-nav" aria-label="Menu">
        <p class="v-gaveta-rotulo" aria-hidden="true">Menu</p>
        <ul>
          <% _itens.forEach(function (it, n) { %>
            <li><a href="<%= it.href %>"<%- it.ativo ? ' aria-current="page"' : '' %>>
              <span class="v-gaveta-num" aria-hidden="true"><%= ('0' + (n + 1)).slice(-2) %></span>
              <span class="v-gaveta-nome"><%= it.nome %></span>
            </a></li>
          <% }) %>
        </ul>
      </nav>

      <div class="v-gaveta-pe">
        <% if (_logado) { %>
          <div class="v-gaveta-conta">
            <p class="v-gaveta-ola"><span class="v-gaveta-avatar" aria-hidden="true"><%= (usuario.nome || '?').trim().charAt(0).toUpperCase() %></span>
              <span>Olá, <b><%= (usuario.nome || '').split(' ')[0] %></b><small>Sua área do aluno</small></span></p>
            <a href="/minha-conta?sec=inscricoes"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> Minhas inscrições</a>
            <a href="/minha-conta?sec=dados"><i class="fa-solid fa-id-card" aria-hidden="true"></i> Meus dados</a>
            <form method="POST" action="/logout">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Sair</button>
            </form>
          </div>
        <% } else { %>
          <p class="v-gaveta-titulo">Área do aluno</p>
          <div class="v-gaveta-acoes">
            <a class="v-btn v-btn-contorno" href="/login">Entrar</a>
            <a class="v-btn v-btn-red" href="/cadastro">Criar conta</a>
          </div>
        <% } %>
        <a class="v-gaveta-wpp" href="https://wa.me/5521999922864" target="_blank" rel="noopener">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          <span><small>Secretaria no WhatsApp</small><b>(21) 99992-2864</b></span>
          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
        <p class="v-gaveta-end"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Praça da Cruz Vermelha, 10 · Centro</p>
      </div>
    </div>
  </div>
</header>
