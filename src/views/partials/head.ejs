<%_
  // Telas de conta (entrar, criar conta, senha, código, avisos), do site do aluno e do painel da
  // secretaria. As duas pontas ganham o layout com a foto ao lado (auth-layout.css), cada uma com
  // a sua foto e o seu texto.
  var _painel = typeof isAdmin !== 'undefined' && isAdmin;
_%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof titulo !== 'undefined' ? titulo : 'Escola de Educação e Saúde CVB-RJ' %> | Cruz Vermelha</title>
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/img/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="<%= asset('/auth.css') %>">
<link rel="stylesheet" href="<%= asset('/auth-layout.css') %>">

<%- include('rastreamento') %>
</head>
<body class="aa<%= _painel ? ' ap' : '' %>">
<% if (_painel) { %>
<aside class="aa-lado">
  <span class="aa-selo"><i class="fa-solid fa-lock" aria-hidden="true"></i> Acesso restrito · Equipe da Escola</span>
  <div>
    <p class="aa-olho">Escola de Educação e Saúde CVB-RJ</p>
    <p class="aa-titulo">Painel da <span>Secretaria.</span></p>
    <ul class="aa-lista">
      <li><i class="fa-solid fa-user-graduate" aria-hidden="true"></i> Alunos, matrículas e turmas</li>
      <li><i class="fa-solid fa-wallet" aria-hidden="true"></i> Financeiro e contas a pagar</li>
      <li><i class="fa-solid fa-award" aria-hidden="true"></i> Certificados e documentos</li>
    </ul>
  </div>
</aside>
<% } else { %>
<aside class="aa-lado">
  <a class="aa-voltar" href="/"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Voltar ao site</a>
  <div>
    <p class="aa-olho">Escola de Educação e Saúde CVB-RJ</p>
    <p class="aa-titulo">Capacitação que prepara para <span>agir.</span></p>
    <ul class="aa-lista">
      <li><i class="fa-solid fa-award" aria-hidden="true"></i> Certificado da Cruz Vermelha Brasileira</li>
      <li><i class="fa-solid fa-person-chalkboard" aria-hidden="true"></i> Aulas presenciais no Centro do Rio</li>
      <li><i class="fa-regular fa-credit-card" aria-hidden="true"></i> PIX ou cartão, à vista ou parcelado</li>
    </ul>
  </div>
</aside>
<% } %>
