<aside class="conta-sidebar">

  <nav>
    <%
      var cadastroIncompleto = usuario && (
        !usuario.cep ||
        !usuario.logradouro ||
        !usuario.numero ||
        !usuario.bairro ||
        !usuario.cidade ||
        !usuario.uf ||
        !usuario.celular
      );
    %>
    <% if (cadastroIncompleto) { %>
      <a href="/completar-dados" class="conta-sidebar-incompleto">
        <i class="fa-solid fa-triangle-exclamation"></i> Cadastro incompleto
      </a>
    <% } %>

    <a href="/minha-conta" class="<%= ativo === 'inscricoes' ? 'ativo' : '' %>">
      <i class="fa-solid fa-graduation-cap"></i> Minhas inscrições
    </a>

    <a href="/conta" class="<%= ativo === 'dados' ? 'ativo' : '' %>">
      <i class="fa-solid fa-id-card"></i> Meus dados
    </a>

    <a href="/conta#excluir" class="conta-sidebar-perigo">
      <i class="fa-solid fa-trash-can"></i> Excluir conta
    </a>
  </nav>

</aside>