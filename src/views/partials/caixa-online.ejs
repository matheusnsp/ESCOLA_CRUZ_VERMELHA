<%#
  Aviso da Escola Digital na página do curso presencial (2026-11). Espera: curso (com curso.online = { preco }
  quando o curso online está publicado e a Escola Digital está ligada; null/ausente = nada aparece) e vitrine.
%><% if (curso.online) { %>
<div class="v-online-caixa v-online-aviso">
  <p><i class="fa-solid fa-laptop" aria-hidden="true"></i> Este curso também existe 100% online, na Escola Digital.</p>
  <a class="v-online-link" href="<%= vitrine.urlOnline(curso) %>">Ver na Escola Digital <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
</div>
<% } %>
