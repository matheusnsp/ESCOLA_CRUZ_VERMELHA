<%
// Abre a página da Escola Digital: <head>, barra superior e <main>. Fecha com _rodape.ejs.
// Locals: titulo, descricao, rastrear (true nas páginas públicas: vitrine e curso; as de estudo não rastreiam),
// corpoClasse (classe extra no <body>, opcional).
var _titulo = typeof titulo !== 'undefined' && titulo ? titulo : NOME;
var _site = typeof urlSite !== 'undefined' ? urlSite : '';
var _caminho = typeof edCaminho !== 'undefined' ? edCaminho : '/digital';
var _primeiroNome = usuario && usuario.nome ? String(usuario.nome).trim().split(/\s+/)[0] : '';
%><!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= _titulo %></title>
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/img/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<% if (typeof descricao !== 'undefined' && descricao) { %><meta name="description" content="<%= descricao %>"><% } %>
<% if (typeof urlPagina !== 'undefined') { %><link rel="canonical" href="<%= urlPagina %>">
<meta property="og:url" content="<%= urlPagina %>"><% } %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= NOME %>">
<meta property="og:locale" content="pt_BR">
<meta property="og:title" content="<%= _titulo %>">
<% if (typeof descricao !== 'undefined' && descricao) { %><meta property="og:description" content="<%= descricao %>"><% } %>
<meta property="og:image" content="<%= _site %>/img/compartilhar.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#ffffff">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800;900&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%= asset('/escola-digital.css') %>">
<% if (typeof rastrear !== 'undefined' && rastrear) { %><%- include('../partials/rastreamento') %><% } %>
</head>
<body class="ed<%= typeof corpoClasse !== 'undefined' && corpoClasse ? ' ' + corpoClasse : '' %>">
<a class="ed-pular" href="#conteudo">Ir para o conteúdo</a>
<header class="ed-topo">
  <div class="ed-topo-in">
    <a class="ed-marca" href="/digital" aria-label="<%= NOME %>">
      <img class="ed-logo" src="/img/logo-cvb-rj.webp" alt="" width="58" height="26">
      <span class="ed-nome"><%= NOME_CURTO %><small>CVB-RJ</small></span>
    </a>
    <%# no computador o menu de abas some: os mesmos links ficam aqui no alto %>
    <% var _abaAtual = typeof aba !== 'undefined' ? aba : ''; %>
    <nav class="ed-topo-menu" aria-label="Seções">
      <a href="/digital"<%- _abaAtual === 'inicio' ? ' class="on" aria-current="page"' : '' %>>Início</a>
      <a href="/digital#cursos"<%- _abaAtual === 'cursos' ? ' class="on" aria-current="page"' : '' %>>Cursos</a>
      <a href="/minha-conta"<%- _abaAtual === 'certificados' ? ' class="on" aria-current="page"' : '' %>>Certificados</a>
    </nav>
    <nav class="ed-topo-nav" aria-label="Atalhos">
      <a class="ed-link-site" href="/">Site da escola</a>
      <% if (usuario) { %>
        <a class="ed-conta" href="/minha-conta"><span class="ed-av" aria-hidden="true"><%= (_primeiroNome || 'M').charAt(0).toUpperCase() %></span><span class="ed-conta-nome"><%= _primeiroNome || 'Minha conta' %></span></a>
      <% } else { %>
        <a class="ed-conta" href="/digital/entrar?voltar=<%= encodeURIComponent(_caminho) %>">Entrar</a>
      <% } %>
    </nav>
  </div>
</header>
<main id="conteudo" class="ed-main">
