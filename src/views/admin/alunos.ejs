<%- include('head', { titulo: 'Alunos' }) %>
<%- include('header', { ativo: 'alunos' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Alunos</h1>
  <span class="adm-mut">Total: <strong><%= total %></strong></span>
</div>

<% if (ok) { %>
  <div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= ok %></div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
<% } %>

<form method="GET" action="/alunos" class="adm-filtros">
  <label class="adm-campo cresce">
    <span>Buscar</span>
    <input type="text" name="q" value="<%= busca %>" placeholder="Nome, e-mail ou CPF">
  </label>

  <label class="adm-campo">
    <span>Matrícula</span>
    <select name="inscricao">
      <option value=""    <%= inscricao === ''    ? 'selected' : '' %>>Todos</option>
      <option value="com" <%= inscricao === 'com' ? 'selected' : '' %>>Com matrícula</option>
      <option value="sem" <%= inscricao === 'sem' ? 'selected' : '' %>>Sem matrícula</option>
    </select>
  </label>

  <label class="adm-campo cresce">
    <span>Turma</span>
    <select name="turma">
      <option value="">Todas as turmas</option>
      <% turmas.forEach(function (t) { %>
        <option value="<%= t.id %>" <%= turmaId === t.id ? 'selected' : '' %>>
          <%= t.curso.nome %> — <%= new Date(t.inicioPrevisto).toLocaleDateString('pt-BR') %>
        </option>
      <% }) %>
    </select>
  </label>

  <button type="submit" class="adm-btn-neutro">
    <i class="fa-solid fa-filter"></i> Filtrar
  </button>
</form>

<%
  // 💡 NOVO — Prospecção por WhatsApp.
  //
  // O botão só aparece em quem tem ZERO inscrições. Nesses casos a rota
  // /alunos já monta o link (m.linkProspeccao) com o texto pronto, citando
  // as turmas abertas de verdade.
  //
  // É um FORM, não um link: abordagem fria precisa de rastro. O POST grava
  // CONTATO_PROSPECCAO no LogAuditoria e só então redireciona pro wa.me.
  // target="_blank" faz o WhatsApp abrir em aba nova, mantendo a listagem.
  function dataHoraBR(d) {
    return d ? new Date(d).toLocaleDateString('pt-BR') : null;
  }
%>

<% if (turmaId && pagTurma) { %>
  <div class="adm-cards c3">
    <div class="adm-stat"><span><%= pagTurma.matricula %></span><small><i class="fa-solid fa-user-check"></i> Pagaram a matrícula</small></div>
    <div class="adm-stat ok"><span><%= pagTurma.tudo %></span><small><i class="fa-solid fa-circle-check"></i> Pagaram tudo</small></div>
    <div class="adm-stat <%= pagTurma.matricula - pagTurma.tudo ? 'warn' : '' %>"><span><%= pagTurma.matricula - pagTurma.tudo %></span><small><i class="fa-solid fa-hourglass-half"></i> Falta pagar o curso</small></div>
  </div>
<% } %>

<div class="adm-box">
  <% if (!alunos.length) { %>
    <div class="adm-vazio">
      <%= turmaId ? 'Nenhum aluno com a matrícula paga nesta turma.'
                  : (busca ? 'Nenhum aluno encontrado para essa busca.'
                           : 'Nenhum aluno cadastrado ainda.') %>
    </div>
  <% } else { %>
    <table class="adm-table adm-table-cards">
      <thead>
        <tr>
          <th>Aluno</th>
          <th>Documento</th>
          <th><%= turmaId ? 'Pagamento nesta turma' : 'Matrículas' %></th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% alunos.forEach(function (a) { %>
          <tr>
            <td>
              <strong><%= a.nome %></strong>
              <% if (a.bloqueioTotal) { %>
                <span class="badge canc">Banido</span>
              <% } %>
              <br><small class="adm-mut"><%= a.email %></small>
              <% if (a.celular) { const _d = String(a.celular).replace(/\D/g, ''); %><br><small class="adm-mut"><i class="fa-solid fa-phone"></i> <%= _d.length === 11 ? '(' + _d.slice(0,2) + ') ' + _d.slice(2,7) + '-' + _d.slice(7) : _d.length === 10 ? '(' + _d.slice(0,2) + ') ' + _d.slice(2,6) + '-' + _d.slice(6) : a.celular %></small><% } %>
            </td>
            <td><% const _doc = documentoAluno(a); %><% if (_doc) { %><small class="adm-mut"><%= _doc.tipo %></small><br><%= _doc.numero %><% } else { %><span class="adm-mut">—</span><% } %></td>
            <td>
              <% if (turmaId && a.matriculas && a.matriculas[0]) { const _tudo = a.matriculas[0].statusPagamento !== 'PENDENTE'; %>
                <span class="badge <%= _tudo ? 'ok' : 'pend' %>"><%= _tudo ? 'Tudo pago' : 'Só a matrícula' %></span>
              <% } else if (a._count.matriculas > 0) { %>
                <a href="/alunos/<%= a.id %>/matriculas" class="adm-link-aluno">
                  <%= a._count.matriculas %> matrícula<%= a._count.matriculas === 1 ? '' : 's' %>
                </a>
              <% } else { %>
                <span class="adm-mut">nenhuma</span>
                <% if (a.prospeccaoEm) { %>
                  <br><small class="adm-mut">
                    <i class="fa-brands fa-whatsapp"></i> contato em <%= dataHoraBR(a.prospeccaoEm) %>
                  </small>
                <% } %>
              <% } %>
            </td>
            <td class="adm-acoes">
              <div class="adm-pend-acoes">

                <%
                  // Só para quem nunca se inscreveu. Quem já é aluno não
                  // recebe convite pra se inscrever — seria estranho.
                %>
                <% if (a._count.matriculas === 0 && !a.bloqueioTotal && pode('aluno:gerenciar')) { %>
                  <% if (a.linkProspeccao) { %>
                    <form method="POST" action="/alunos/<%= a.id %>/prospeccao" target="_blank"
                          data-confirmar="Abrir o WhatsApp para convidar <%= a.nome.split(' ')[0] %>?<%= a.prospeccaoEm ? '\n\nAtenção: esta pessoa já foi contatada em ' + dataHoraBR(a.prospeccaoEm) + '.' : '' %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="adm-pend-btn whats" title="Convidar por WhatsApp">
                        <i class="fa-brands fa-whatsapp"></i> Convidar
                      </button>
                    </form>
                  <% } else { %>
                    <small class="adm-txt-alerta" title="Celular não cadastrado ou inválido">sem WhatsApp</small>
                  <% } %>
                <% } %>

                <a href="/alunos/<%= a.id %>/matriculas" class="adm-pend-btn"><i class="fa-solid fa-list-check"></i> Ver aluno</a>
                <% if (pode('aluno:gerenciar')) { %>
                  <a href="/alunos/<%= a.id %>/editar" class="adm-pend-btn"><i class="fa-solid fa-pen-to-square"></i> Editar</a>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<% if (alunos.length >= 200) { %>
  <p class="adm-info">
    <i class="fa-solid fa-circle-info"></i>
    Mostrando os primeiros 200 resultados. Refine a busca para ver outros.
  </p>
<% } %>

<%- include('foot') %>