<%- include('head', { titulo: 'Alunos' }) %>
<%- include('header', { ativo: 'alunos' }) %>
<div class="adm-h1-row"><h1 class="adm-h1">Alunos</h1></div>
<% if (ok) { %><div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= ok %></div><% } %>

<form method="GET" action="/alunos" class="adm-filtro" style="margin-bottom:18px;display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;">
<div style="flex:1;min-width:240px;display:flex;flex-direction:column;gap:6px;">
<label style="font-size:13px;font-weight:600;color:#555;">Buscar</label>
<input type="text" name="q" value="<%= busca %>" placeholder="Nome, e-mail ou CPF"
style="border:1px solid #e7ebf1;border-radius:10px;padding:11px 13px;font:inherit;font-size:14px;height:44px;box-sizing:border-box;">
</div>

<div style="display:flex;flex-direction:column;gap:6px;">
<label style="font-size:13px;font-weight:600;color:#555;">Inscrição</label>
<select name="inscricao"
style="border:1px solid #e7ebf1;border-radius:10px;padding:0 13px;font:inherit;font-size:14px;height:44px;box-sizing:border-box;min-width:140px;">
<option value="" <%= inscricao === '' ? 'selected' : '' %>>Todos</option>
<option value="com" <%= inscricao === 'com' ? 'selected' : '' %>>Com inscrição</option>
<option value="sem" <%= inscricao === 'sem' ? 'selected' : '' %>>Sem inscrição</option>
</select>
</div>

<div style="display:flex;flex-direction:column;gap:6px;">
<label style="font-size:13px;font-weight:600;color:#555;">Turma</label>
<select name="turma"
style="border:1px solid #e7ebf1;border-radius:10px;padding:0 13px;font:inherit;font-size:14px;height:44px;box-sizing:border-box;min-width:280px;">
<option value="">Todas as turmas</option>
<% turmas.forEach(function(t){ %>
<option value="<%= t.id %>" <%= turmaId===t.id ? 'selected' : '' %>><%= t.curso.nome %> — <%= new Date(t.inicioPrevisto).toLocaleDateString('pt-BR') %></option>
<% }) %>
</select>
</div>

<button type="submit"
style="height:44px;padding:0 22px;border:1px solid #e7ebf1;border-radius:10px;background:#fff;font:inherit;font-size:14px;font-weight:600;cursor:pointer;">
    Filtrar
</button>
</form>

<p class="adm-mut" style="margin:-4px 0 16px;font-size:13px;">
  Total de alunos: <strong><%= total %></strong>
</p>

<div class="adm-box">
<% if (!alunos.length) { %>
<div class="adm-vazio"><%= turmaId ? 'Nenhum aluno inscrito nesta turma.' : (busca ? 'Nenhum aluno encontrado para essa busca.' : 'Nenhum aluno cadastrado ainda.') %></div>
<% } else { %>
<table class="adm-table">
<thead><tr><th>Aluno</th><th>CPF/CNPJ</th><th>Escolaridade</th><th>Inscrições</th><th>Ações</th></tr></thead>
<tbody>
  <% alunos.forEach(function (a) { %>
  <tr>
    <td>
      <strong><%= a.nome %></strong>
      <% if (a.bloqueioTotal) { %>
        <span style="background:#fee2e2;color:#991b1b;padding:2px 7px;border-radius:6px;font-size:11px;font-weight:700;margin-left:6px;">BANIDO</span>
      <% } %>
      <br><small class="adm-mut"><%= a.email %></small>
    </td>
    <td><%= a.cpfCnpj ? a.cpfCnpj : a.passaporte ? a.passaporte : '—' %></td>
    <td><%= a.escolaridade ? (a.escolaridade + (a.escolaridadeSituacao ? ' (' + a.escolaridadeSituacao + ')' : '')) : '—' %></td>
    <td><%= a._count.matriculas %></td>
    <td class="adm-acoes">
      <a href="/alunos/<%= a.id %>/matriculas" class="adm-mini" title="Ver matrículas"><i class="fa-solid fa-list-check"></i></a>
      <% if (pode('aluno:gerenciar')) { %>
        <a href="/alunos/<%= a.id %>/editar" class="adm-mini" title="Editar dados"><i class="fa-solid fa-pen-to-square"></i></a>
      <% } %>
      <% if (admPapel === 'DEV') { %>
        <% if (!a.bloqueioTotal) { %>
          <button class="adm-mini" style="color:#dc2626;border:none;background:none;cursor:pointer;"
            title="Banir aluno"
            onclick="abrirModalBan('<%= a.id %>', '<%= a.nome.split(' ')[0] %>')">
            <i class="fa-solid fa-ban"></i>
          </button>
        <% } else { %>
          <form method="POST" action="/alunos/<%= a.id %>/desbanir" style="display:inline"
            onsubmit="return confirm('Desbanir <%= a.nome.split(' ')[0] %>?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="adm-mini" style="color:#16a34a;border:none;background:none;cursor:pointer;" title="Desbanir">
              <i class="fa-solid fa-lock-open"></i>
            </button>
          </form>
        <% } %>
      <% } %>
    </td>
  </tr>
  <% }) %>
  </tbody>
</table>
<% } %>
</div>
<% if (alunos.length >= 200) { %>
<p class="adm-mut" style="margin-top:12px;font-size:13px;">Mostrando os primeiros 200 resultados. Refine a busca para ver outros.</p>
<% } %>

<!-- Modal Ban -->
<div id="modalBan" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:999;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:14px;padding:28px;width:100%;max-width:420px;box-shadow:0 8px 32px rgba(0,0,0,.18);">
    <h3 style="margin:0 0 8px;font-size:16px;color:#991b1b;"><i class="fa-solid fa-ban"></i> Banir <span id="modalBanNome"></span></h3>
    <p style="font-size:13px;color:#6b7280;margin:0 0 16px;">As matrículas ativas serão canceladas e o aluno perderá acesso ao site.</p>
    <form method="POST" id="formBan">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <textarea name="motivo" required maxlength="300" placeholder="Motivo do banimento (obrigatório)"
        style="width:100%;padding:8px 12px;border:1px solid #fca5a5;border-radius:8px;font-size:13px;margin-bottom:12px;resize:vertical;min-height:80px;box-sizing:border-box;"></textarea>
      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <button type="button" onclick="fecharModalBan()"
          style="padding:8px 18px;border:1px solid #e5e7eb;border-radius:8px;background:#fff;font-size:13px;cursor:pointer;">
          Cancelar
        </button>
        <button type="submit"
          style="padding:8px 18px;border:none;border-radius:8px;background:#dc2626;color:#fff;font-size:13px;font-weight:600;cursor:pointer;">
          Confirmar ban
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function abrirModalBan(id, nome) {
    document.getElementById('modalBanNome').textContent = nome;
    document.getElementById('formBan').action = '/alunos/' + id + '/banir';
    document.getElementById('modalBan').style.display = 'flex';
  }
  function fecharModalBan() {
    document.getElementById('modalBan').style.display = 'none';
  }
  document.getElementById('modalBan').addEventListener('click', function(e) {
    if (e.target === this) fecharModalBan();
  });
</script>
<%- include('foot') %>