<%- include('head', { titulo: 'Alunos' }) %>
<%- include('header', { ativo: 'alunos' }) %>

<div class="adm-h1-row">
<h1 class="adm-h1">Alunos</h1>
<span class="adm-mut">Total: <strong><%= total %></strong></span>
</div>

<% if (ok) { %>
<div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= ok %></div>
<% } %>

<form method="GET" action="/alunos" class="adm-filtros">
<label class="adm-campo cresce">
<span>Buscar</span>
<input type="text" name="q" value="<%= busca %>" placeholder="Nome, e-mail ou CPF">
</label>

<label class="adm-campo">
<span>Inscrição</span>
<select name="inscricao">
<option value=""    <%= inscricao === ''    ? 'selected' : '' %>>Todos</option>
<option value="com" <%= inscricao === 'com' ? 'selected' : '' %>>Com inscrição</option>
<option value="sem" <%= inscricao === 'sem' ? 'selected' : '' %>>Sem inscrição</option>
</select>
</label>

<label class="adm-campo cresce">
<span>Turma</span>
<select name="turma">
<option value="">Todas as turmas</option>
<% turmas.forEach(function (t) { %>
<option value="<%= t.id %>" <%= turmaId === t.id ? 'selected' : '' %>>
<%= t.curso.nome %> — <%= new Date(t.inicioPrevisto).toLocaleDateString('pt-BR') %>
</option>
<% }) %>
</select>
</label>

<button type="submit" class="adm-btn-neutro">
<i class="fa-solid fa-filter"></i> Filtrar
</button>
</form>

<div class="adm-box">
<% if (!alunos.length) { %>
<div class="adm-vazio">
<%= turmaId ? 'Nenhum aluno inscrito nesta turma.'
                  : (busca ? 'Nenhum aluno encontrado para essa busca.'
                           : 'Nenhum aluno cadastrado ainda.') %>
</div>
<% } else { %>
<table class="adm-table">
<thead>
<tr>
<th>Aluno</th>
<th>CPF/CNPJ</th>
<th>Escolaridade</th>
<th>Inscrições</th>
<th>Ações</th>
</tr>
</thead>
<tbody>
<% alunos.forEach(function (a) { %>
<tr>
<td>
<strong><%= a.nome %></strong>
<% if (a.bloqueioTotal) { %>
<span class="badge canc">Banido</span>
<% } %>
<br><small class="adm-mut"><%= a.email %></small>
</td>
<td><%= a.cpfCnpj ? a.cpfCnpj : a.passaporte ? a.passaporte : '—' %></td>
<td>
<%= a.escolaridade
                ? (a.escolaridade + (a.escolaridadeSituacao ? ' (' + a.escolaridadeSituacao + ')' : ''))
                : '—' %>
</td>
<td>
<% if (a._count.matriculas > 0) { %>
<a href="/alunos/<%= a.id %>/matriculas" class="adm-link-aluno">
<%= a._count.matriculas %> inscri<%= a._count.matriculas === 1 ? 'ção' : 'ções' %>
</a>
<% } else { %>
<span class="adm-mut">0 inscrições</span>
<% } %>
</td>
<td class="adm-acoes">
<div class="adm-acoes-wrap">
<a href="/alunos/<%= a.id %>/matriculas" class="adm-mini" title="Ver matrículas">
<i class="fa-solid fa-list-check"></i>
</a>
<% if (pode('aluno:gerenciar')) { %>
<a href="/alunos/<%= a.id %>/editar" class="adm-mini" title="Editar dados">
<i class="fa-solid fa-pen-to-square"></i>
</a>
<% } %>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
<% } %>
</div>

<% if (alunos.length >= 200) { %>
<p class="adm-info">
<i class="fa-solid fa-circle-info"></i>
    Mostrando os primeiros 200 resultados. Refine a busca para ver outros.
</p>
<% } %>

<%- include('foot') %>