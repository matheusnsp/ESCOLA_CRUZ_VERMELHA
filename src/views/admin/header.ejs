<header class="adm-top">
  <% var secaoAtiva = (typeof ativo !== 'undefined') ? ativo : ''; %>

  <a href="/" class="adm-brand">
    <img src="/img/logo-cvb-rj.webp" alt="Cruz Vermelha Brasileira — RJ" class="adm-logo">
    <span class="adm-brand-txt">Secretaria <small>Escola de Educação e<br>Saúde CVB-RJ</small></span>
  </a>

  <nav class="adm-nav">
    <a href="/" class="<%= secaoAtiva === 'home' ? 'on' : '' %>"><i class="fa-solid fa-gauge"></i> Painel</a>
    <a href="/cursos" class="<%= secaoAtiva === 'cursos' ? 'on' : '' %>"><i class="fa-solid fa-book"></i> Cursos</a>
    <a href="/turmas" class="<%= secaoAtiva === 'turmas' ? 'on' : '' %>"><i class="fa-solid fa-calendar-days"></i> Turmas</a>
    <% if (pode('turmas:gerenciar') || pode('painel:leitura')) { %>
      <a href="/horarios" class="<%= secaoAtiva === 'horarios' ? 'on' : '' %>"><i class="fa-solid fa-clock"></i> Horários</a>
    <% } %>
    <% // Mesma permissão da rota /inscricoes: sem ela (ex.: Consulta) o link caía numa página de erro. %>
    <% if (pode('doacao:confirmar') || pode('financeiro:aprovar') || pode('financeiro:leitura')) { %>
      <a href="/inscricoes" class="<%= secaoAtiva === 'inscricoes' ? 'on' : '' %>"><i class="fa-solid fa-users"></i> Matrículas</a>
    <% } %>
    <%
      // 💡 Pagamentos pendentes. A condição espelha a permissão da rota
      // /pendentes: requirePermissao('pendentes:gerenciar').
      //
      // Antes dependia de financeiro:leitura, o que escondia a tela da
      // Secretaria — mas cobrar pagamento pendente é trabalho dela, não de
      // tesouraria. Por isso a permissão própria.
    %>
    <% if (pode('pendentes:gerenciar')) { %>
      <a href="/pendentes" class="<%= secaoAtiva === 'pendentes' ? 'on' : '' %>"><i class="fa-solid fa-hourglass-half"></i> Pendentes</a>
    <% } %>
    <a href="/alunos" class="<%= secaoAtiva === 'alunos' ? 'on' : '' %>"><i class="fa-solid fa-user-graduate"></i> Alunos</a>
    <% if (pode('financeiro:leitura')) { %>
      <a href="/financeiro" class="<%= secaoAtiva === 'financeiro' ? 'on' : '' %>"><i class="fa-solid fa-sack-dollar"></i> Financeiro</a>
    <% } %>
    <% if (admPapel === 'DEV') { %>
      <a href="/dev/usuarios" class="<%= secaoAtiva === 'dev-usuarios' ? 'on' : '' %>"><i class="fa-solid fa-user-shield"></i> Admin</a>
      <a href="/banimentos" class="<%= secaoAtiva === 'banimentos' ? 'on' : '' %>"><i class="fa-solid fa-ban"></i> Ban</a>
    <% } %>
  </nav>

  <!-- Rodapé da barra lateral (no celular, os itens voltam a ficar na linha do topo).
       O display:contents no style é de propósito: com um admin.css antigo ainda no cache do
       navegador, o topo continua igual ao de antes em vez de empilhar tema e Sair. -->
  <div class="adm-top-pe" style="display: contents">
  <!-- Fora do <form> de logout de propósito: dentro dele, qualquer
       clique no botão enviaria o formulário e deslogaria o usuário. -->

  <div class="adm-tema" id="admTema" role="radiogroup" aria-label="Tema da tela">
    <button type="button" role="radio" data-op="claro" title="Claro" aria-label="Tema claro"><i class="fa-solid fa-sun"></i></button>
    <button type="button" role="radio" data-op="auto" title="Automático (segue o sistema)" aria-label="Tema automático, segue o sistema"><i class="fa-solid fa-circle-half-stroke"></i></button>
    <button type="button" role="radio" data-op="escuro" title="Escuro" aria-label="Tema escuro"><i class="fa-solid fa-moon"></i></button>
  </div>

  <form method="POST" action="/logout" class="adm-sair">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <span><%= usuario?.nome?.trim().split(/\s+/)[0] || '' %></span>
    <button type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i> Sair</button>
  </form>
  </div>
</header>

<!-- Janela de confirmação das ações sem volta (estornar, cancelar, remover, excluir...).
     O formulário pede com atributos:
       data-confirmar="pergunta"          obrigatório
       data-motivo="Motivo do estorno"    mostra um campo de motivo obrigatório (vai em name="motivo")
       data-contabil                      mostra "Pago fora da Únicopag (só contábil)" (name="apenasContabil")
       data-botao="Estornar"              texto do botão de confirmar -->
<div class="adm-modal-overlay" id="admConfirma" aria-hidden="true">
  <div class="adm-modal adm-confirma" role="dialog" aria-modal="true" aria-labelledby="admConfirmaTit">
    <div class="adm-confirma-corpo">
      <h2 id="admConfirmaTit">Confirmar</h2>
      <p id="admConfirmaTxt"></p>
      <label class="adm-confirma-campo" id="admConfirmaMotivoRot" hidden>
        <span id="admConfirmaMotivoTit">Motivo</span>
        <textarea id="admConfirmaMotivo" rows="3" maxlength="200" placeholder="Escreva o motivo"></textarea>
        <small class="adm-confirma-erro" id="admConfirmaErro" hidden>Escreva o motivo para continuar.</small>
      </label>
      <label class="adm-confirma-check" id="admConfirmaContabilRot" hidden>
        <input type="checkbox" id="admConfirmaContabil">
        <span>Pago fora da Únicopag (dinheiro ou presencial): registrar só no sistema, sem chamar o gateway</span>
      </label>
    </div>
    <div class="adm-confirma-botoes">
      <button type="button" class="adm-btn-sec" id="admConfirmaNao">Voltar</button>
      <button type="button" class="adm-btn adm-btn-perigo" id="admConfirmaSim">Confirmar</button>
    </div>
  </div>
</div>

<script>
  // Não dá para usar onsubmit="return confirm(...)" no HTML: a CSP do helmet (script-src-attr 'none')
  // bloqueia esse tipo de script, e o formulário era enviado direto, sem a pergunta.
  (function () {
    var caixa = document.getElementById('admConfirma');
    var txt = document.getElementById('admConfirmaTxt');
    var motivoRot = document.getElementById('admConfirmaMotivoRot');
    var motivoTit = document.getElementById('admConfirmaMotivoTit');
    var motivo = document.getElementById('admConfirmaMotivo');
    var erro = document.getElementById('admConfirmaErro');
    var contabilRot = document.getElementById('admConfirmaContabilRot');
    var contabil = document.getElementById('admConfirmaContabil');
    var sim = document.getElementById('admConfirmaSim');
    var nao = document.getElementById('admConfirmaNao');
    var atual = null;

    function campo(f, nome) {
      var el = f.querySelector('[name="' + nome + '"]');
      if (!el) { el = document.createElement('input'); el.type = 'hidden'; el.name = nome; f.appendChild(el); }
      return el;
    }
    function fechar() { caixa.classList.remove('aberto'); caixa.setAttribute('aria-hidden', 'true'); atual = null; }
    function abrir(f) {
      atual = f;
      txt.textContent = f.dataset.confirmar;
      var pedeMotivo = 'motivo' in f.dataset;
      motivoRot.hidden = !pedeMotivo; erro.hidden = true; motivo.value = '';
      motivoTit.textContent = f.dataset.motivo || 'Motivo';
      contabilRot.hidden = !('contabil' in f.dataset); contabil.checked = false;
      sim.textContent = f.dataset.botao || 'Confirmar';
      caixa.classList.add('aberto'); caixa.setAttribute('aria-hidden', 'false');
      (pedeMotivo ? motivo : sim).focus();
    }

    document.addEventListener('submit', function (e) {
      var f = e.target;
      if (!f || !f.dataset || !f.dataset.confirmar) return;
      e.preventDefault();
      abrir(f);
    }, true);

    sim.addEventListener('click', function () {
      var f = atual;
      if (!f) return;
      if ('motivo' in f.dataset) {
        var v = motivo.value.trim();
        if (!v) { erro.hidden = false; motivo.focus(); return; }
        campo(f, 'motivo').value = v;
      }
      if ('contabil' in f.dataset) {
        var c = campo(f, 'apenasContabil');
        if (contabil.checked) c.value = 'on'; else c.parentNode.removeChild(c);
      }
      fechar();
      f.submit(); // submit() não dispara o evento de novo
    });
    nao.addEventListener('click', fechar);
    caixa.addEventListener('click', function (e) { if (e.target === caixa) fechar(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && atual) fechar(); });
  })();

  // No celular, as tabelas .adm-table-cards viram cartões; cada célula mostra o nome da coluna
  // (data-label), copiado do cabeçalho para não repetir em cada view.
  // (Roda depois de a página montar: este script fica no topo, antes das tabelas.)
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('table.adm-table-cards').forEach(function (t) {
      var nomes = Array.prototype.map.call(t.querySelectorAll('thead th'), function (th) { return th.textContent.trim(); });
      t.querySelectorAll('tbody tr').forEach(function (tr) {
        Array.prototype.forEach.call(tr.children, function (td, i) { if (nomes[i]) td.setAttribute('data-label', nomes[i]); });
      });
    });
  });

  (function () {
    var grupo = document.getElementById('admTema');
    var botoes = grupo.querySelectorAll('button');
    function marcar() {
      var pref = document.documentElement.dataset.temaPref || 'auto';
      botoes.forEach(function (b) { b.setAttribute('aria-checked', b.dataset.op === pref ? 'true' : 'false'); });
    }
    botoes.forEach(function (b) {
      b.addEventListener('click', function () { window.admTema(b.dataset.op); marcar(); });
    });
    marcar();
  })();
</script>

<main class="adm-wrap">