<header class="adm-top">
  <% var secaoAtiva = (typeof ativo !== 'undefined') ? ativo : ''; %>

  <a href="/" class="adm-brand">
    <img src="/img/logo-cvb-rj.webp" alt="Cruz Vermelha Brasileira — RJ" class="adm-logo">
    <span class="adm-brand-txt">Secretaria <small>Escola de Educação e<br>Saúde CVB-RJ</small></span>
  </a>

  <nav class="adm-nav">
    <a href="/" class="<%= secaoAtiva === 'home' ? 'on' : '' %>"><i class="fa-solid fa-gauge"></i> Painel</a>
    <a href="/cursos" class="<%= secaoAtiva === 'cursos' ? 'on' : '' %>"><i class="fa-solid fa-book"></i> Cursos</a>
    <a href="/turmas" class="<%= secaoAtiva === 'turmas' ? 'on' : '' %>"><i class="fa-solid fa-calendar-days"></i> Turmas</a>
    <% if (pode('turmas:gerenciar') || pode('painel:leitura')) { %>
      <a href="/horarios" class="<%= secaoAtiva === 'horarios' ? 'on' : '' %>"><i class="fa-solid fa-clock"></i> Horários</a>
    <% } %>
    <a href="/inscricoes" class="<%= secaoAtiva === 'inscricoes' ? 'on' : '' %>"><i class="fa-solid fa-users"></i> Matriculas</a>
    <%
      // 💡 Pagamentos pendentes. A condição espelha a permissão da rota
      // /pendentes: requirePermissao('pendentes:gerenciar').
      //
      // Antes dependia de financeiro:leitura, o que escondia a tela da
      // Secretaria — mas cobrar pagamento pendente é trabalho dela, não de
      // tesouraria. Por isso a permissão própria.
    %>
    <% if (pode('pendentes:gerenciar')) { %>
      <a href="/pendentes" class="<%= secaoAtiva === 'pendentes' ? 'on' : '' %>"><i class="fa-solid fa-hourglass-half"></i> Pendentes</a>
    <% } %>
    <a href="/alunos" class="<%= secaoAtiva === 'alunos' ? 'on' : '' %>"><i class="fa-solid fa-user-graduate"></i> Alunos</a>
    <% if (pode('financeiro:leitura')) { %>
      <a href="/financeiro" class="<%= secaoAtiva === 'financeiro' ? 'on' : '' %>"><i class="fa-solid fa-sack-dollar"></i> Financeiro</a>
    <% } %>
    <% if (admPapel === 'DEV') { %>
      <a href="/dev/usuarios" class="<%= secaoAtiva === 'dev-usuarios' ? 'on' : '' %>"><i class="fa-solid fa-user-shield"></i> Admin</a>
      <a href="/banimentos" class="<%= secaoAtiva === 'banimentos' ? 'on' : '' %>"><i class="fa-solid fa-ban"></i> Ban</a>
    <% } %>
  </nav>

  <!-- Rodapé da barra lateral (no celular, os itens voltam a ficar na linha do topo).
       O display:contents no style é de propósito: com um admin.css antigo ainda no cache do
       navegador, o topo continua igual ao de antes em vez de empilhar tema e Sair. -->
  <div class="adm-top-pe" style="display: contents">
  <!-- Fora do <form> de logout de propósito: dentro dele, qualquer
       clique no botão enviaria o formulário e deslogaria o usuário. -->

  <div class="adm-tema" id="admTema" role="radiogroup" aria-label="Tema da tela">
    <button type="button" role="radio" data-op="claro" title="Claro" aria-label="Tema claro"><i class="fa-solid fa-sun"></i></button>
    <button type="button" role="radio" data-op="auto" title="Automático (segue o sistema)" aria-label="Tema automático, segue o sistema"><i class="fa-solid fa-circle-half-stroke"></i></button>
    <button type="button" role="radio" data-op="escuro" title="Escuro" aria-label="Tema escuro"><i class="fa-solid fa-moon"></i></button>
  </div>

  <form method="POST" action="/logout" class="adm-sair">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <span><%= usuario?.nome?.trim().split(/\s+/)[0] || '' %></span>
    <button type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i> Sair</button>
  </form>
  </div>
</header>

<script>
  // Pergunta antes das ações sem volta (estornar, remover, excluir...): <form data-confirmar="...">.
  // Não dá para usar onsubmit="return confirm(...)" no HTML: a CSP do helmet (script-src-attr 'none')
  // bloqueia esse tipo de script, e o formulário era enviado direto, sem a pergunta.
  document.addEventListener('submit', function (e) {
    var f = e.target;
    if (f && f.dataset && f.dataset.confirmar && !window.confirm(f.dataset.confirmar)) e.preventDefault();
  }, true);

  (function () {
    var grupo = document.getElementById('admTema');
    var botoes = grupo.querySelectorAll('button');
    function marcar() {
      var pref = document.documentElement.dataset.temaPref || 'auto';
      botoes.forEach(function (b) { b.setAttribute('aria-checked', b.dataset.op === pref ? 'true' : 'false'); });
    }
    botoes.forEach(function (b) {
      b.addEventListener('click', function () { window.admTema(b.dataset.op); marcar(); });
    });
    marcar();
  })();
</script>

<main class="adm-wrap">