<%- include('head', { titulo: 'Curso' }) %>
<%- include('header', { ativo: 'cursos' }) %>

<% var c = curso || {}; var novo = !c.id; %>

<div class="adm-h1-row">
  <h1 class="adm-h1"><%= novo ? 'Novo curso' : 'Editar curso' %></h1>
  <a href="/cursos" class="adm-link">← Voltar</a>
</div>

<% if (erro) { %>
  <div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
<% } %>

<form method="POST" action="<%= (novo ? '/cursos' : '/cursos/' + c.id) %>?_csrf=<%= csrfToken %>"
      enctype="multipart/form-data" class="adm-form adm-box">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <h2 class="adm-form-secao full"><i class="fa-solid fa-file-lines"></i> Página do curso</h2>

  <label class="full">Nome do curso
    <input type="text" name="nome" value="<%= c.nome || '' %>" required>
  </label>

  <label class="full">Resumo
    <textarea name="descricao" rows="2" placeholder="Uma ou duas frases. Aparece no cartão do curso e no topo da página."><%= c.descricao || '' %></textarea>
  </label>

  <label class="full">Texto completo
    <textarea name="descricaoLonga" rows="8"
              placeholder="Texto que aparece na página do curso. Deixe uma linha em branco entre os parágrafos."><%= c.descricaoLonga || '' %></textarea>
  </label>

  <label>Carga horária (horas)
    <input type="number" name="cargaHoraria" min="1" value="<%= c.cargaHoraria || '' %>" required>
  </label>

  <label>Escolaridade mínima
    <select name="escolaridadeMinima">
      <% escolaridades.forEach(function (e) { %>
        <option value="<%= e %>" <%= (c.escolaridadeMinima || '') === e ? 'selected' : '' %>><%= e || '— nenhuma —' %></option>
      <% }) %>
    </select>
  </label>

  <div class="full adm-foto-campo">
    <span class="adm-foto-rot">Foto do curso</span>
    <div class="adm-foto-linha">
      <% if (c.imagemUrl) { %>
        <img src="<%= c.imagemUrl %>" alt="Foto atual" class="adm-foto-atual">
      <% } else { %>
        <span class="adm-foto-atual vazio"><i class="fa-solid fa-image"></i></span>
      <% } %>
      <div>
        <input type="file" name="foto" accept="image/png,image/jpeg,image/webp,image/gif">
        <small class="adm-hint">JPG, PNG, WEBP ou GIF, até 3 MB.<%= c.imagemUrl ? ' Envie outra para substituir a atual.' : (novo ? ' Opcional.' : '') %></small>
        <% if (c.imagemUrl) { %>
          <label class="check"><input type="checkbox" name="removerFoto"> Remover a foto atual</label>
        <% } %>
      </div>
    </div>
  </div>

  <h2 class="adm-form-secao full"><i class="fa-solid fa-tag"></i> Valores</h2>

  <label>À vista (R$)
    <input type="text" name="precoAvista" value="<%= c.precoAvista || '' %>" placeholder="150.00" required>
  </label>

  <label>No parcelado, total (R$)
    <input type="text" name="precoCheio" value="<%= c.precoCheio || '' %>" placeholder="155.00" required>
  </label>

  <label>Máximo de parcelas
    <input type="number" name="parcelas" min="1" value="<%= c.parcelas || 1 %>" required>
  </label>

  <label>Taxa de matrícula (R$)
    <input type="text" name="taxaMatricula"
           value="<%= c.taxaMatricula != null ? c.taxaMatricula : '' %>"
           placeholder="em branco = padrão (<%= typeof taxaPadrao === 'number' && !isNaN(taxaPadrao) ? taxaPadrao.toFixed(2).replace('.', ',') : 'sem padrão' %>)">
  </label>

  <% if (typeof valores !== 'undefined' && valores) { %>
    <div class="full adm-simulacao">
      <span class="adm-foto-rot">Como aparece para o aluno na inscrição</span>
      <%- include('valores-curso', { v: valores, compacto: false }) %>
      <small class="adm-hint">Mesma conta do checkout da escola, com os juros do cartão da Únicopag. Atualiza ao salvar.</small>
    </div>
  <% } else { %>
    <p class="adm-hint full">Depois de salvar, aqui aparece o valor que o aluno paga à vista e no parcelado, já com os juros do cartão.</p>
  <% } %>

  <h2 class="adm-form-secao full" id="certificado"><i class="fa-solid fa-award"></i> Certificado</h2>
  <label class="full">
    Nome no certificado
    <input type="text" name="nomeCertificado" maxlength="120" value="<%= c.nomeCertificado || '' %>" placeholder="Em branco = <%= c.nome || 'nome do curso' %>">
    <small class="adm-hint">Use quando o certificado precisa de um nome mais completo que o do site (ex.: "Punção Venosa e Diluição de Medicamentos").</small>
  </label>
  <label class="full">
    Conteúdo programático
    <textarea name="conteudoProgramatico" rows="8" placeholder="Um item por linha, ex.:&#10;Fundamentos da terapia intravenosa&#10;Revisão anatômica do sistema venoso periférico"><%= c.conteudoProgramatico || '' %></textarea>
    <small class="adm-hint">Um item por linha. Vai no verso do certificado.</small>
  </label>
  <label class="full">
    Validade (opcional)
    <input type="text" name="certificadoValidade" maxlength="120" value="<%= c.certificadoValidade || '' %>" placeholder="Ex.: Validade de 2 anos">
  </label>

  <h2 class="adm-form-secao full"><i class="fa-solid fa-globe"></i> Publicação</h2>

  <label class="check full">
    <input type="checkbox" name="ativo" <%= (novo || c.ativo) ? 'checked' : '' %>>
    Mostrar este curso no site da escola
  </label>

  <div class="full adm-form-rodape">
    <button type="submit" class="adm-btn">
      <i class="fa-solid fa-floppy-disk"></i> <%= novo ? 'Criar curso' : 'Salvar alterações' %>
    </button>
    <a href="/cursos" class="adm-link">Cancelar</a>
  </div>
</form>

<% if (!novo) { %>

  <div id="duvidas" class="adm-box adm-box-pad adm-topo-espaco">
    <h2 class="adm-h2 adm-bloco-h">Dúvidas frequentes</h2>
    <p class="adm-bloco-sub">Aparecem em formato de sanfona na página do curso.</p>

    <% if (typeof erroFaq !== 'undefined' && erroFaq) { %>
      <div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erroFaq %></div>
    <% } %>

    <% var faqs = (curso && curso.faqs) ? curso.faqs : []; %>
    <% if (faqs.length) { %>
      <div class="adm-itens">
        <% faqs.forEach(function (f) { %>
          <div class="adm-item">
            <div class="adm-item-txt">
              <strong><%= f.pergunta %></strong>
              <div><%= f.resposta %></div>
            </div>
            <form method="POST" action="/cursos/<%= c.id %>/faqs/<%= f.id %>/remover"
                  data-confirmar="Remover esta dúvida?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="adm-mini danger" title="Remover"><i class="fa-solid fa-trash"></i></button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="adm-bloco-sub">Nenhuma dúvida cadastrada ainda.</p>
    <% } %>

    <form method="POST" action="/cursos/<%= c.id %>/faqs" class="adm-sub-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="full">Pergunta
        <input type="text" name="pergunta" required maxlength="200">
      </label>
      <label class="full">Resposta
        <textarea name="resposta" required rows="3"></textarea>
      </label>
      <div>
        <button type="submit" class="adm-btn-sm"><i class="fa-solid fa-plus"></i> Adicionar dúvida</button>
      </div>
    </form>
  </div>

<% } else { %>

  <p class="adm-info">
    <i class="fa-solid fa-circle-info"></i>
    Salve o curso primeiro para poder cadastrar as dúvidas frequentes.
  </p>

<% } %>

<%- include('foot') %>