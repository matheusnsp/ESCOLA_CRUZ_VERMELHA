<%
  var usd = function (v) { return 'US$ ' + Number(v || 0).toFixed(2); };
  var STATUS = { ROTEIRO_GERANDO: 'Escrevendo o roteiro…', ROTEIRO_PRONTO: 'Roteiro pronto para revisar', MODULOS_GERANDO: 'Escrevendo os módulos…', CONCLUIDA: 'Concluída', ERRO_ROTEIRO: 'Erro no roteiro', CANCELADA: 'Cancelada' };
  var STATUS_MOD = { pendente: 'na fila', gerando: 'escrevendo…', pronto: 'pronto', erro: 'erro' };
  var andando = ['ROTEIRO_GERANDO', 'MODULOS_GERANDO'].indexOf(g.status) !== -1;
  var mods = g.modulos || [];
%>
<%- include('../head', { titulo: 'Criar curso com IA' }) %>
<%- include('../header', { ativo: 'ead' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1"><%= cursoNome || 'Curso com IA' %></h1>
  <a href="/ead/ia" class="adm-link">← Gerações</a>
</div>
<%- include('_mensagens') %>

<div class="adm-box adm-box-pad adm-espaco" id="iaEstado" data-estado-url="/ead/ia/<%= g.id %>/estado.json" data-status="<%= g.status %>" data-andando="<%= andando ? '1' : '0' %>" data-assinatura="<%= JSON.stringify([g.status, mods.map(function (m) { return m.status; })]) %>">
  <p><span class="ead-selo <%= g.status === 'CONCLUIDA' ? 'validado' : 'rascunho' %>"><%= STATUS[g.status] || g.status %></span>
     <span class="adm-mut">Tema: <%= g.pedido.tema %> · custo até agora: <%= usd(g.custoUsd) %> (<%= g.tokensEntrada + g.tokensSaida + g.tokensCache %> tokens)</span></p>
  <% if (g.erro) { %><p class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= g.erro %></p><% } %>
  <% if (g.status === 'CONCLUIDA' && co) { %>
    <p>Pronto: os módulos estão em rascunho em <a class="adm-link" href="/ead/curso/<%= co.id %>"><%= co.curso.nome %></a>. Revise e valide cada um antes de publicar.</p>
  <% } %>
  <% if (['ERRO_ROTEIRO', 'ROTEIRO_PRONTO'].indexOf(g.status) !== -1) { %>
    <form method="POST" action="/ead/ia/<%= g.id %>/roteiro-de-novo" class="ead-acoes" data-confirmar="Pedir outro roteiro à IA? Custa outra chamada e conta no teto." data-botao="Pedir outro">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="adm-btn adm-btn-out"><i class="fa-solid fa-rotate"></i> Gerar outro roteiro</button>
    </form>
  <% } %>
  <% if (['ROTEIRO_GERANDO', 'ROTEIRO_PRONTO', 'MODULOS_GERANDO', 'ERRO_ROTEIRO'].indexOf(g.status) !== -1) { %>
    <form method="POST" action="/ead/ia/<%= g.id %>/cancelar" class="ead-acoes" data-confirmar="Cancelar a geração? O módulo em andamento termina; o que já foi gravado fica no curso." data-botao="Cancelar geração">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="adm-btn adm-btn-out">Cancelar</button>
    </form>
  <% } %>
</div>

<% if (mods.length) { %>
  <div class="adm-box adm-espaco">
    <ul class="ead-lista">
      <% mods.forEach(function (m) { %>
        <li>
          <span class="ead-num"><%= m.ordem + 1 %></span>
          <div class="ead-tit"><%= m.titulo %><% if (m.erro) { %><small class="adm-erro-texto"><%= m.erro %></small><% } %></div>
          <span class="ead-selo <%= m.status === 'pronto' ? 'validado' : m.status === 'erro' ? 'final' : 'rascunho' %>" data-modulo="<%= m.ordem %>"><%= STATUS_MOD[m.status] || m.status %></span>
          <% if (m.status === 'erro' && g.status === 'MODULOS_GERANDO') { %>
            <form method="POST" action="/ead/ia/<%= g.id %>/modulo/<%= m.ordem %>/tentar" class="ead-acoes">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="adm-btn adm-btn-out">Tentar de novo</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>

<% if (g.status === 'ROTEIRO_PRONTO' && roteiro) { %>
  <%
    // Um módulo do editor. i: índice nos nomes dos campos (o modelo usa "__i__", trocado pelo script).
    var blocoModulo = function (m, i) {
      var nome = 'modulos[' + i + ']';
      var final = !!m.final;
      var h = '<fieldset class="ia-modulo' + (final ? ' ia-final' : '') + '" data-modulo>';
      h += '<input type="hidden" name="ordem[]" value="' + i + '">';
      h += '<div class="adm-form adm-campos">';
      h += '<label class="full">Módulo<input type="text" name="' + nome + '[titulo]" value="' + esc(m.titulo) + '" maxlength="120" required></label>';
      h += '<label>Minutos<input type="number" name="' + nome + '[minutos]" value="' + esc(m.minutos) + '" min="0" max="600"></label>';
      h += '<label class="check"><input type="checkbox" name="' + nome + '[final]" value="1" data-final' + (final ? ' checked' : '') + '> Módulo final (só cenários)</label>';
      h += '<label class="check"><input type="checkbox" name="' + nome + '[remover]" value="1"> Tirar este módulo</label>';
      h += '</div>';
      h += '<div class="ia-bloco-topicos"><div class="adm-form adm-campos ia-topicos" data-topicos data-nome="' + nome + '[topicos]">';
      (m.topicos || []).forEach(function (t, j) { h += '<label class="full">Tópico ' + (j + 1) + '<input type="text" name="' + nome + '[topicos][' + j + ']" value="' + esc(t.titulo) + '" maxlength="120"></label>'; });
      h += '</div><button type="button" class="adm-btn adm-btn-out" data-mais-topico>+ tópico</button></div>';
      h += '<div class="ia-bloco-cenarios"><div class="adm-form adm-campos ia-topicos" data-cenarios data-nome="' + nome + '[cenarios]">';
      (m.cenarios || []).forEach(function (c, j) { h += '<label class="full">Cenário ' + (j + 1) + '<input type="text" name="' + nome + '[cenarios][' + j + ']" value="' + esc(c.titulo) + '" maxlength="120"></label>'; });
      h += '</div><button type="button" class="adm-btn adm-btn-out" data-mais-cenario>+ cenário</button></div>';
      h += '<div class="ead-acoes"><button type="button" class="adm-btn adm-btn-out" data-subir>↑ Subir</button><button type="button" class="adm-btn adm-btn-out" data-descer>↓ Descer</button></div>';
      return h + '</fieldset>';
    };
    var esc = function (v) { return String(v === undefined || v === null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&#34;'); };
  %>
  <form method="POST" action="/ead/ia/<%= g.id %>/confirmar" class="adm-box adm-box-pad ia-roteiro" id="iaRoteiro">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2 class="adm-h2 adm-form-h">Roteiro proposto</h2>
    <p class="adm-mut">Ajuste à vontade: renomeie, tire, mude a ordem, acrescente módulos e tópicos. Só o último módulo pode ser o final, que tem só cenários (2 a 4).</p>
    <div data-modulos>
      <% roteiro.modulos.forEach(function (m, i) { %><%- blocoModulo(m, i) %><% }) %>
    </div>
    <p><button type="button" class="adm-btn adm-btn-out" data-mais-modulo>+ módulo</button></p>
    <button type="submit" class="adm-btn"><i class="fa-solid fa-wand-magic-sparkles"></i> Gerar o curso</button>
  </form>
  <template id="iaModeloModulo"><%- blocoModulo({ titulo: '', minutos: 20, final: false, topicos: [{ titulo: '' }], cenarios: [] }, '__i__') %></template>
<% } %>

<script src="<%= asset('/js/ead-ia.js') %>"></script>
<%- include('../foot') %>
