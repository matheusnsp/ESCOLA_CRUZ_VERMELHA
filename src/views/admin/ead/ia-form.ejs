<% var v = valores || {}; %>
<%- include('../head', { titulo: 'Criar curso com IA' }) %>
<%- include('../header', { ativo: 'ead' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Criar curso com IA</h1>
  <a href="/ead/ia" class="adm-link">← Gerações</a>
</div>
<%- include('_ia-passos', { passo: 1 }) %>
<%- include('_mensagens', { ok: null }) %>
<% if (!chave) { %><div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= msgChave %></div><% } %>

<form method="POST" action="/ead/ia/novo?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="adm-box adm-box-pad ia-ideia">
  <h2 class="adm-h2 adm-form-h">Qual é a ideia?</h2>
  <p class="adm-mut">Conte com suas palavras o que você quer ensinar e para quem. A IA sugere o nome, a descrição, a carga horária, o preço, os módulos e as dúvidas frequentes, e você confere no próximo passo.</p>
  <div class="adm-form adm-campos">
    <label class="full">O que você quer ensinar, e para quem?
      <textarea name="ideia" rows="6" required placeholder="Ex.: primeiros socorros para professores de creche, com foco em engasgo, quedas e como pedir ajuda"><%= v.ideia || '' %></textarea>
    </label>
    <p class="full adm-hint">Dica: quer dúvidas específicas na página do curso? Escreva aqui, por exemplo "Inclua nas dúvidas: Precisa de experiência? Tem certificado?". A IA usa essas perguntas como você escreveu e completa até 6.</p>
  </div>

  <details class="ia-opcional"<%- v.destino === 'existente' || v.texto ? ' open' : '' %>>
    <summary>Opcional: material de base e destino</summary>
    <div class="adm-form adm-campos">
      <p class="full adm-mut">A IA segue o material e não inventa dados técnicos. Até 3 arquivos PDF ou Word (.docx), 20 MB no total.</p>
      <label class="full">Arquivos<input type="file" name="material" accept=".pdf,.docx" multiple></label>
      <label class="full">Texto colado<textarea name="texto" rows="4" maxlength="100000"><%= v.texto || '' %></textarea></label>
      <label class="full"><input type="radio" name="destino" value="novo" <%= v.destino !== 'existente' ? 'checked' : '' %>> Curso novo (só online)</label>
      <label class="full"><input type="radio" name="destino" value="existente" <%= v.destino === 'existente' ? 'checked' : '' %>> Acrescentar módulos a um curso online que já existe</label>
      <label class="full">Curso online
        <select name="cursoOnlineId">
          <option value="">— escolha —</option>
          <% cursos.forEach(function (c) { %><option value="<%= c.id %>" <%= v.cursoOnlineId === c.id ? 'selected' : '' %>><%= c.curso.nome %><%= c.publicado ? ' (publicado)' : '' %></option><% }) %>
        </select>
      </label>
      <% if (cursos.some(function (c) { return c.publicado; })) { %><p class="full adm-mut">Curso marcado como "(publicado)": os módulos que a IA escrever aparecem para os alunos na hora, ainda em rascunho. Prefira revisar antes, num curso não publicado.</p><% } %>
    </div>
  </details>

  <p class="adm-mut">A proposta custa centavos; o curso inteiro, cerca de US$ 1 a 3 (mais com material grande). Tudo conta no teto mensal.</p>
  <button type="submit" class="adm-btn" <%= chave ? '' : 'disabled' %>><i class="fa-solid fa-wand-magic-sparkles"></i> Gerar proposta</button>
</form>
<%- include('../foot') %>
