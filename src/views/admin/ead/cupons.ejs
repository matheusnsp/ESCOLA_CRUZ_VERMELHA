<%
  var dataBR = function (d) { return d ? new Date(d).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : '—'; };
  var brl = function (v) { return Number(v).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); };
  var desconto = function (c) {
    if (c.tipo === 'FINAL') return 'Matrícula ' + brl(c.valor) + (c.taxaFinal === null || c.taxaFinal === undefined ? ' · taxa normal' : Number(c.taxaFinal) > 0 ? ' · inscrição ' + brl(c.taxaFinal) : ' · inscrição grátis'); // 2026-11-17
    return c.tipo === 'PERCENTUAL' ? Number(c.valor).toLocaleString('pt-BR', { maximumFractionDigits: 2 }) + '%' : brl(c.valor);
  };
%>
<%- include('../head', { titulo: 'Cupons' }) %>
<%- include('../header', { ativo: 'cupons' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Cupons de desconto</h1>
  <a class="adm-btn" href="/ead/cupons/novo" data-criar><i class="fa-solid fa-plus"></i> Novo cupom</a>
</div>
<%- include('_mensagens') %>
<p class="adm-mut">Códigos de desconto dos cursos online, e-books e cursos presenciais. O aluno digita o código na página do curso (ou na inscrição do presencial), ou chega por um link com <code>?cupom=CÓDIGO</code>. No presencial, o desconto vale só no valor do curso, não na taxa de inscrição; no tipo <b>Valor final</b> você digita quanto a pessoa paga na matrícula e na taxa. Com <b>Mostrar no site</b>, o cupom aparece nas turmas e entra sozinho na inscrição. Os usos contam só as compras pagas.</p>

<nav class="ead-filtros" aria-label="Filtro">
  <a href="/ead/cupons" class="<%= ativos === undefined ? 'on' : '' %>">Todos</a>
  <a href="/ead/cupons?ativos=1" class="<%= ativos === true ? 'on' : '' %>">Ativos</a>
  <a href="/ead/cupons?ativos=0" class="<%= ativos === false ? 'on' : '' %>">Desativados</a>
</nav>

<% if (!lista.length) { %>
  <div class="adm-box adm-box-pad"><p class="ead-vazio">Nenhum cupom<%= ativos === undefined ? ' ainda. Crie o primeiro.' : ' neste filtro.' %></p></div>
<% } else { %>
  <div class="adm-box adm-espaco">
    <div class="ead-tabela-rolagem">
      <table class="adm-table">
        <thead><tr><th>Código</th><th>Desconto / valor final</th><th>Vale para</th><th>Validade</th><th class="centro">Usos</th><th>Desconto dado</th><th>Situação</th></tr></thead>
        <tbody>
          <% lista.forEach(function (c) { %>
            <tr>
              <td><a class="adm-link" href="/ead/cupons/<%= c.id %>"><b><%= c.codigo %></b></a></td>
              <td><%= desconto(c) %></td>
              <td><%= c.curso || 'Todos (cursos e e-books)' %></td>
              <td><%= c.validoAte ? 'até ' + dataBR(c.validoAte) : 'sem prazo' %></td>
              <td class="centro"><%= c.usos %> / <%= c.limiteUsos === null ? '∞' : c.limiteUsos %>
                <% if (c.quantidade) { %><br><small class="adm-mut">restam <%= c.quantidade.restam %> de <%= c.limiteUsos %><%= c.renovar ? ' · renova' + (c.quantidade.rodada > 1 ? ' (' + c.quantidade.rodada + 'ª rodada)' : '') : '' %></small><% } %>
                <% if (c.noSite) { %><br><small class="adm-mut">no site</small><% } %></td>
              <td><%= brl(c.totalDesconto) %></td>
              <td><span class="ead-selo <%= c.ativo ? 'validado' : 'rascunho' %>"><%= c.ativo ? 'Ativo' : 'Desativado' %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../foot') %>
