<%- include('../head', { titulo: co.curso.nome + ' · EAD' }) %>
<%- include('../header', { ativo: 'ead' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1"><%= co.curso.nome %></h1>
  <a href="/ead" class="adm-link">← Cursos online</a>
</div>
<%- include('_abas-curso', { co: co, aba: 'conteudo' }) %>
<%- include('_mensagens') %>
<%- include('_aviso-publicado', { publicado: co.publicado }) %>

<% if (typeof dadosCurso !== 'undefined' && dadosCurso) { %>
<%# Etapa 5: curso que só existe online — os dados do curso são editados aqui, não no presencial. %>
<div class="adm-box adm-box-pad adm-espaco ead-dados-curso">
  <div class="ead-topico-cab">
    <h2 class="adm-h2 adm-form-h"><i class="fa-solid fa-laptop"></i> Dados do curso <span class="ead-selo final">Só online</span></h2>
    <a class="adm-btn adm-btn-out" href="/ead/curso/<%= co.id %>/dados"><i class="fa-solid fa-pen"></i> Editar</a>
  </div>
  <div class="ead-dados-grade">
    <% if (dadosCurso.imagemUrl) { %><img src="<%= dadosCurso.imagemUrl %>" alt=""><% } %>
    <div>
      <p><b><%= dadosCurso.nome %></b> · <%= dadosCurso.cargaHoraria %> horas</p>
      <p class="adm-mut"><%= dadosCurso.descricao || 'Sem descrição.' %></p>
    </div>
  </div>
</div>
<% } %>
<%# Etapa 4: venda no site. Preço único (PIX ou cartão, sem taxa) e o interruptor "Publicar no site". %>
<div class="adm-box adm-espaco">
  <div class="ead-topico-cab"><h3>Módulos</h3>
    <a class="adm-btn" href="/ead/curso/<%= co.id %>/modulos/novo"><i class="fa-solid fa-plus"></i> Novo módulo</a>
  </div>
  <% if (!modulos.length) { %>
    <p class="ead-vazio">Nenhum módulo ainda.</p>
  <% } else { %>
    <ul class="ead-lista">
      <% modulos.forEach(function (m, i) { %>
        <li>
          <span class="ead-num"><%= m.final ? '★' : i + 1 %></span>
          <div class="ead-tit">
            <a href="/ead/modulo/<%= m.id %>"><%= m.titulo %></a>
            <small>
              <% var _min = ead.minutosDoModulo(m); if (_min) { %><%= _min %> min ·<% } %>
              <% if (m.final) { %><%= m.nCenarios %> cenário(s)<% } else { %><%= m.topicos.length %> tópico(s) · <%= m.nTelas %> tela(s) · <%= m.nPerguntas %> pergunta(s) ativa(s)<% } %>
            </small>
          </div>
          <% if (m.final) { %><span class="ead-selo final">Final · cenários</span><% } %>
          <span class="ead-selo <%= m.status === 'VALIDADO' ? 'validado' : 'rascunho' %>"><%= m.status === 'VALIDADO' ? 'Validado' : 'Rascunho' %></span>
          <% if (m.geradoPorIa) { %><span class="ead-selo final" title="Etapa 9: escrito pela IA">Gerado por IA — revise antes de validar</span><% } %>
          <div class="ead-acoes">
            <% if (!m.final) ['subir', 'descer'].forEach(function (d) { %>
              <form method="POST" action="/ead/modulo/<%= m.id %>/<%= d %>" <% if (m.status === 'VALIDADO') { %>data-confirmar="Mudar a ordem volta este módulo (e o vizinho, se validado) para rascunho. Continuar?"<% } %>>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="adm-mini" title="<%= d === 'subir' ? 'Subir' : 'Descer' %>"><i class="fa-solid fa-arrow-<%= d === 'subir' ? 'up' : 'down' %>"></i></button>
              </form>
            <% }) %>
          </div>
        </li>
      <% }) %>
    </ul>
    <p class="adm-nota" style="margin: 0 16px 14px"><i class="fa-solid fa-circle-info"></i> O módulo final (de cenários) aparece sempre por último para o aluno.</p>
  <% } %>
</div>

<div class="adm-box adm-box-pad adm-espaco ead-venda">
  <h2 class="adm-h2 adm-form-h"><i class="fa-solid fa-store"></i> Venda no site</h2>
  <% if (venda.aviso) { %>
    <div class="adm-alerta adm-alerta-pendente adm-espaco"><i class="fa-solid fa-triangle-exclamation"></i> <span><%= venda.aviso %></span></div>
  <% } %>
  <%# Vitrine (2026-11-09): curso gratuito. Marcado, o preço e as parcelas ficam travados. %>
  <form method="POST" action="/ead/curso/<%= co.id %>/gratuito" class="ead-gratuito adm-espaco">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="gratuito" value="<%= co.gratuito ? '0' : '1' %>">
    <label class="ead-gratuito-caixa"><input type="checkbox" name="gratuito" value="1" disabled<%= co.gratuito ? ' checked' : '' %>> <b>Curso gratuito</b></label>
    <span class="adm-mut"><%= co.gratuito ? 'O aluno libera com um clique (precisa ter conta). Sem preço, sem parcelas, sem cupom.' : 'Marque para oferecer o curso de graça (o aluno precisa ter conta).' %></span>
    <button type="submit" class="adm-btn adm-btn-out"><%= co.gratuito ? 'Deixar de ser gratuito' : 'Marcar como gratuito' %></button>
  </form>
  <div class="ead-venda-grade">
    <form method="POST" action="/ead/curso/<%= co.id %>/preco" class="adm-form c1 ead-venda-preco">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Preço do curso online (R$)
        <input type="text" name="precoOnline" inputmode="decimal" placeholder="49,90" required<%= co.gratuito ? ' disabled' : '' %>
               value="<%= co.gratuito ? 'Grátis' : digitado.precoOnline !== undefined ? digitado.precoOnline : co.precoOnline === null ? '' : Number(co.precoOnline).toFixed(2).replace('.', ',') %>">
      </label>
      <p class="adm-mut"><%= co.gratuito ? 'Curso gratuito: o aluno não paga nada.' : 'Cobrança única, por PIX ou cartão, sem taxa de inscrição.' %></p>
      <% if (!co.gratuito) { %><button type="submit" class="adm-btn adm-btn-out">Salvar preço</button><% } %>
    </form>
    <form method="POST" action="/ead/curso/<%= co.id %>/parcelas" class="adm-form c1 ead-venda-preco">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Parcelas no cartão (máx.)
        <input type="number" name="maxParcelas" min="1" max="12" step="1" required value="<%= co.maxParcelas || 1 %>"<%= co.gratuito ? ' disabled' : '' %>>
      </label>
      <p class="adm-mut">1 = só à vista. Acima disso, o aluno escolhe no cartão e paga os juros do Únicopag, como no presencial.</p>
      <% if (!co.gratuito) { %><button type="submit" class="adm-btn adm-btn-out">Salvar parcelas</button><% } %>
    </form>
    <div>
      <p class="ead-venda-estado">
        <span class="ead-selo <%= co.publicado ? 'validado' : 'rascunho' %>"><%= co.publicado ? 'No site' : 'Fora do site' %></span>
        <% if (co.publicado) { %><a class="adm-link" href="<%= venda.urlCurso %>" target="_blank" rel="noopener">Abrir a página do curso ↗</a><% } %>
      </p>
      <% if (co.publicado) { %>
        <form method="POST" action="/ead/curso/<%= co.id %>/publicar" data-confirmar="Tirar o curso do site? Ele some do catálogo; quem já comprou continua com acesso." data-botao="Tirar do site">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acao" value="desligar">
          <button class="adm-btn adm-btn-out"><i class="fa-solid fa-eye-slash"></i> Tirar do site</button>
        </form>
      <% } else if (venda.pendencias.length) { %>
        <p class="adm-mut">Para publicar, falta:</p>
        <ul class="ead-pendencias"><% venda.pendencias.forEach(function (p) { %><li><%= p %></li><% }) %></ul>
      <% } else { %>
        <form method="POST" action="/ead/curso/<%= co.id %>/publicar" data-confirmar="Publicar no site? O curso aparece no catálogo com o selo ONLINE e já pode ser comprado." data-botao="Publicar" data-confirmar-tipo="ok">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acao" value="ligar">
          <button class="adm-btn"><i class="fa-solid fa-globe"></i> Publicar no site</button>
        </form>
      <% } %>
    </div>
  </div>
</div>

<%# Imagens com IA (2026-11-09): o Claude escreve o pedido, a OpenAI gera. Só preenche o que está vazio. %>
<% var _ci = imagensIa && imagensIa.curso; %>
<div class="adm-box adm-box-pad adm-espaco ead-imagens-ia">
  <h2 class="adm-h2 adm-form-h"><i class="fa-solid fa-wand-magic-sparkles"></i> Imagens com IA</h2>
  <%- include('_status-imagens', { st: imagensIa && imagensIa.status }) %>
  <div class="ead-img-ia-linha">
    <% if (_ci && _ci.imagemUrl) { %><img src="<%= _ci.imagemUrl %>" alt="Imagem do curso" class="ead-img-ia"><% } else { %><span class="ead-img-ia vazio"><i class="fa-solid fa-image"></i></span><% } %>
    <div>
      <p><b>Imagem do curso</b><% if (_ci && _ci.imagemGeradaPorIa) { %> <span class="ead-selo ia">Imagem gerada por IA</span><% } %></p>
      <% if (_ci && _ci.imagemSugestao) { %><p class="adm-mut">Descrição: <%= _ci.imagemSugestao %></p><% } %>
      <% if (_ci && imagensIa.temOpenAI) { %>
        <form method="POST" action="/ead/curso/<%= co.id %>/capa/gerar-outra" class="ead-pedido-img" data-confirmar="Gerar a imagem do curso com este pedido? A atual é apagada." data-botao="Gerar" data-confirmar-tipo="ok">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Pedido da imagem <small class="adm-mut">(edite ou escreva o seu, pode ser em português)</small>
            <textarea name="pedido" rows="3" maxlength="1000" placeholder="Ex.: professora organizando um kit de primeiros socorros numa mesa da escola, luz natural"><%= _ci.imagemPedido || '' %></textarea>
          </label>
          <button type="submit" class="adm-btn adm-btn-out"><i class="fa-solid fa-wand-magic-sparkles"></i> Gerar com este pedido</button>
        </form>
      <% } %>
    </div>
  </div>
  <p class="adm-mut">Gera a imagem do curso e a de abertura de cada módulo que ainda não tem imagem. Nunca troca uma imagem que você enviou. O Claude escreve o pedido e a OpenAI desenha<%= imagensIa && imagensIa.temOpenAI ? '' : ' (sem a chave da OpenAI, só as descrições ficam gravadas)' %>.</p>
  <form method="POST" action="/ead/curso/<%= co.id %>/imagens-ia" class="ead-acoes" data-confirmar="Gerar as imagens que faltam com IA? Leva de 1 a 5 minutos; não feche a página." data-botao="Gerar imagens" data-confirmar-tipo="ok">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="adm-btn"><i class="fa-solid fa-wand-magic-sparkles"></i> Gerar imagens com IA</button>
  </form>
</div>

<div class="adm-box adm-box-pad adm-espaco">
  <h2 class="adm-h2 adm-form-h"><i class="fa-solid fa-link"></i> Link de teste</h2>
  <p class="adm-mut">Abre o curso no site como o aluno verá, sem login, pelo celular. Não aparece no menu, no Google nem no sitemap; só quem tiver o link entra. Mostra também os módulos em rascunho.</p>
  <% if (linkTeste) { %>
    <div class="ead-link-teste adm-espaco">
      <input type="text" readonly value="<%= linkTeste %>" aria-label="Link de teste">
      <a class="adm-btn adm-btn-out" href="<%= linkTeste %>" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square"></i> Abrir</a>
    </div>
    <div class="ead-acoes">
      <form method="POST" action="/ead/curso/<%= co.id %>/link-teste" data-confirmar="Trocar o link? O link atual deixa de abrir na hora.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acao" value="trocar">
        <button class="adm-btn adm-btn-out"><i class="fa-solid fa-rotate"></i> Trocar</button>
      </form>
      <form method="POST" action="/ead/curso/<%= co.id %>/link-teste" data-confirmar="Desligar o link de teste? Ninguém mais consegue abrir.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acao" value="desligar">
        <button class="adm-btn adm-btn-out"><i class="fa-solid fa-link-slash"></i> Desligar</button>
      </form>
    </div>
  <% } else { %>
    <form method="POST" action="/ead/curso/<%= co.id %>/link-teste">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acao" value="gerar">
      <button class="adm-btn"><i class="fa-solid fa-link"></i> Gerar link de teste</button>
    </form>
  <% } %>
</div>

<div class="adm-box adm-box-pad adm-espaco">
  <h2 class="adm-h2 adm-form-h"><i class="fa-solid fa-id-card"></i> Cartão de bolso</h2>
  <p class="adm-mut">Gerado das telas do curso (revisão rápida, foto e alerta). O aluno baixa ao concluir, junto com o certificado.</p>
  <a class="adm-btn adm-btn-out" href="/ead/curso/<%= co.id %>/cartao-de-bolso.pdf"><i class="fa-solid fa-file-pdf"></i> Baixar cartão de bolso (prévia)</a>
</div>

<form method="POST" action="/ead/curso/<%= co.id %>" class="adm-box adm-box-pad adm-espaco">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2 class="adm-h2 adm-form-h">Configuração</h2>
  <div class="adm-form adm-campos">
    <label>Nota mínima no quiz e no pré-teste (%)
      <input type="number" name="notaMinimaQuiz" min="50" max="100" step="1" required value="<%= digitado.notaMinimaQuiz !== undefined ? digitado.notaMinimaQuiz : co.notaMinimaQuiz %>">
    </label>
  </div>
  <button type="submit" class="adm-btn adm-btn-out">Salvar</button>
</form>

<form method="POST" action="/ead/curso/<%= co.id %>/desativar" class="adm-box adm-box-pad"
      data-confirmar="Desativar o EAD de “<%= co.curso.nome %>”? Todos os módulos, telas, perguntas e cenários deste curso serão APAGADOS. O curso presencial não muda." data-botao="Apagar conteúdo">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2 class="adm-h2 adm-form-h">Desativar EAD</h2>
  <p class="adm-mut">Apaga todo o conteúdo online deste curso. Só é possível com todos os módulos em rascunho.</p>
  <button type="submit" class="adm-btn adm-btn-perigo"><i class="fa-solid fa-trash"></i> Desativar EAD e apagar conteúdo</button>
</form>

<%- include('../foot') %>
