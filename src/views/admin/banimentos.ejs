<%- include('head', { titulo: 'Banimentos' }) %>
<%- include('header', { ativo: 'banimentos' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1"><i class="fa-solid fa-ban"></i> Alunos Banidos</h1>
  <a href="/alunos" class="adm-link">← Voltar para Alunos</a>
</div>

<% if (flash) { %>
  <div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= flash %></div>
<% } %>

<form method="GET" action="/banimentos" class="adm-filtros">

  <label class="adm-campo cresce">
    <span>Buscar</span>
    <input
      type="text"
      name="q"
      value="<%= busca %>"
      placeholder="Nome ou e-mail"
    >
  </label>

  <button type="submit" class="adm-btn-neutro">
    <i class="fa-solid fa-filter"></i> Filtrar
  </button>

</form>

<div class="adm-box">
<% if (!banidos.length) { %>
  <div class="adm-vazio">Nenhum aluno banido encontrado.</div>
<% } else { %>
  <table class="adm-table">
    <thead>
      <tr>
        <th>Aluno</th>
        <th>Motivo</th>
        <th>Banido em</th>
        <th>Matrículas</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
    <% for (const aluno of banidos) {
       const info = motivoMap[aluno.id] || {};
    %>
      <tr>
        <td>
          <strong><%= aluno.nome %></strong><br>
          <small class="adm-mut"><%= aluno.email %></small>
        </td>
        <td><%= info.motivo || '—' %></td>
        <td class="adm-mut">
          <% if (info.em) { %>
            <%= new Date(info.em).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %>
          <% } else { %>—<% } %>
        </td>
        <td><%= aluno._count.matriculas %></td>
        <td class="adm-acoes">
          <a href="/alunos/<%= aluno.id %>/editar" class="adm-mini" title="Ver perfil">
            <i class="fa-solid fa-pen-to-square"></i>
          </a>
          <form method="POST" action="/alunos/<%= aluno.id %>/desbanir" style="display:inline"
            onsubmit="return confirm('Desbanir <%= aluno.nome.split(' ')[0] %>?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="adm-mini" style="color:#16a34a;border:none;background:none;cursor:pointer;" title="Desbanir">
              <i class="fa-solid fa-lock-open"></i>
            </button>
          </form>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
<% } %>
</div>

<%- include('foot') %>