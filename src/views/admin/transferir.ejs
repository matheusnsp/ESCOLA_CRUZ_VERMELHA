<%- include('head', { titulo: 'Transferir aluno' }) %>
<%- include('header', { ativo: 'inscricoes' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Transferir aluno</h1>
  <a href="/inscricoes" class="adm-link">← Voltar</a>
</div>

<% if (erro) { %>
  <div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
<% } %>

<!-- ═══ Resumo da inscrição ═══════════════════════════════════════════════ -->
<div class="adm-box adm-box-pad adm-espaco">
  <div class="transf-resumo">
    <div>
      <span>Aluno</span>
      <strong><%= m.aluno.nome %></strong>
      <small><%= m.aluno.email %></small>
    </div>
    <div>
      <span>Turma atual</span>
      <strong><%= m.turma.curso.nome %></strong>
      <small>
        <%= new Date(m.turma.inicioPrevisto).toLocaleDateString('pt-BR') %><% if (m.turma.aulas && m.turma.aulas.length) { %> · <%= m.turma.aulas[0].horario %><% } %>
      </small>
    </div>
    <div>
      <span>Plano / Valor atual</span>
      <strong><%= m.plano === 'A_VISTA' ? 'À vista' : 'Parcelado' %></strong>
      <small><%= formatBRL(m.valorCurso) %> (curso + matrícula)</small>
    </div>
    <div>
      <span>Status</span>
      <%- statusBadge(m.statusPagamento) %>
    </div>
  </div>

  <% if (m.diferencaTransferencia) { %>
    <% if (Number(m.diferencaTransferencia) > 0) { %>
      <div class="adm-alerta adm-alerta-pendente">
        <i class="fa-solid fa-triangle-exclamation"></i>
        Já existe uma diferença pendente de pagamento de uma transferência
        anterior: <%= formatBRL(m.diferencaTransferencia) %>.
      </div>
    <% } else { %>
      <div class="adm-alerta adm-alerta-reembolso">
        <i class="fa-solid fa-triangle-exclamation"></i>
        Já existe um valor a reembolsar de uma transferência anterior:
        <%= formatBRL(Math.abs(Number(m.diferencaTransferencia))) %>.
      </div>
    <% } %>
  <% } %>
</div>

<!-- ═══ Formulário ════════════════════════════════════════════════════════ -->
<form method="POST" action="/inscricoes/<%= m.id %>/transferir" class="adm-box adm-box-pad"
      onsubmit="return confirm('Confirmar a transferência deste aluno?')">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <label class="adm-campo-largo">
    Turma de destino
    <select name="turmaDestino" id="turmaDestino" required>
      <option value="">— selecione —</option>
      <% turmas.forEach(function (t) { %>
        <option value="<%= t.id %>"
                data-preco-avista="<%= t.curso.precoAvista %>"
                data-preco-cheio="<%= t.curso.precoCheio %>"
                data-taxa="<%= t.curso.taxaMatricula != null ? t.curso.taxaMatricula : 100 %>">
          <%= t.curso.nome %> — <%= new Date(t.inicioPrevisto).toLocaleDateString('pt-BR') %> (<%= t.status %>)<%= t.cursoId === m.turma.cursoId ? ' · mesmo curso' : ' · outro curso' %>
        </option>
      <% }) %>
    </select>
  </label>

  <div id="diffAviso" class="adm-diff"></div>

  <p class="adm-explica">
    <i class="fa-solid fa-circle-info"></i>
    <span>
      Mesmo curso: sem alteração de valores. Curso diferente: o valor é
      recalculado pelo preço do novo curso (+ taxa de matrícula) no mesmo plano
      do aluno. Se ficar mais caro, a diferença fica pendente de pagamento; se
      ficar mais barato, o valor pago a mais fica registrado para reembolso.
      A vaga no destino não é bloqueada, mesmo se estiver cheia.
    </span>
  </p>

  <button type="submit" class="adm-btn">
    <i class="fa-solid fa-right-left"></i> Confirmar transferência
  </button>
</form>

<script>
(function () {
  const valorAtual = <%- JSON.stringify(Number(m.valorCurso)) %>; // já inclui a taxa de matrícula (curso + taxa)
  const plano  = <%- JSON.stringify(m.plano) %>;
  const select = document.getElementById('turmaDestino');
  const aviso  = document.getElementById('diffAviso');
  const fmt = (v) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

  select.addEventListener('change', function () {
    const opt = select.options[select.selectedIndex];

    // as cores vivem no CSS (.adm-diff.mais / .menos / .igual)
    aviso.className = 'adm-diff';

    if (!opt.value) { aviso.textContent = ''; return; }

    const precoCurso = plano === 'A_VISTA' ? Number(opt.dataset.precoAvista) : Number(opt.dataset.precoCheio);
    const taxa  = Number(opt.dataset.taxa);
    const preco = precoCurso + taxa; // soma a taxa pra ficar na mesma base do valorAtual (curso + taxa)
    const diff  = Math.round((preco - valorAtual) * 100) / 100;

    if (diff > 0) {
      aviso.classList.add('mais');
      aviso.innerHTML = 'Curso mais caro: ficará <strong>' + fmt(diff) + '</strong> pendente de pagamento após a transferência.';
    } else if (diff < 0) {
      aviso.classList.add('menos');
      aviso.innerHTML = 'Curso mais barato: <strong>' + fmt(Math.abs(diff)) + '</strong> ficará registrado a reembolsar.';
    } else {
      aviso.classList.add('igual');
      aviso.textContent = 'Mesmo valor, sem diferença a cobrar ou estornar.';
    }
  });
})();
</script>

<%- include('foot') %>