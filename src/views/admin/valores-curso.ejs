<%
// Valores que o aluno paga (lib/simular-valores.js): à vista e parcelado com os juros do cartão.
// Uso: include('valores-curso', { v, compacto })
const _f = (n) => formatBRL(n);
%>
<% if (!v) { %>
  <span class="adm-mut">—</span>
<% } else if (compacto) { %>
  <%
    // Só os dois totais que o aluno paga, com a taxa de matrícula nos dois para dar para comparar.
    // O detalhe (parcelas, juros, taxa à parte) fica no título e em Editar curso.
    const _dicaAv = 'curso ' + _f(v.aVista.curso) + ' + taxa ' + _f(v.aVista.taxa) + ', numa cobrança só';
    const _dicaPa = v.parcelado ? v.parcelado.numParcelas + '× ' + _f(v.parcelado.valorParcela) + ' no cartão' + (v.parcelado.juros ? ' (com juros)' : '') + ' + taxa ' + _f(v.parcelado.taxa) + ' paga à parte' : '';
  %>
  <div class="adm-valores">
    <p title="<%= _dicaAv %>"><b class="num"><%= _f(v.aVista.total) %></b> <span>à vista</span></p>
    <% if (v.parcelado) { %>
      <p title="<%= _dicaPa %>"><b class="num"><%= _f(v.parcelado.total) %></b> <span>parcelado</span></p>
      <% if (!v.parcelado.juros) { %><small class="adm-txt-alerta" title="Não foi possível consultar os juros na Únicopag agora">sem juros: gateway fora do ar</small><% } %>
    <% } %>
  </div>
<% } else { %>
  <div class="adm-valores-caixa">
    <div class="adm-valores-opcao">
      <em>À vista · PIX ou cartão</em>
      <b class="num"><%= _f(v.aVista.total) %></b>
      <small class="adm-mut">curso <%= _f(v.aVista.curso) %> + taxa de matrícula <%= _f(v.aVista.taxa) %></small>
    </div>
    <div class="adm-valores-opcao">
      <em>Parcelado no cartão</em>
      <% if (v.parcelado) { %>
        <b class="num"><%= v.parcelado.numParcelas %>× de <%= _f(v.parcelado.valorParcela) %></b>
        <small class="adm-mut">total no cartão <b><%= _f(v.parcelado.cursoComJuros) %></b><%= v.parcelado.juros ? ' com juros' : '' %><% if (v.parcelado.taxa) { %> · a taxa de matrícula (<%= _f(v.parcelado.taxa) %>) é paga à parte, antes das parcelas<% } %></small>
        <% if (!v.parcelado.juros) { %><small class="adm-txt-alerta">Não foi possível consultar os juros na Únicopag agora; valor sem juros.</small><% } %>
      <% } else { %>
        <b class="adm-mut">não oferecido</b>
        <small class="adm-mut">Para oferecer, coloque mais de 1 em "Máximo de parcelas".</small>
      <% } %>
    </div>
  </div>
<% } %>
