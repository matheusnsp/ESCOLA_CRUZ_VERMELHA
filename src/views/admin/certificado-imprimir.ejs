<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Certificados · <%= turma.curso.nome %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400;0,700;1,400&family=Great+Vibes&family=Libre+Baskerville:wght@400;700&family=Pinyon+Script&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= asset('/certificado.css') %>">
</head>
<body>
  <%# Layout do modelo em Word da escola (IMPRIMIR_PULSÃO.docx): A4 deitado, frente e verso. %>
  <header class="cert-barra">
    <div>
      <b><%= lista.length %> <%= lista.length === 1 ? 'certificado' : 'certificados' %></b> · <%= lista.length * 2 %> páginas (frente e verso)
      <small>Na impressora: papel A4 deitado, margens "Nenhuma", frente e verso virando pela <b>borda curta</b>.</small>
    </div>
    <button type="button" id="certImprimir">Imprimir</button>
  </header>

  <% lista.forEach(function (c) { %>
    <section class="cert-pagina cert-frente">
      <img class="cert-moldura" src="/img/certificado/moldura.svg" alt="">
      <div class="cert-marca">
        <img src="/img/certificado/cruz.jpg" alt="">
        <img src="/img/certificado/cruz-vermelha-rj.jpg" alt="Cruz Vermelha Brasileira — Rio de Janeiro">
      </div>
      <h1 class="cert-titulo">Certificado</h1>
      <p class="cert-nome"><%= c.nome %></p>
      <p class="cert-texto">
        <%= c.portador %> do <b><%= c.documento ? c.documento.tipo + ' ' + c.documento.numero : 'documento ____________' %></b>, concluiu o
        <b>Curso Livre de <%= c.curso.toUpperCase() %></b>, ministrado pela Cruz Vermelha Brasileira – Filial Rio de Janeiro com
        carga horária de <%= c.cargaHoraria %> <%= c.periodo.frase %>.
      </p>
      <p class="cert-local"><%= c.emitidoEm %></p>
      <div class="cert-assinaturas">
        <div>
          <span class="cert-linha"></span>
          <b><%= c.coordNome %></b>
          <span><%= c.coordCargo %></span>
          <small>Cruz Vermelha Brasileira - Rio de Janeiro</small>
        </div>
        <div>
          <span class="cert-linha"></span>
          <b><%= c.instrutorNome || ' ' %></b>
          <span>Instrutor<%= c.instrutorRegistro ? ' ' + c.instrutorRegistro : '' %></span>
          <small>Cruz Vermelha Brasileira Rio de Janeiro</small>
        </div>
      </div>
    </section>

    <section class="cert-pagina cert-verso">
      <header class="cert-verso-topo">
        <div>
          <b>CRUZ VERMELHA BRASILEIRA</b>
          <span>FILIAL DO ESTADO DO RIO DE JANEIRO</span>
          <span>CENTRO DE FORMAÇÃO CVB – RJ</span>
        </div>
        <div class="cert-marca">
          <img src="/img/certificado/cruz.jpg" alt="">
          <img src="/img/certificado/cruz-vermelha-rj.jpg" alt="Cruz Vermelha Brasileira — Rio de Janeiro">
        </div>
      </header>
      <div class="cert-verso-corpo">
        <div class="cert-verso-dados">
          <p class="cert-verso-curso">Curso Livre<br><b><%= c.curso %></b></p>
          <p>Ministrado pela Cruz Vermelha Brasileira<br>Filial Rio de Janeiro</p>
          <p>Data: <%= c.periodo.curta %><br>Carga Horária: <%= c.cargaHoraria %></p>
          <p><b>Aluno</b><br><%= c.nome %><% if (c.documento) { %><br><%= c.documento.tipo %> <%= c.documento.numero %><% } %></p>
          <p><b>Instrutor</b><br><%= c.instrutorNome || '—' %></p>
          <p>Certificado Registrado no<br><b>Livro</b> Nº <%= c.livro %><br><b>Registro:</b> Nº <%= c.registro %></p>
          <% if (c.validade) { %><p><b><%= c.validade %></b></p><% } %>
        </div>
        <div class="cert-verso-conteudo">
          <% if (c.conteudo.length) { %>
            <h2>Conteúdo Programático:</h2>
            <ul><% c.conteudo.forEach(function (item) { %><li><%= item %></li><% }) %></ul>
          <% } %>
        </div>
      </div>
    </section>
  <% }) %>

  <script>
    document.getElementById('certImprimir').addEventListener('click', function () { window.print(); });
  </script>
</body>
</html>
