<%- include('head', { titulo: 'Matrículas' }) %>
<%- include('header', { ativo: 'inscricoes' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Matrículas</h1>
  <span class="adm-mut">
    <% if (filtrosAtivos) { %>
      Filtrado: <strong><%= totalFiltrado %></strong> de <%= totalGeral %>
    <% } else { %>
      Total: <strong><%= totalGeral %></strong>
    <% } %>
  </span>
</div>

<% if (flash) { %>
  <div class="adm-ok">
    <i class="fa-solid fa-circle-check"></i> <%= flash %>
  </div>
<% } %>

<form method="GET" action="/inscricoes" class="adm-filtros">

  <label class="adm-campo cresce">
    <span>Buscar aluno</span>
    <input
      type="text"
      name="q"
      value="<%= busca %>"
      placeholder="Nome, e-mail, CPF/CNPJ ou passaporte"
    >
  </label>

  <label class="adm-campo cresce">
    <span>Turma</span>

    <select name="turma">
      <option value="">Todas as turmas</option>

      <% turmas.forEach(function (t) { %>
        <option value="<%= t.id %>" <%= turmaId === t.id ? 'selected' : '' %>>
          <%= t.curso.nome %> —
          <%= new Date(t.inicioPrevisto).toLocaleDateString('pt-BR') %>
        </option>
      <% }) %>
    </select>
  </label>

  <label class="adm-campo">
    <span>Status</span>

    <select name="status">
      <option value="">Todos os status</option>

      <option value="PAGO,PARCELADO"
        <%= statusFiltro === 'PAGO,PARCELADO' ? 'selected' : '' %>>
        Pago
      </option>

      <option value="PENDENTE"
        <%= statusFiltro === 'PENDENTE' ? 'selected' : '' %>>
        Pendente
      </option>
    </select>
  </label>

  <button type="submit" class="adm-btn-neutro">
    <i class="fa-solid fa-filter"></i> Filtrar
  </button>

</form>

<%- include('legenda-status') %>

<div class="adm-box">

  <% if (!inscricoes.length) { %>

    <p class="adm-vazio">
      <% if (busca) { %>
        Nenhuma inscrição encontrada para essa busca.
      <% } else if (turmaId && statusFiltro) { %>
        Nenhuma inscrição nesta turma com este status.
      <% } else if (turmaId) { %>
        Nenhuma inscrição nesta turma.
      <% } else if (statusFiltro) { %>
        Nenhuma inscrição com este status.
      <% } else { %>
        Nenhuma inscrição encontrada.
      <% } %>
    </p>
  
  <% } else { %>

    <table class="adm-table adm-table-cards adm-table-fixa adm-table-insc">

      <colgroup>
        <col>
        <col>
        <col>
        <col>
        <col>
        <col>
        <col>
      </colgroup>

      <thead>
        <tr>
          <th>Aluno</th>
          <th>Curso / Turma</th>
          <th>Plano</th>
          <th>Valor</th>
          <th>Alimento</th>
          <th>Status</th>
          <th>Ações</th>
        </tr>
      </thead>

      <tbody>

        <% inscricoes.forEach(function (m) { %>

          <tr>

            <!-- ALUNO -->
            <td>
              <a href="/alunos/<%= m.aluno.id %>/matriculas" class="adm-link-aluno">
                <strong><%= m.aluno.nome %></strong>
              </a>
              <br>
              <small class="adm-mut"><%= m.aluno.email %></small>

              <% if (m.aluno._count.matriculas > 1) { %>
                <br>
                <a href="/alunos/<%= m.aluno.id %>/matriculas" class="adm-mut adm-link-badge">
                  <%= m.aluno._count.matriculas %> matrículas
                </a>
              <% } %>
            </td>

            <!-- CURSO / TURMA -->
            <td>
              <%= m.turma.curso.nome %>

              <br>

              <small class="adm-mut">
                <%= new Date(m.turma.inicioPrevisto).toLocaleDateString('pt-BR') %>

                <% if (m.turma.aulas && m.turma.aulas.length) { %>
                  · <%= m.turma.aulas[0].horario %>
                <% } %>
              </small>
            </td>

            <!-- PLANO -->
            <td>
              <%= m.plano === 'A_VISTA' ? 'À vista' : 'Parcelado' %>

              <br>

              <small class="adm-mut">
                <%= m.forma %>
              </small>
            </td>

            <!-- VALOR -->
            <td>
              <%= formatBRL(Number(m.valorCurso)) %>

              <% if (m.diferencaTransferencia != null) { %>

                <% if (Number(m.diferencaTransferencia) > 0) { %>

                  <small class="adm-dif adm-dif-receber">
                    Diferença a receber:
                    <%= formatBRL(Number(m.diferencaTransferencia)) %>
                  </small>

                <% } else if (Number(m.diferencaTransferencia) < 0) { %>

                  <small class="adm-dif adm-dif-reembolso">
                    Reembolso ao aluno:
                    <%= formatBRL(Math.abs(Number(m.diferencaTransferencia))) %>
                  </small>

                <% } %>

              <% } %>
            </td>

            <!-- ALIMENTO -->
            <td>

              <% if (pode('doacao:confirmar')) { %>

                <form method="POST" action="/inscricoes/<%= m.id %>/alimento">

                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                  <% if (busca) { %>
                    <input type="hidden" name="q" value="<%= busca %>">
                  <% } %>

                  <% if (turmaId) { %>
                    <input type="hidden" name="turma" value="<%= turmaId %>">
                  <% } %>

                  <% if (statusFiltro) { %>
                    <input type="hidden" name="status" value="<%= statusFiltro %>">
                  <% } %>

                  <button class="adm-chip <%= m.alimentoEntregue ? 'on' : '' %>">
                    <i class="fa-solid <%= m.alimentoEntregue ? 'fa-check' : 'fa-xmark' %>"></i>
                    1kg
                  </button>

                </form>

              <% } else { %>

                <span class="adm-chip estatico <%= m.alimentoEntregue ? 'on' : '' %>">
                  <i class="fa-solid <%= m.alimentoEntregue ? 'fa-check' : 'fa-xmark' %>"></i>
                  1kg
                </span>

              <% } %>

            </td>

            <!-- STATUS -->
            <td>

              <%- statusMatricula(m) %>

            </td>

            <!-- AÇÕES (as mesmas da página do aluno: acoes-matricula.ejs) -->
            <td class="adm-acoes">
              <%- include('acoes-matricula', { m }) %>
            </td>

          </tr>

        <% }) %>

      </tbody>

    </table>

  <% } %>

</div>

<%- include('foot') %>