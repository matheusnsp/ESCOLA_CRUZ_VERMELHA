<%- include('head', { titulo: 'Modelos' }) %>
<%- include('header', { ativo: 'turmas' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Boas-vindas e certificado</h1>
  <a href="<%= voltar %>" class="adm-link"><i class="fa-solid fa-arrow-left"></i> Voltar</a>
</div>

<% if (ok) { %><div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= ok %></div><% } %>

<form method="POST" action="/modelos?_csrf=<%= csrfToken %>" class="adm-form adm-box" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="voltar" value="<%= voltar %>">

  <h2 class="adm-form-secao full"><i class="fa-solid fa-envelope-open-text"></i> Mensagem de boas-vindas (padrão de todas as turmas)</h2>
  <label class="full">
    Texto
    <textarea name="texto" rows="18" class="adm-mono"><%= modelo.texto %></textarea>
    <small class="adm-hint">Preenchidos sozinhos: <code>{CURSO}</code> (maiúsculas), <code>{curso}</code>, <code>{data}</code> e <code>{hora}</code> (primeira aula), <code>{local}</code> e <code>{doacao}</code>.
      Use *asteriscos* para negrito, como no WhatsApp. Apague tudo e salve para voltar ao texto original.</small>
  </label>
  <label class="full">
    Doação solidária (padrão)
    <textarea name="doacao" rows="4"><%= modelo.doacao %></textarea>
    <small class="adm-hint">Entra no lugar de <code>{doacao}</code>. Cada turma pode trocar só este trecho, na tela de Boas-vindas da turma.</small>
  </label>
  <label class="full">
    Local
    <textarea name="local" rows="2"><%= modelo.local %></textarea>
  </label>

  <h2 class="adm-form-secao full"><i class="fa-solid fa-award"></i> Certificado</h2>
  <div class="full">
    <p class="adm-hint adm-assin-dica">Quem pode assinar os certificados (até 6). Em cada turma, na tela de Certificados, a secretaria marca quais aparecem (até 4, junto com o instrutor). Deixe o nome em branco para tirar alguém da lista.</p>
    <div class="adm-assin-lista">
      <% for (var i = 0; i < 6; i++) { var a = ajustes.assinantes[i] || {}; %>
        <div class="adm-assin-linha">
          <span class="adm-assin-num"><%= i + 1 %></span>
          <input type="text" name="assinantes[<%= i %>][nome]" maxlength="80" value="<%= a.nome || '' %>" placeholder="<%= i === 0 ? 'Ex.: AMANDA FERRARI PENZA' : i === 1 ? 'Ex.: nome do(a) Presidente' : 'Nome' %>" aria-label="Nome <%= i + 1 %>">
          <input type="text" name="assinantes[<%= i %>][cargo]" maxlength="80" value="<%= a.cargo || '' %>" placeholder="<%= i === 0 ? 'Coordenadora de Cursos Livres' : i === 1 ? 'Presidente' : i === 2 ? 'Coordenação do Voluntariado' : 'Cargo' %>" aria-label="Cargo <%= i + 1 %>">
          <span class="adm-assin-img">
            <% if (a.imagemUrl) { %><img src="<%= a.imagemUrl %>" alt="Assinatura de <%= a.nome %>"><label class="check"><input type="checkbox" name="assinantes[<%= i %>][removerImg]" value="1"> remover</label><% } %>
            <input type="file" name="assinaturaImg<%= i %>" accept="image/png,image/jpeg,image/webp" aria-label="Assinatura escaneada <%= i + 1 %>">
          </span>
        </div>
      <% } %>
    </div>
  </div>
  <fieldset class="full adm-assin-modo">
    <legend>Certificado online: assinatura</legend>
    <label class="check"><input type="radio" name="assinaturaOnline" value="com" <%= ajustes.assinaturaOnline !== 'sem' ? 'checked' : '' %>> <b>Com assinatura</b> — a linha para assinar e, em cima dela, a assinatura escaneada de quem tiver (o arquivo ao lado de cada nome)</label>
    <label class="check"><input type="radio" name="assinaturaOnline" value="sem" <%= ajustes.assinaturaOnline === 'sem' ? 'checked' : '' %>> <b>Sem assinatura</b> — só o nome e o cargo (a autenticidade fica no código de verificação e no QR)</label>
    <small class="adm-hint">O certificado online sai com as 3 primeiras pessoas da lista. Assinatura escaneada: PNG com fundo transparente (ou branco), até 2 MB; só envie com a autorização da pessoa. O certificado presencial não muda (é impresso e assinado à mão).</small>
  </fieldset>
  <label>Livro em uso
    <input type="number" name="livro" min="1" value="<%= ajustes.livro %>">
    <small class="adm-hint">Certificados novos recebem este livro e o próximo registro da sequência dele. Os já emitidos mantêm o número.</small>
  </label>

  <div class="full adm-form-rodape">
    <button type="submit" class="adm-btn"><i class="fa-solid fa-floppy-disk"></i> Salvar</button>
    <a href="<%= voltar %>" class="adm-link">Cancelar</a>
  </div>
</form>

<%- include('foot') %>
