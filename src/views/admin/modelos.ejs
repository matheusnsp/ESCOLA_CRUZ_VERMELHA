<%- include('head', { titulo: 'Modelos' }) %>
<%- include('header', { ativo: 'boas-vindas' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Mensagem de boas-vindas</h1>
  <% if (voltar) { %><a href="<%= voltar %>" class="adm-link"><i class="fa-solid fa-arrow-left"></i> Voltar à turma</a><% } %>
</div>

<% if (ok) { %><div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= ok %></div><% } %>

<%# Envio por turma (2026-11-13): tudo de boas-vindas num lugar só; o botão saiu da tela de Turmas. %>
<% var _envio = typeof turmasEnvio !== 'undefined' ? turmasEnvio : []; var _dia = function (d) { var x = new Date(d), p = function (n) { return String(n).padStart(2, '0'); }; return p(x.getUTCDate()) + '/' + p(x.getUTCMonth() + 1) + '/' + x.getUTCFullYear(); }; %>
<section class="adm-box adm-bv-envio-lista" id="envio-turmas">
  <div class="adm-box-head"><h2 class="adm-h2"><i class="fa-solid fa-paper-plane"></i> Envio por turma</h2></div>
  <% if (!_envio.length) { %>
    <p class="adm-mut adm-bv-cursos-dica">Nenhuma turma aberta ou confirmada em andamento.</p>
  <% } else { %>
  <table class="adm-table adm-table-cards">
    <thead><tr><th>Turma</th><th>Início</th><th>Envio</th><th></th></tr></thead>
    <tbody>
      <% _envio.forEach(function (t) { %>
        <tr>
          <td><b><%= t.curso %></b></td>
          <td><%= _dia(t.inicio) %></td>
          <td><span class="adm-bv-tag<%= t.recebem && t.receberam === t.recebem ? ' proprio' : '' %>"><%=
            !t.recebem ? 'Ninguém com pagamento ok ainda'
            : t.receberam === t.recebem ? 'Todos os ' + t.recebem + ' receberam'
            : !t.liberadaEm && !t.receberam ? 'Ainda não liberado · ' + t.recebem + ' com pagamento ok'
            : t.receberam + ' de ' + t.recebem + ' receberam' %></span></td>
          <td class="adm-bv-acoes"><a href="/turmas/<%= t.id %>/boas-vindas" class="adm-link">Abrir envio</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</section>

<form method="POST" action="/modelos" class="adm-form adm-box">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (voltar) { %><input type="hidden" name="voltar" value="<%= voltar %>"><% } %>

  <h2 class="adm-form-secao full"><i class="fa-solid fa-envelope-open-text"></i> Mensagem de boas-vindas (padrão de todas as turmas)</h2>
  <label class="full">
    Texto
    <textarea name="texto" rows="18" class="adm-mono"><%= modelo.texto %></textarea>
    <small class="adm-hint">Preenchidos sozinhos: <code>{CURSO}</code> (maiúsculas), <code>{curso}</code>, <code>{data}</code> e <code>{hora}</code> (primeira aula), <code>{local}</code> e <code>{doacao}</code>.
      Use *asteriscos* para negrito, como no WhatsApp. Apague tudo e salve para voltar ao texto original.</small>
  </label>
  <label class="full">
    Doação solidária (padrão)
    <textarea name="doacao" rows="4"><%= modelo.doacao %></textarea>
    <small class="adm-hint">Entra no lugar de <code>{doacao}</code>. Cada turma pode trocar só este trecho, na tela de Boas-vindas da turma.</small>
  </label>
  <label class="full">
    Local
    <textarea name="local" rows="2"><%= modelo.local %></textarea>
  </label>


  <div class="full adm-form-rodape">
    <button type="submit" class="adm-btn"><i class="fa-solid fa-floppy-disk"></i> Salvar</button>
    <% if (voltar) { %><a href="<%= voltar %>" class="adm-link">Cancelar</a><% } %>
  </div>
</form>

<%# Texto por curso (2026-11-13): um texto só de um curso; os outros usam o padrão acima. %>
<section class="adm-box adm-bv-cursos" id="texto-curso">
  <div class="adm-box-head"><h2 class="adm-h2"><i class="fa-solid fa-book"></i> Texto por curso</h2></div>
  <% if (cursoEditando) { var _txt = textosCursos[cursoEditando.id] || modelo.texto; %>
    <form method="POST" action="/modelos/curso" class="adm-form adm-bv-curso-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="cursoId" value="<%= cursoEditando.id %>">
      <label class="full">
        Texto de <b><%= cursoEditando.nome %></b>
        <textarea name="texto" rows="18" class="adm-mono"><%= _txt %></textarea>
        <small class="adm-hint">Mesmos campos do padrão: <code>{CURSO}</code>, <code>{curso}</code>, <code>{data}</code>, <code>{hora}</code>, <code>{local}</code> e <code>{doacao}</code>.
          A doação de cada turma continua valendo. Apague tudo e salve para o curso voltar ao texto padrão.</small>
      </label>
      <div class="full adm-form-rodape">
        <button type="submit" class="adm-btn"><i class="fa-solid fa-floppy-disk"></i> Salvar texto do curso</button>
        <a href="/modelos#texto-curso" class="adm-link">Cancelar</a>
      </div>
    </form>
  <% } else { %>
    <p class="adm-hint adm-bv-cursos-dica">Um texto só para um curso. Os cursos sem texto próprio usam o padrão acima. A doação de cada turma continua valendo.</p>
    <% if (!cursos.length) { %>
      <p class="adm-mut adm-bv-cursos-dica">Nenhum curso presencial ativo.</p>
    <% } else { %>
    <table class="adm-table adm-table-cards">
      <thead><tr><th>Curso</th><th>Texto</th><th></th></tr></thead>
      <tbody>
        <% cursos.forEach(function (c) { var _tem = !!textosCursos[c.id]; %>
          <tr>
            <td><b><%= c.nome %></b></td>
            <td><span class="adm-bv-tag<%= _tem ? ' proprio' : '' %>"><%= _tem ? 'Texto próprio' : 'Padrão' %></span></td>
            <td class="adm-bv-acoes">
              <% if (_tem) { %>
                <a href="/modelos?curso=<%= c.id %>#texto-curso" class="adm-link">Editar</a>
                <form method="POST" action="/modelos/curso" data-confirmar="<%= c.nome %> volta a usar o texto padrão. O texto próprio dele será apagado." data-botao="Voltar ao padrão">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="cursoId" value="<%= c.id %>">
                  <input type="hidden" name="texto" value="">
                  <button type="submit" class="adm-link">Voltar ao padrão</button>
                </form>
              <% } else { %>
                <a href="/modelos?curso=<%= c.id %>#texto-curso" class="adm-link">Escrever texto do curso</a>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  <% } %>
</section>

<%- include('foot') %>
