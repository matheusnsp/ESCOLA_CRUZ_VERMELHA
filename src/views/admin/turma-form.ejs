<%- include('head', { titulo: 'Turma' }) %>
<%- include('header', { ativo: (turma && turma.id) ? 'turmas' : 'turma-nova' }) %>
<%
var t = turma || {};
var novo = !t.id;

// Converte a data do banco para o formato que o <input type="date"> entende
// (AAAA-MM-DD).
//
// 💡 CORRIGIDO — usa os getters UTC, não os locais.
//
// AulaData.data é uma coluna DATE, sem hora nenhuma. O Prisma a devolve como
// meia-noite UTC, e getDate() responde "que dia era, no fuso do SERVIDOR,
// naquele instante". Em servidor UTC (o Render) coincide e dá certo — foi por
// isso que o formulário sempre pareceu correto em produção. Mas rodando
// local, com o Mac em Brasília, meia-noite UTC ainda é 21h do dia anterior:
// uma aula do dia 24 aparecia como 23.
//
// O perigo não era só visual. A secretaria abriria a turma pra mudar
// qualquer coisa, o campo já viria com o dia errado, ela salvaria sem notar,
// e a data errada iria pro banco — cada edição empurrando a aula um dia
// pra trás.
//
// Data pura não é um instante: "24 de setembro" é 24 de setembro em qualquer
// fuso. Ler em UTC devolve exatamente o número que foi gravado, em qualquer
// máquina. E o inicioPrevisto (timestamp ao meio-dia) continua correto aqui
// também — meio-dia UTC é o mesmo dia em qualquer leitura.
function formatarDataInput(data) {
  if (!data) return '';
  const d = new Date(data);
  const ano = d.getUTCFullYear();
  const mes = String(d.getUTCMonth() + 1).padStart(2, '0');
  const dia = String(d.getUTCDate()).padStart(2, '0');
  return `${ano}-${mes}-${dia}`;
}
%>

<div class="adm-h1-row">
  <h1 class="adm-h1"><%= novo ? 'Nova turma' : 'Editar turma' %></h1>
  <a href="<%= novo ? '/turmas' : '/turmas/' + t.id %>" class="adm-link">← <%= novo ? 'Voltar' : 'Voltar à turma' %></a>
</div>

<% if (erro) { %>
<div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
<% } %>

<% if (novo) { %>
<div class="ia-textos adm-comecar-ia" data-comecar-url="/turmas/ia-comecar" data-comecar-form="turmaForm">
  <div class="ia-textos-cab"><i class="fa-solid fa-wand-magic-sparkles"></i>
    <div><b>Começar com a IA</b> <small class="adm-hint">Escreva a turma do seu jeito: curso, dias, horário, vagas, instrutor. A IA preenche e você confere antes de criar.</small></div></div>
  <textarea class="adm-comecar-texto" rows="3" maxlength="3000" aria-label="Como é a turma" placeholder="Ex.: Socorrista, toda terça e quinta de dezembro a partir do dia 1, das 18h às 22h, 30 vagas, mínimo 15, instrutora Carla Dias COREN-RJ 445566"></textarea>
  <button type="button" class="adm-btn adm-comecar-bt"><i class="fa-solid fa-wand-magic-sparkles"></i> Preencher com IA</button>
  <p class="ia-textos-msg" role="status" hidden></p>
</div>
<p class="adm-ou">ou preencha você mesmo</p>
<% } %>

<form method="POST" action="<%= novo ? '/turmas' : '/turmas/' + t.id %>" class="adm-form adm-box" id="turmaForm">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">

<h2 class="adm-form-secao full"><i class="fa-solid fa-clock"></i> Quando</h2>
<label class="full">
Curso
<select name="cursoId" required>
<option value="">— selecione —</option>
<% cursos.forEach(function(cur){ %>
<option value="<%= cur.id %>" <%= (t.cursoId||'')===cur.id ? 'selected' : '' %>><%= cur.nome %></option>
<% }) %>
</select>
</label>

<label>
Início previsto
<input type="date" name="inicioPrevisto" value="<%= formatarDataInput(t.inicioPrevisto) %>" required>
</label>

<div class="full adm-gerar-aulas" data-gerar-aulas>
  <b><i class="fa-solid fa-repeat"></i> Gerar aulas</b>
  <small class="adm-hint">Marque os dias da semana, o horário e até quando: as datas são criadas a partir do início.</small>
  <div class="adm-gerar-linha">
    <fieldset class="adm-dias"><legend>Dias da semana</legend>
      <% [['D','Domingo',0],['S','Segunda',1],['T','Terça',2],['Q','Quarta',3],['Q','Quinta',4],['S','Sexta',5],['S','Sábado',6]].forEach(function (d) { %>
        <label title="<%= d[1] %>"><input type="checkbox" value="<%= d[2] %>" aria-label="<%= d[1] %>"><span><%= d[0] %></span></label>
      <% }) %>
    </fieldset>
    <label>Horário<input type="text" class="gerar-aulas-horario" placeholder="18:00 – 22:00"></label>
    <label>Até<input type="date" class="gerar-aulas-ate"></label>
    <button type="button" class="adm-btn-neutro gerar-aulas-bt"><i class="fa-solid fa-repeat"></i> Gerar aulas</button>
  </div>
  <p class="ia-textos-msg gerar-aulas-msg" role="status" hidden></p>
</div>

<div class="full">
<p class="adm-hint adm-aulas-dica">Uma linha por dia de aula, com o horário. As datas aparecem para o aluno na página do curso. Ao adicionar, o horário da última linha é repetido.</p>

<div id="aulas-lista">
<% (aulas || []).forEach(function(a, i){ %>
<div class="aula-linha" data-idx="<%= i %>">
<input type="date" name="aulas[<%= i %>][data]" value="<%= formatarDataInput(a.data) %>">
<input type="text" name="aulas[<%= i %>][horario]" value="<%= a.horario || '' %>" placeholder="18:00 – 22:00">
<button type="button" class="adm-mini danger btn-remover-aula"><i class="fa-solid fa-trash"></i></button>
</div>
<% }) %>
</div>

<button type="button" id="btnAdicionarAula" class="adm-btn-sec espaco-cima">
<i class="fa-solid fa-plus"></i> Adicionar aula
</button>
</div>


<h2 class="adm-form-secao full"><i class="fa-solid fa-users"></i> Vagas</h2>
<label>Vagas<input type="number" name="vagas" min="1" value="<%= t.vagas || 30 %>" required></label>

<label>Mínimo de alunos<input type="number" name="minimoAlunos" min="0" value="<%= t.minimoAlunos != null ? t.minimoAlunos : 15 %>" required></label>

<h2 class="adm-form-secao full"><i class="fa-solid fa-flag"></i> Situação</h2>
<label class="full">Situação
<select name="status">
<% statusTurma.forEach(function(s){ %>
<option value="<%= s %>" <%= (t.status||'ABERTA')===s ? 'selected' : '' %>><%= rotuloTurma(s) %></option>
<% }) %>
</select>
<small class="adm-hint">Aberta: aceita inscrições; vira Confirmada sozinha à 00:00 do dia de início. Confirmada: vai acontecer e não aceita mais inscrição pelo site. Concluída só a partir do dia seguinte à última aula — o sistema conclui sozinho a turma confirmada; se escolher Concluída antes, ela fica Confirmada até lá. Congelada: pausa a turma; ela some do site, não recebe lembretes, boas-vindas nem pesquisa, sai do A receber e não é concluída sozinha. Os alunos continuam matriculados. Para retomar, volte para Aberta ou Confirmada; se as datas já passaram, ajuste as aulas antes (senão ela é concluída ou fechada sozinha).</small>
</label>

<h2 class="adm-form-secao full" id="certificado"><i class="fa-solid fa-user-doctor"></i> Instrutor (vai no certificado)</h2>
<label>Nome do instrutor<input type="text" name="instrutorNome" maxlength="80" value="<%= t.instrutorNome || '' %>" placeholder="Ex.: Maria da Silva"></label>
<label>Registro profissional<input type="text" name="instrutorRegistro" maxlength="60" value="<%= t.instrutorRegistro || '' %>" placeholder="Ex.: COREN 477198-RJ"></label>


<%- include('_rodape-salvar', { botao: novo ? 'Criar turma' : 'Salvar alterações' }) %>
</form>

<script src="<%= asset('/js/gerar-aulas.js') %>"></script>
<% if (novo) { %><script src="<%= asset('/js/ia-comecar.js') %>"></script><% } %>

<%- include('foot') %>