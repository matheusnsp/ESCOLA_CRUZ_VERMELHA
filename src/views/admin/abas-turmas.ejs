<%
// Abas (filtros de status) da tela de Turmas. 2026-11-13: Matrícula rápida e Mapa de horários saíram daqui (têm item próprio no menu). Uso: include('abas-turmas', { aba, abas }) — abas (as listas por
// status) só na tela de Turmas, para mostrar as contagens.
const _ROT = [
  { id: 'por-comecar', rot: 'Por começar' },
  { id: 'andamento',   rot: 'Em andamento' },
  { id: 'congeladas',  rot: 'Congeladas' },
  { id: 'concluidas',  rot: 'Concluídas' },
  { id: 'canceladas',  rot: 'Canceladas' },
];
const _contas = typeof abas !== 'undefined' && abas ? abas : null;
%>
<nav class="adm-abas" aria-label="Turmas">
  <% _ROT.forEach(function (a) { %>
    <a href="/turmas?aba=<%= a.id %>" class="adm-aba <%= aba === a.id ? 'on' : '' %>">
      <%= a.rot %><% if (_contas) { %> <span class="adm-aba-num"><%= _contas[a.id].length %></span><% } %>
    </a>
  <% }) %>
</nav>
