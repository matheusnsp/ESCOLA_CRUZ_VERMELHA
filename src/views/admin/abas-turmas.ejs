<%
// Abas da seção Turmas (a tela de Turmas e a Matrícula rápida, que inclui o mapa de horários). Uso: include('abas-turmas', { aba, abas }) — abas (as listas por
// status) só na tela de Turmas, para mostrar as contagens.
const _ROT = [
  { id: 'por-comecar', rot: 'Por começar' },
  { id: 'andamento',   rot: 'Em andamento' },
  { id: 'concluidas',  rot: 'Concluídas' },
  { id: 'canceladas',  rot: 'Canceladas' },
];
const _contas = typeof abas !== 'undefined' && abas ? abas : null;
%>
<nav class="adm-abas" aria-label="Turmas">
  <% _ROT.forEach(function (a) { %>
    <a href="/turmas?aba=<%= a.id %>" class="adm-aba <%= aba === a.id ? 'on' : '' %>">
      <%= a.rot %><% if (_contas) { %> <span class="adm-aba-num"><%= _contas[a.id].length %></span><% } %>
    </a>
  <% }) %>
  <% if (pode('turmas:gerenciar') || pode('painel:leitura')) { %>
    <%# Matrícula rápida (site da instituição) junta quem se inscreveu lá, o pagamento e o mapa de horários. %>
    <a href="/matricula-rapida" class="adm-aba adm-aba-sep <%= aba === 'horarios' || aba === 'matricula-rapida' ? 'on' : '' %>"><i class="fa-solid fa-bolt"></i> Matrícula rápida</a>
  <% } %>
</nav>
