<%- include('head', { titulo: 'Integração' }) %>
<%- include('header', { ativo: 'integracao' }) %>

<%
// Integração (lib/planilha-ao-vivo.js + routes/integracao.js): o Excel busca os dados por um link
// do site com chave secreta e se atualiza sozinho. A chave só aparece logo depois de gerada.
var NOME_TABELA = { matriculas: 'Matrículas', alunos: 'Alunos', cursos: 'Cursos', turmas: 'Turmas' };
var DICA_TABELA = {
  matriculas: 'uma linha por matrícula: aluno, documento, contato, curso, turma, plano, status, valor, o que falta pagar, alimento e nota',
  alunos: 'uma linha por aluno: documento, contato, se tem inscrição, se o e-mail e o celular parecem válidos, cidade e escolaridade',
  cursos: 'cursos com carga horária, preços, próxima turma, turmas abertas e quantos alunos têm vaga',
  turmas: 'uma linha por turma: início, datas e horários das aulas, status, vagas e quantos alunos em cada situação',
};
%>

<div class="adm-h1-row">
  <h1 class="adm-h1">Integração</h1>
</div>

<% if (flash) { %><div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= flash %></div><% } %>

<div class="adm-box adm-box-pad pl-box">
  <h2 class="adm-form-secao"><i class="fa-solid fa-file-excel"></i> Planilha do Excel ao vivo</h2>
  <p>Liga uma planilha do Excel direto ao banco de dados da escola. Os alunos, as matrículas e os cursos entram sozinhos
    e se atualizam quando você abre o arquivo e a cada 30 minutos, sem precisar baixar nada de novo.</p>
  <p class="adm-hint">A planilha traz só o que a Secretaria já vê nas telas do painel. Valores recebidos e totais do Financeiro não entram.</p>

  <% if (chave) { %>
    <div class="adm-ok"><i class="fa-solid fa-key"></i> Sua planilha está pronta. Baixe agora: por segurança, este botão e os links
      não aparecem de novo. Se perder, gere de novo (só a sua anterior para de funcionar).</div>
    <form method="POST" action="/integracao/planilha.xlsx" class="pl-baixar">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="chave" value="<%= chave %>">
      <button type="submit" class="adm-btn"><i class="fa-solid fa-file-excel"></i> Baixar a planilha pronta</button>
      <small class="adm-hint">Já vem ligada ao sistema, com as abas Turma, Aluno e Contatos. É só abrir.</small>
    </form>
    <details class="pl-avancado">
      <summary>Links para montar a planilha à mão (avançado)</summary>
      <% tabelas.forEach(function (t) { %>
        <label class="pl-link">
          <b><%= NOME_TABELA[t] %></b> <small class="adm-hint">— <%= DICA_TABELA[t] %></small>
          <input type="text" readonly value="<%= base %>/<%= t %>.csv?chave=<%= chave %>">
        </label>
      <% }) %>
    </details>
    <p class="adm-hint"><i class="fa-solid fa-triangle-exclamation"></i> Quem tiver a planilha ou os links vê os dados dos alunos (nome, documento, e-mail, celular).
      Não mande por e-mail nem WhatsApp.</p>
  <% } else if (ligada) { %>
    <p><i class="fa-solid fa-circle-check" style="color:#16a34a"></i> <b>Sua planilha está ligada.</b> Ela continua atualizando. Se perdeu o arquivo,
      clique em <b>Gerar minha planilha de novo</b>: só a sua anterior para de funcionar.</p>
  <% } else { %>
    <p><i class="fa-solid fa-circle-xmark"></i> Você ainda não tem planilha. Clique em <b>Gerar minha planilha</b> para começar.</p>
  <% } %>
  <p class="adm-hint">Cada conta do painel tem a sua planilha. O que você gera ou desliga aqui vale só para a sua; as das outras pessoas continuam atualizando.</p>

  <div class="pl-acoes">
    <form method="POST" action="/integracao/gerar"
      <% if (ligada) { %>data-confirmar="Gerar de novo desliga a sua planilha atual: ela para de atualizar até você baixar a nova. As das outras contas continuam." data-botao="Gerar de novo"<% } %>>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="adm-btn"><i class="fa-solid fa-link"></i> <%= ligada ? 'Gerar minha planilha de novo' : 'Gerar minha planilha' %></button>
    </form>
    <% if (ligada) { %>
      <form method="POST" action="/integracao/desligar" data-confirmar="Desligar a sua planilha? Ela para de atualizar. As das outras contas continuam." data-botao="Desligar">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="adm-btn-sec"><i class="fa-solid fa-power-off"></i> Desligar a minha</button>
      </form>
    <% } %>
  </div>
</div>

<% if (lista.length) { %>
<div class="adm-box adm-box-pad pl-box">
  <h2 class="adm-form-secao"><i class="fa-solid fa-users"></i> Planilhas ligadas</h2>
  <table class="adm-table pl-lista">
    <thead><tr><th>Conta</th><th>Gerada em</th><th></th></tr></thead>
    <tbody>
      <% lista.forEach(function (c) { %>
        <tr>
          <td><%= c.nome %><% if (c.minha) { %> <span class="adm-mut">(você)</span><% } %></td>
          <td><%= c.em ? new Date(c.em).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', dateStyle: 'short', timeStyle: 'short' }) : 'antes das planilhas por conta' %></td>
          <td>
            <% if (!c.minha && podeDesligarOutras) { %>
              <form method="POST" action="/integracao/desligar/<%= c.usuarioId %>" data-confirmar="Desligar a planilha de <%= c.nome %>? Ela para de atualizar." data-botao="Desligar">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="adm-btn-sec adm-btn-sm"><i class="fa-solid fa-power-off"></i> Desligar</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <p class="adm-hint">O "link compartilhado (antigo)" é o de antes de existir planilha por conta. Quem baixou com ele continua atualizando; a coordenação pode desligá-lo quando todo mundo já tiver a sua.</p>
</div>
<% } %>

<div class="adm-box adm-box-pad pl-box">
  <h2 class="adm-form-secao"><i class="fa-solid fa-list-ol"></i> Como usar (uma vez só)</h2>
  <ol class="pl-passos">
    <li>Clique em <b>Gerar minha planilha</b> aqui em cima e depois em <b>Baixar a planilha pronta</b>.</li>
    <li>Abra o arquivo no <b>Excel do computador</b>. Se aparecer uma faixa amarela, clique em <b>Habilitar edição</b> e depois em <b>Habilitar conteúdo</b>.</li>
    <li>Se o Excel perguntar como acessar o endereço do site, escolha <b>Anônimo</b> e clique em <b>Conectar</b>. Isso acontece só na primeira vez.</li>
    <li>Pronto. Os dados chegam sozinhos ao abrir e a cada 30 minutos. Para atualizar na hora: <b>Dados → Atualizar tudo</b>.</li>
    <li>Salve o arquivo onde quiser (computador, OneDrive, pen drive). Ele continua ligado ao sistema.</li>
  </ol>
  <h3 class="pl-sub">O que tem na planilha</h3>
  <ul class="pl-passos">
    <li><b>Turma:</b> escolha a turma (curso e data) na célula amarela e aparecem os alunos dela, com a situação do pagamento colorida
      (pago, parcelado, falta pagar o curso, aguardando taxa), o que falta pagar e botões de <b>WhatsApp</b> e <b>e-mail</b>. Em cima, o resumo:
      com vaga, pagaram tudo, falta pagar, aguardando taxa.</li>
    <li><b>Aluno:</b> escolha o aluno na célula amarela e aparece a ficha dele: documento, contato, se o e-mail e o celular parecem válidos,
      cidade, escolaridade e todas as matrículas.</li>
    <li><b>Contatos:</b> todos os alunos cadastrados, com ou sem inscrição, com WhatsApp Web, e-mail e a verificação do contato.</li>
    <li><b>Alunos, Matrículas, Cursos e Turmas:</b> as tabelas completas que vêm do sistema, com os filtros do Excel no cabeçalho. Só as colunas
      mais usadas ficam à vista; clique no <b>+</b> acima da tabela para ver todas.</li>
  </ul>
  <p class="adm-hint"><b>Verificação de contato:</b> o e-mail é conferido pelo formato e se o domínio (gmail.com, hotmail.com…) existe e recebe
    e-mail. O celular, pelo DDD e pelos 9 dígitos. Não dá para saber se a caixa de e-mail existe nem se o número tem WhatsApp: o WhatsApp
    não oferece essa consulta.</p>
</div>

<div class="adm-box adm-box-pad pl-box">
  <h2 class="adm-form-secao"><i class="fa-solid fa-circle-question"></i> Dúvidas comuns</h2>
  <ul class="pl-passos">
    <li><b>Quero atualizar agora:</b> no Excel, clique em <b>Dados → Atualizar tudo</b>.</li>
    <li><b>Posso fazer filtros, fórmulas e gráficos?</b> Sim. Use filtros na própria tabela ou crie outras abas com fórmulas e
      gráficos apontando para ela; tudo continua funcionando depois de cada atualização. Só não digite nada dentro das tabelas que
      vêm do sistema, porque a atualização sobrescreve.</li>
    <li><b>Funciona em qualquer computador?</b> Sim, o link é o endereço do site da escola, não precisa estar no painel nem na rede da
      escola. Precisa do Excel para Windows ou Mac (Microsoft 365, 2016 ou mais novo). No Excel pela internet a atualização
      automática não funciona.</li>
    <li><b>Perdi a planilha ou alguém de fora pegou:</b> clique em <b>Gerar minha planilha de novo</b> e baixe outra. Só a sua anterior para de
      atualizar; as das outras contas continuam.</li>
    <li><b>O Excel deu erro ao atualizar:</b> a sua planilha foi desligada ou gerada de novo. Gere e baixe outra. Se tinha fórmulas e
      gráficos seus na antiga, copie as abas para a nova.</li>
    <li><b>Quero montar a planilha do meu jeito:</b> use os links em "avançado", em <b>Dados → Da Web</b>, uma consulta por link.</li>
  </ul>
</div>

<%- include('foot') %>
