<%- include('head', { titulo: 'Pendentes' }) %>
<%- include('header', { ativo: 'pendentes' }) %>

<%
  // ═══════════════════════════════════════════════════════════════════════
  // PAGAMENTOS PENDENTES — três abas
  //
  // A organização em três vem de um aprendizado da secretaria: ela testou
  // uma lista larga de contatos e 4 de 5 pessoas já tinham conversado com
  // ela. O problema não era o texto, era o recorte — a lista misturava quem
  // valia abordar com quem não valia.
  //
  //   1. Inscrição paga, matrícula pendente  → dinheiro em jogo
  //   2. Nada pago, dá tempo        → recuperável
  //   3. Fora de prazo              → turma encerrada ou já começou
  //
  // A aba 3 é nova. Antes essas linhas simplesmente não apareciam (o filtro
  // de status as excluía), o que escondia gente que ficou pelo caminho.
  //
  // Todas as classes são adm-* já existentes — sem CSS novo além do bloco
  // no fim deste arquivo.
  // ═══════════════════════════════════════════════════════════════════════

  function diasDesde(data) {
    if (!data) return null;
    return Math.floor((Date.now() - new Date(data).getTime()) / 86400000);
  }

  function diasAte(data) {
    if (!data) return null;
    return Math.ceil((new Date(data).getTime() - Date.now()) / 86400000);
  }

  // Data pura em UTC: Turma.inicioPrevisto e AulaData.data não devem sofrer
  // conversão de fuso. Foi o bug que mandou 23/09 no lugar de 24/09 por
  // e-mail — meia-noite UTC virava 21h do dia anterior em Brasília.
  function dataBR(d) {
    if (!d) return '—';
    const dt = new Date(d);
    const p = (n) => String(n).padStart(2, '0');
    return `${p(dt.getUTCDate())}/${p(dt.getUTCMonth() + 1)}/${dt.getUTCFullYear()}`;
  }

  function dataHoraBR(d) {
    return d ? new Date(d).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : null;
  }

  function telBR(c) {
    const d = String(c || '').replace(/\D/g, '');
    if (d.length === 11) return `(${d.slice(0,2)}) ${d.slice(2,7)}-${d.slice(7)}`;
    if (d.length === 10) return `(${d.slice(0,2)}) ${d.slice(2,6)}-${d.slice(6)}`;
    return c || null;
  }

  // Celular brasileiro hoje tem 11 dígitos com 9 na terceira posição.
  // Marcamos quem foge disso: há cadastros com fixo antigo ou digitação
  // errada, e o link do WhatsApp sairia quebrado sem aviso.
  function celularSuspeito(c) {
    const d = String(c || '').replace(/\D/g, '');
    return !(d.length === 11 && d[2] === '9');
  }

  const rotuloContato = {
    CONTATO_WHATSAPP: 'WhatsApp',
    CONTATO_PROSPECCAO: 'WhatsApp',
    ENVIOU_LEMBRETE_PAGAMENTO: 'e-mail',
  };

  const abas = [
    { id: 'com-taxa',   rot: 'Inscrição paga, matrícula pendente', lista: comTaxa },
    { id: 'sem-taxa',   rot: 'Nada pago, ainda dá tempo', lista: semTaxa },
    { id: 'fora-prazo', rot: 'Fora de prazo',             lista: foraDePrazo },
  ];
%>

<div class="adm-h1-row">
  <h1 class="adm-h1">Pendentes</h1>
  <span class="adm-mut">
    Em aberto: <strong><%= formatBRL(totalEmAberto) %></strong>
  </span>
</div>

<% if (flash) { %>
  <div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= flash %></div>
<% } %>

<% if (erro) { %>
  <div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
<% } %>

<!-- ══ Abas ═══════════════════════════════════════════════════════════════ -->
<div class="adm-abas">
  <% abas.forEach(function (a) { %>
    <a href="/pendentes?aba=<%= a.id %>" class="adm-aba <%= aba === a.id ? 'on' : '' %>">
      <%= a.rot %> <span class="adm-aba-num"><%= a.lista.length %></span>
    </a>
  <% }) %>
</div>

<%
  // Uma frase por aba, dizendo quem está ali e como abordar.
  const intro = {
    'com-taxa':   'Pagaram a inscrição, a vaga está reservada e falta pagar a matrícula. É onde tem dinheiro parado.',
    'sem-taxa':   'Escolheram o curso e pararam antes de pagar. A vaga não está reservada e a turma ainda não começou.',
    'fora-prazo': 'A turma já começou ou foi encerrada. Não mande o texto de retomar a inscrição: chame para uma turma nova do mesmo curso.',
  };
  const atual = abas.find(a => a.id === aba);
%>

<%
// Ações: só aparecem as que dá para usar (antes ficavam ícones apagados na linha).
// WhatsApp é POST: o servidor registra o contato e mostra a página com o link.
function acoesHtml(m) { %>
  <td class="adm-acoes">
    <div class="adm-pend-acoes">
      <% if (m.linkWhats) { %>
        <form method="POST" action="/pendentes/<%= m.id %>/whatsapp" target="_blank">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="voltar" value="/pendentes?aba=<%= aba %>">
          <button class="adm-pend-btn whats" title="Abrir o WhatsApp e registrar o contato">
            <i class="fa-brands fa-whatsapp"></i> WhatsApp
          </button>
        </form>
      <% } %>

      <% if (pode('pendentes:gerenciar') && m.pendencia.podeEmail) { %>
        <form method="POST" action="/pendentes/<%= m.id %>/lembrar"
              data-confirmar="Enviar o lembrete de pagamento por e-mail para <%= m.aluno.nome %>?" data-botao="Enviar e-mail">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="adm-pend-btn" title="Enviar lembrete por e-mail">
            <i class="fa-solid fa-envelope"></i> E-mail
          </button>
        </form>
      <% } %>

      <%
        // Remover só onde nada foi pago. Onde houve cobrança no gateway a própria rota recusa:
        // pode haver pagamento cuja confirmação não chegou, e apagar seria apagar dinheiro.
      %>
      <% if (!m.taxaConfirmada && pode('pendentes:gerenciar')) { %>
        <form method="POST" action="/pendentes/<%= m.id %>/remover"
              data-confirmar="Remover a inscrição de <%= m.aluno.nome %> em <%= m.turma.curso.nome %>?&#10;&#10;A vaga é liberada e o registro apagado. Não dá para desfazer."
              data-motivo="Motivo da remoção" data-botao="Remover">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="adm-pend-btn perigo" title="Remover a inscrição e liberar a vaga">
            <i class="fa-solid fa-trash"></i> Remover
          </button>
        </form>
      <% } %>

      <% if (!m.linkWhats) { %>
        <small class="adm-txt-alerta" title="Celular não cadastrado ou inválido">sem WhatsApp</small>
      <% } %>
    </div>
  </td>
<% } %>

<%
function alunoHtml(m) { %>
  <td>
    <a href="/alunos/<%= m.aluno.id %>/matriculas"><strong><%= m.aluno.nome %></strong></a>
    <br><small class="adm-mut"><%= m.aluno.email %></small>
    <% if (telBR(m.aluno.celular)) { %>
      <br>
      <small class="<%= celularSuspeito(m.aluno.celular) ? 'adm-txt-alerta' : 'adm-mut' %>">
        <i class="fa-solid fa-phone"></i> <%= telBR(m.aluno.celular) %>
        <%= celularSuspeito(m.aluno.celular) ? '· confira' : '' %>
      </small>
    <% } %>
  </td>
<% } %>

<%
function cursoHtml(m) {
  const faltam = diasAte(m.turma.inicioPrevisto); %>
  <td>
    <%= m.turma.curso.nome %>
    <br><small class="adm-mut">
      <% if (aba === 'fora-prazo') { %>
        turma <%= rotuloTurma(m.turma.status).toLowerCase() %> · <%= dataBR(m.turma.inicioPrevisto) %>
      <% } else { %>
        início <%= dataBR(m.turma.inicioPrevisto) %><% if (faltam !== null && faltam >= 0) { %> · faltam <%= faltam %>d<% } %>
      <% } %>
    </small>
  </td>
<% } %>

<%
// Situação: o que já foi pago e há quanto tempo está parado, numa coluna só.
function situacaoHtml(m) {
  const desde = m.taxaConfirmada ? (m.taxaConfirmadaEm || m.criadoEm) : m.criadoEm;
  const parado = diasDesde(desde);
  const plano = m.plano === 'A_VISTA' ? 'à vista' : m.plano === 'PRESENCIAL' ? 'presencial' : 'parcelado'; %>
  <td>
    <% if (m.taxaConfirmada) { %>
      <span class="badge ok">Inscrição paga</span>
    <% } else { %>
      <span class="badge mut">Nada pago</span>
    <% } %>
    <br><small class="adm-mut">parado <%= parado === 0 ? 'desde hoje' : 'há ' + parado + 'd' %> · <%= plano %></small>
    <% if (m.tentouPagar) { %>
      <br><small class="adm-txt-alerta" title="Chegou a gerar cobrança no gateway: pode haver pagamento cuja confirmação não chegou. Confira na Únicopag antes de abordar como quem não pagou.">
        <i class="fa-solid fa-triangle-exclamation"></i> gerou cobrança
      </small>
    <% } %>
  </td>
<% } %>

<%
function contatoHtml(m) { %>
  <td>
    <% if (m.contato) { %>
      <small><%= dataHoraBR(m.contato.quando) %></small>
      <br><small class="adm-mut">por <%= rotuloContato[m.contato.como] || m.contato.como %></small>
    <% } else { %>
      <small class="adm-mut">nunca</small>
    <% } %>
  </td>
<% } %>

<div class="adm-box">
  <p class="adm-box-intro"><i class="fa-solid fa-circle-info"></i> <%= intro[aba] %></p>

  <% if (!atual.lista.length) { %>
    <p class="adm-vazio">
      <%= aba === 'com-taxa' ? 'Ninguém com inscrição paga e matrícula pendente. Tudo em dia.'
        : aba === 'sem-taxa' ? 'Nenhuma inscrição parada com turma em aberto.'
        : 'Nenhuma pendência fora de prazo.' %>
    </p>
  <% } else { %>
    <table class="adm-table adm-table-cards">
      <thead>
        <tr>
          <th>Aluno</th><th>Curso</th><th>Situação</th>
          <th>Valor</th><th>Último contato</th><th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% atual.lista.forEach(function (m) { %>
        <tr<%- aba === 'fora-prazo' ? ' class="adm-tr-fraca"' : '' %>>
          <%- alunoHtml(m) %>
          <%- cursoHtml(m) %>
          <%- situacaoHtml(m) %>
          <% var _falta = valorEmAberto(m), _taxaPaga = m.taxaConfirmada && m.diferencaTransferencia == null ? Number(m.valorTaxaMatricula) || 0 : 0; %>
          <td><strong><%= formatBRL(_falta) %></strong><% if (_taxaPaga > 0) { %><small class="adm-valor-de">+ <%= formatBRL(_taxaPaga) %> de inscrição já paga</small><% } %></td>
          <%- contatoHtml(m) %>
          <%- acoesHtml(m) %>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('foot') %>
