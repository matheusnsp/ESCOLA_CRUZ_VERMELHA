<%- include('head', { titulo: 'Pagamentos pendentes' }) %>
<%- include('header', { ativo: 'pendentes' }) %>

<%
  // ═══════════════════════════════════════════════════════════════════════
  // PAGAMENTOS PENDENTES — três abas
  //
  // A organização em três vem de um aprendizado da secretaria: ela testou
  // uma lista larga de contatos e 4 de 5 pessoas já tinham conversado com
  // ela. O problema não era o texto, era o recorte — a lista misturava quem
  // valia abordar com quem não valia.
  //
  //   1. Taxa paga, curso pendente  → dinheiro em jogo
  //   2. Nada pago, dá tempo        → recuperável
  //   3. Fora de prazo              → turma encerrada ou já começou
  //
  // A aba 3 é nova. Antes essas linhas simplesmente não apareciam (o filtro
  // de status as excluía), o que escondia gente que ficou pelo caminho.
  //
  // Todas as classes são adm-* já existentes — sem CSS novo além do bloco
  // no fim deste arquivo.
  // ═══════════════════════════════════════════════════════════════════════

  function diasDesde(data) {
    if (!data) return null;
    return Math.floor((Date.now() - new Date(data).getTime()) / 86400000);
  }

  function diasAte(data) {
    if (!data) return null;
    return Math.ceil((new Date(data).getTime() - Date.now()) / 86400000);
  }

  // Data pura em UTC: Turma.inicioPrevisto e AulaData.data não devem sofrer
  // conversão de fuso. Foi o bug que mandou 23/09 no lugar de 24/09 por
  // e-mail — meia-noite UTC virava 21h do dia anterior em Brasília.
  function dataBR(d) {
    if (!d) return '—';
    const dt = new Date(d);
    const p = (n) => String(n).padStart(2, '0');
    return `${p(dt.getUTCDate())}/${p(dt.getUTCMonth() + 1)}/${dt.getUTCFullYear()}`;
  }

  function dataHoraBR(d) {
    return d ? new Date(d).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : null;
  }

  function telBR(c) {
    const d = String(c || '').replace(/\D/g, '');
    if (d.length === 11) return `(${d.slice(0,2)}) ${d.slice(2,7)}-${d.slice(7)}`;
    if (d.length === 10) return `(${d.slice(0,2)}) ${d.slice(2,6)}-${d.slice(6)}`;
    return c || null;
  }

  // Celular brasileiro hoje tem 11 dígitos com 9 na terceira posição.
  // Marcamos quem foge disso: há cadastros com fixo antigo ou digitação
  // errada, e o link do WhatsApp sairia quebrado sem aviso.
  function celularSuspeito(c) {
    const d = String(c || '').replace(/\D/g, '');
    return !(d.length === 11 && d[2] === '9');
  }

  const rotuloContato = {
    CONTATO_WHATSAPP: 'WhatsApp',
    CONTATO_PROSPECCAO: 'WhatsApp',
    ENVIOU_LEMBRETE_PAGAMENTO: 'e-mail',
  };

  const abas = [
    { id: 'com-taxa',   rot: 'Taxa paga, curso pendente', lista: comTaxa },
    { id: 'sem-taxa',   rot: 'Nada pago, ainda dá tempo', lista: semTaxa },
    { id: 'fora-prazo', rot: 'Fora de prazo',             lista: foraDePrazo },
  ];
%>

<div class="adm-h1-row">
  <h1 class="adm-h1">Pagamentos pendentes</h1>
  <span class="adm-mut">
    Em aberto: <strong><%= formatBRL(totalEmAberto) %></strong>
  </span>
</div>

<% if (flash) { %>
  <div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= flash %></div>
<% } %>

<% if (erro) { %>
  <div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
<% } %>

<!-- ══ Abas ═══════════════════════════════════════════════════════════════ -->
<div class="adm-abas">
  <% abas.forEach(function (a) { %>
    <a href="/pendentes?aba=<%= a.id %>" class="adm-aba <%= aba === a.id ? 'on' : '' %>">
      <%= a.rot %> <span class="adm-aba-num"><%= a.lista.length %></span>
    </a>
  <% }) %>
</div>

<%
  // Bloco de ações, igual nas três abas. Em função pra não repetir markup —
  // e porque as regras de quando cada botão aparece são as mesmas.
%>
<%
function acoesHtml(m) { %>
  <td class="adm-acoes">
    <div class="adm-acoes-wrap">

      <%
        // WhatsApp é POST, não link direto. O servidor registra o contato e
        // então mostra a página com o link. Antes era <a href> puro: abria
        // o WhatsApp mas o sistema não sabia que a secretaria tinha falado
        // com a pessoa, e a próxima lista trazia todo mundo de volta.
      %>
      <% if (m.linkWhats) { %>
        <form method="POST" action="/pendentes/<%= m.id %>/whatsapp" target="_blank">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="voltar" value="/pendentes?aba=<%= aba %>">
          <button class="adm-mini ok" title="Abrir WhatsApp e registrar o contato">
            <i class="fa-brands fa-whatsapp"></i>
          </button>
        </form>
      <% } else { %>
        <span class="adm-mini off" title="Celular não cadastrado ou inválido">
          <i class="fa-brands fa-whatsapp"></i>
        </span>
      <% } %>

      <% if (pode('pendentes:gerenciar') && m.pendencia.podeEmail) { %>
        <form method="POST" action="/pendentes/<%= m.id %>/lembrar"
              onsubmit="return confirm('Enviar o lembrete por e-mail para <%= m.aluno.nome.split(' ')[0] %>?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="adm-mini" title="Enviar lembrete por e-mail">
            <i class="fa-solid fa-envelope"></i>
          </button>
        </form>
      <% } else { %>
        <span class="adm-mini off"
              title="Sem pagamento online nesta etapa — use o WhatsApp">
          <i class="fa-solid fa-envelope"></i>
        </span>
      <% } %>

      <%
        // Remover só onde nada foi pago. Onde houve cobrança no gateway a
        // própria rota recusa — pode haver pagamento cuja confirmação não
        // chegou, e apagar seria apagar dinheiro.
      %>
      <% if (!m.taxaConfirmada && pode('pendentes:gerenciar')) { %>
        <form method="POST" action="/pendentes/<%= m.id %>/remover"
              onsubmit="return confirm('Remover a inscrição de <%= m.aluno.nome.split(' ')[0] %> em <%= m.turma.curso.nome %>?\n\nA vaga será liberada e o registro apagado. Não dá pra desfazer.')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="adm-mini danger" title="Remover inscrição e liberar a vaga">
            <i class="fa-solid fa-trash"></i>
          </button>
        </form>
      <% } %>

    </div>
  </td>
<% } %>

<%
function alunoHtml(m) { %>
  <td>
    <a href="/alunos/<%= m.aluno.id %>/matriculas">
      <strong><%= m.aluno.nome %></strong>
    </a>
    <br>
    <small class="adm-mut"><%= m.aluno.email %></small>
    <% if (telBR(m.aluno.celular)) { %>
      <br>
      <small class="<%= celularSuspeito(m.aluno.celular) ? 'adm-txt-alerta' : 'adm-mut' %>">
        <i class="fa-solid fa-phone"></i> <%= telBR(m.aluno.celular) %>
        <%= celularSuspeito(m.aluno.celular) ? '· confira' : '' %>
      </small>
    <% } %>
  </td>
<% } %>

<%
function contatoHtml(m) { %>
  <td>
    <% if (m.contato) { %>
      <small><%= dataHoraBR(m.contato.quando) %></small>
      <br><small class="adm-mut"><%= rotuloContato[m.contato.como] || m.contato.como %></small>
    <% } else { %>
      <small class="adm-mut">nunca</small>
    <% } %>
    <% if (m.tentouPagar) { %>
      <br><small class="adm-txt-alerta" title="Chegou a gerar cobrança no gateway — pode haver pagamento cuja confirmação não chegou">
        <i class="fa-solid fa-triangle-exclamation"></i> gerou cobrança
      </small>
    <% } %>
  </td>
<% } %>


<!-- ══════════════════════════════════════════════════════════════════════
     ABA 1 — taxa paga, curso pendente
     ══════════════════════════════════════════════════════════════════════ -->
<% if (aba === 'com-taxa') { %>
<div class="adm-box">
  <i class="fa-solid fa-circle-info"></i>
    Pagaram a taxa de inscrição e não concluíram o pagamento do curso. A vaga
    está reservada e o valor abaixo ainda não entrou.
  </p>

  <% if (!comTaxa.length) { %>
    <p class="adm-vazio">Nenhum pagamento pendente. Tudo em dia.</p>
  <% } else { %>
    <table class="adm-table">
      <thead>
        <tr>
          <th>Aluno</th><th>Curso / Turma</th><th>Parado há</th>
          <th>Valor</th><th>Último contato</th><th>Ação</th>
        </tr>
      </thead>
      <tbody>
        <% comTaxa.forEach(function (m) { %>
        <%
          const paradoHa = diasDesde(m.taxaConfirmadaEm || m.criadoEm);
          const faltam = diasAte(m.turma.inicioPrevisto);
        %>
        <tr>
          <%- alunoHtml(m) %>
          <td>
            <%= m.turma.curso.nome %>
            <br><small class="adm-mut">
              início <%= dataBR(m.turma.inicioPrevisto) %>
              <% if (faltam !== null && faltam >= 0) { %>· faltam <%= faltam %>d<% } %>
            </small>
          </td>
          <td>
            <%= paradoHa === 0 ? 'hoje' : paradoHa + 'd' %>
            <br><small class="adm-mut">taxa <%= dataBR(m.taxaConfirmadaEm) %></small>
          </td>
          <td>
            <strong><%= formatBRL(Number(m.valorCurso)) %></strong>
            <br><small class="adm-mut">taxa inclusa</small>
          </td>
          <%- contatoHtml(m) %>
          <%- acoesHtml(m) %>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<% } %>


<!-- ══════════════════════════════════════════════════════════════════════
     ABA 2 — nada pago, ainda dá tempo
     ══════════════════════════════════════════════════════════════════════ -->
<% if (aba === 'sem-taxa') { %>
<div class="adm-box">
  <p class="adm-box-intro">
    Escolheram um curso, aceitaram o contrato e escolheram como pagar — mas
    pararam antes de pagar qualquer coisa. A vaga <strong>não</strong> está
    reservada, e o texto enviado diz isso.
    <br>
    Só turmas abertas que ainda não começaram. Quem tem o aviso
    <em>"gerou cobrança"</em> chegou ao gateway: confira antes de abordar
    como quem não pagou.
  </p>

  <% if (!semTaxa.length) { %>
    <p class="adm-vazio">Nenhuma inscrição parada com turma em aberto.</p>
  <% } else { %>
    <table class="adm-table">
      <thead>
        <tr>
          <th>Aluno</th><th>Curso / Turma</th><th>Parado há</th>
          <th>Plano</th><th>Último contato</th><th>Ação</th>
        </tr>
      </thead>
      <tbody>
        <% semTaxa.forEach(function (m) { %>
        <%
          const paradoHa = diasDesde(m.criadoEm);
          const faltam = diasAte(m.turma.inicioPrevisto);
        %>
        <tr>
          <%- alunoHtml(m) %>
          <td>
            <%= m.turma.curso.nome %>
            <br><small class="adm-mut">
              início <%= dataBR(m.turma.inicioPrevisto) %>
              <% if (faltam !== null && faltam >= 0) { %>· faltam <%= faltam %>d<% } %>
            </small>
          </td>
          <td><%= paradoHa === 0 ? 'hoje' : paradoHa + 'd' %></td>
          <td>
            <%= m.plano === 'A_VISTA' ? 'À vista' : m.plano === 'PRESENCIAL' ? 'Presencial' : 'Parcelado' %>
          </td>
          <%- contatoHtml(m) %>
          <%- acoesHtml(m) %>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<% } %>


<!-- ══════════════════════════════════════════════════════════════════════
     ABA 3 — fora de prazo
     ══════════════════════════════════════════════════════════════════════ -->
<% if (aba === 'fora-prazo') { %>
<div class="adm-box">
  <p class="adm-box-intro">
    A turma encerrou ou já começou. O curso que essas pessoas escolheram não
    está mais disponível — <strong>não</strong> vale mandar o texto padrão,
    que fala de retomar a inscrição.
    <br>
    Ficam aqui pra não desaparecerem da tela: se houver turma nova do mesmo
    curso, são as primeiras a chamar.
  </p>

  <% if (!foraDePrazo.length) { %>
    <p class="adm-vazio">Nenhuma pendência fora de prazo.</p>
  <% } else { %>
    <table class="adm-table">
      <thead>
        <tr>
          <th>Aluno</th><th>Curso</th><th>Turma</th>
          <th>Pagou taxa?</th><th>Último contato</th><th>Ação</th>
        </tr>
      </thead>
      <tbody>
        <% foraDePrazo.forEach(function (m) { %>
        <tr class="adm-tr-fraca">
          <%- alunoHtml(m) %>
          <td><%= m.turma.curso.nome %></td>
          <td>
            <small class="adm-mut">
              <%= m.turma.status %> · <%= dataBR(m.turma.inicioPrevisto) %>
            </small>
          </td>
          <td>
            <% if (m.taxaConfirmada) { %>
              <span class="badge ok">Sim</span>
              <br><small class="adm-mut"><%= formatBRL(Number(m.valorCurso)) %></small>
            <% } else { %>
              <span class="badge mut">Não</span>
            <% } %>
          </td>
          <%- contatoHtml(m) %>
          <%- acoesHtml(m) %>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<% } %>

<%- include('foot') %>