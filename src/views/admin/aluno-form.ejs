<%- include('head', { titulo: 'Editar aluno' }) %>
<%- include('header', { ativo: 'alunos' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Editar aluno</h1>
  <a href="/alunos" class="adm-link">← Voltar</a>
</div>

<% if (erro) { %>
  <div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
<% } %>

<form method="POST" action="/alunos/<%= aluno.id %>/editar" class="adm-box adm-box-pad">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="adm-form c1 adm-campos">
    <label class="full">Nome completo
      <input type="text" name="nome" value="<%= aluno.nome %>" required>
      <small class="adm-hint">Usado no certificado. Confira a grafia.</small>
    </label>
  </div>

  <fieldset class="adm-fieldset">
    <legend>Contato</legend>
    <div class="adm-form contato adm-campos">
      <label>E-mail (login)
        <input type="email" name="email" value="<%= aluno.email %>" required maxlength="180">
      </label>
      <label>Celular
        <input type="text" name="celular" value="<%= aluno.celular || '' %>"
               inputmode="numeric" placeholder="(21) 99999-9999" maxlength="15" data-mask="celular">
      </label>
    </div>
  </fieldset>

  <fieldset class="adm-fieldset">
    <legend>Documentos</legend>
    <div class="adm-form adm-campos">
      <% if (aluno.tipoDocumento === 'PASSAPORTE') { %>
        <label>Passaporte
          <input type="text" name="passaporte" value="<%= passaporteDigitado || aluno.passaporte || '' %>"
                 maxlength="20" placeholder="Ex: AB1234567">
          <small class="adm-hint">Deixe em branco para manter o atual.</small>
        </label>
        <label>País de origem
          <input type="text" name="paisOrigem" value="<%= aluno.paisOrigem || '' %>" placeholder="Ex: Argentina">
        </label>
      <% } else { %>
        <label>CPF ou CNPJ
          <input type="text" name="cpfCnpj" value="<%= cpfCnpjDigitado %>" inputmode="numeric"
                 placeholder="<%= cpfCnpjAtualMascarado ? 'Atual: ' + cpfCnpjAtualMascarado : 'Somente números' %>"
                 maxlength="18" data-mask="cpfCnpj">
          <small class="adm-hint">Deixe em branco para manter o documento atual<%= cpfCnpjAtualMascarado ? '' : ' (nenhum cadastrado)' %>.</small>
        </label>
        <label>RG
          <input type="text" name="rg" value="<%= rgDigitado %>" maxlength="14"
                 placeholder="<%= rgAtualMascarado ? 'Atual: ' + rgAtualMascarado : 'Número do RG' %>" data-mask="rg">
          <small class="adm-hint">Deixe em branco para manter o RG atual<%= rgAtualMascarado ? '' : ' (nenhum cadastrado)' %>.</small>
        </label>
      <% } %>
    </div>
  </fieldset>

  <fieldset class="adm-fieldset">
    <legend>Perfil</legend>
    <div class="adm-form c3 adm-campos">
      <label>Escolaridade
        <select name="escolaridade">
          <option value="">— não informada —</option>
          <% escolaridades.forEach(function (e) { %>
            <option value="<%= e %>" <%= aluno.escolaridade === e ? 'selected' : '' %>><%= e %></option>
          <% }) %>
        </select>
      </label>
      <label>Situação
        <select name="escolaridadeSituacao">
          <option value="">— não informada —</option>
          <% situacoes.forEach(function (s) { %>
            <option value="<%= s %>" <%= aluno.escolaridadeSituacao === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </label>
      <label>Gênero
        <select name="genero">
          <option value="">— não informado —</option>
          <% generos.forEach(function (g) { %>
            <option value="<%= g %>" <%= aluno.genero === g ? 'selected' : '' %>><%= g %></option>
          <% }) %>
        </select>
      </label>
    </div>
  </fieldset>

  <fieldset class="adm-fieldset">
    <legend>Endereço (para cobrança)</legend>
    <div class="adm-form endereco adm-campos">
      <label>CEP
        <input type="text" name="cep" value="<%= aluno.cep || '' %>"
               inputmode="numeric" placeholder="00000000" maxlength="9">
      </label>
      <label>Rua / Logradouro
        <input type="text" name="logradouro" value="<%= aluno.logradouro || '' %>">
      </label>
      <label>Número
        <input type="text" name="numero" value="<%= aluno.numero || '' %>">
      </label>
      <label>Complemento
        <input type="text" name="complemento" value="<%= aluno.complemento || '' %>">
      </label>
    </div>

    <div class="adm-form cidade-uf adm-campos">
      <label>Bairro
        <input type="text" name="bairro" value="<%= aluno.bairro || '' %>">
      </label>
      <label>Cidade
        <input type="text" name="cidade" value="<%= aluno.cidade || '' %>">
      </label>
      <label>UF
        <select name="uf">
          <option value="">--</option>
          <% ufs.forEach(function (u) { %>
            <option value="<%= u %>" <%= aluno.uf === u ? 'selected' : '' %>><%= u %></option>
          <% }) %>
        </select>
      </label>
    </div>
  </fieldset>

  <p class="adm-nota">
    <i class="fa-solid fa-triangle-exclamation"></i>
    E-mail e CPF/CNPJ são usados para login e identidade do aluno (inclusive no
    certificado). Alterações aqui ficam registradas na auditoria.
  </p>

  <button type="submit" class="adm-btn">
    <i class="fa-solid fa-floppy-disk"></i> Salvar alterações
  </button>
</form>

<% if (admPapel === 'DEV') { %>
  <% if (!aluno.bloqueioTotal) { %>

    <div class="adm-box adm-zona adm-zona-perigo">
      <h3><i class="fa-solid fa-ban"></i> Zona de perigo</h3>
      <p class="adm-mut">
        Banir este aluno cancela todas as matrículas ativas e bloqueia qualquer
        acesso ao site. A ação fica registrada na auditoria.
      </p>
      <form method="POST" action="/alunos/<%= aluno.id %>/banir"
            onsubmit="return confirm('Tem certeza? Esta ação cancela todas as matrículas ativas do aluno.')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <textarea name="motivo" required maxlength="300" class="adm-textarea"
                  placeholder="Motivo do banimento (obrigatório)"></textarea>
        <button type="submit" class="adm-btn adm-btn-danger">
          <i class="fa-solid fa-ban"></i> Banir aluno
        </button>
      </form>
    </div>

  <% } else { %>

    <div class="adm-box adm-zona adm-zona-ok">
      <h3><i class="fa-solid fa-lock"></i> Aluno banido</h3>
      <p class="adm-mut">
        Este aluno está banido e não consegue acessar o site. Todas as matrículas
        ativas foram canceladas no momento do banimento.
      </p>
      <form method="POST" action="/alunos/<%= aluno.id %>/desbanir"
            onsubmit="return confirm('Desbanir este aluno?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="adm-btn adm-btn-ok">
          <i class="fa-solid fa-lock-open"></i> Desbanir aluno
        </button>
      </form>
    </div>

  <% } %>
<% } %>

<%- include('foot') %>
<script src="/js/mascaras.js"></script>