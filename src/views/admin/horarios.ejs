<%- include('head', { titulo: 'Horários dos alunos' }) %>
<%- include('header', { ativo: 'horarios' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Dias e horários dos alunos</h1>
  <% if (!erro) { %>
    <div class="adm-acoes">
      <a href="/horarios?<%= h.cursoSel ? 'curso=' + encodeURIComponent(h.cursoSel) + '&' : '' %>atualizar=1" class="adm-btn adm-btn-neutro"><i class="fa-solid fa-rotate"></i> Atualizar</a>
      <% if (h.respostas.length) { %>
        <a href="/horarios.csv<%= h.cursoSel ? '?curso=' + encodeURIComponent(h.cursoSel) : '' %>" class="adm-btn"><i class="fa-solid fa-file-arrow-down"></i> Baixar planilha</a>
      <% } %>
    </div>
  <% } %>
</div>

<p class="adm-hz-intro">
  O que cada aluno marcou no site depois de pagar a inscrição. Use para abrir ou remarcar turmas.
</p>

<% if (erro) { %>
  <div class="adm-erro">
    <i class="fa-solid fa-circle-exclamation"></i>
    <span><%# um só bloco de texto: a caixa é flex e separaria cada <code> numa coluna %>
    <% if (erro === 'nao_configurado') { %>
      A leitura dos horários ainda não foi ligada. Falta configurar a variável <code>SITE_HORARIOS_TOKEN</code> no Render,
      com o mesmo valor de <code>SITE_HORARIOS_TOKEN</code> no <code>api/config-escola.php</code> do site.
    <% } else if (erro === 'chave') { %>
      O site recusou a chave de acesso. A variável <code>SITE_HORARIOS_TOKEN</code> precisa ter o mesmo valor aqui
      (Render) e no <code>api/config-escola.php</code> do site.
      <% if (typeof finalDaChave !== 'undefined' && finalDaChave) { %>A chave em uso aqui termina em <code>…<%= finalDaChave %></code>.<% } %>
    <% } else { %>
      Não foi possível ler os horários no site agora. Tente de novo em alguns minutos.
    <% } %>
    </span>
  </div>
<% } else { %>
  <%
    const R = h.dados.rotulos;
    const totalFaltam = h.semResposta.length;
    const cursoAtual = h.cursos.find(c => c.chave === h.cursoSel);
    const link = (chave) => '/horarios' + (chave ? '?curso=' + encodeURIComponent(chave) : '');
  %>

  <% if (h.cursos.length) { %>
    <nav class="adm-hz-cursos" aria-label="Filtrar por curso">
      <a href="<%= link('') %>" class="adm-hz-chip <%= !h.cursoSel ? 'on' : '' %>">Todos os cursos</a>
      <% h.cursos.forEach(function (c) { %>
        <a href="<%= link(c.chave) %>" class="adm-hz-chip <%= h.cursoSel === c.chave ? 'on' : '' %>"><%= c.nome %> <small><%= c.respostas %></small></a>
      <% }) %>
    </nav>
  <% } %>

  <%
    // Horários de um aluno agrupados por período: "Noite: seg, qua, sex" em vez de "Seg à noite; Qua à noite; ...".
    const porPeriodo = (slots) => hs.PERIODOS.map(p => ({
      p, nome: R.periodos[p],
      dias: slots.filter(s => s.endsWith('-' + p)).map(s => R.dias_curtos[s.split('-')[0]])
    })).filter(g => g.dias.length);
    const dataCurta = (iso) => { const d = hs.dataBr(iso); return d ? d.slice(0, 5) : ''; };
    const zap = (tel) => 'https://wa.me/55' + tel;
  %>
  <div class="adm-cards c3">
    <div class="adm-stat ok">
      <span><%= mapa.total %></span>
      <small><i class="fa-solid fa-clipboard-check"></i> Responderam</small>
    </div>
    <a class="adm-stat <%= totalFaltam ? 'warn' : '' %>" href="#faltam">
      <span><%= totalFaltam %></span>
      <small><i class="fa-solid fa-hourglass-half"></i> Pagaram e não responderam</small>
    </a>
    <div class="adm-stat <%= mapa.turma.nao ? 'warn' : '' %>">
      <span><%= mapa.turma.nao %></span>
      <small><i class="fa-solid fa-calendar-xmark"></i> Precisam de outra data</small>
    </div>
  </div>

  <% if (!mapa.total) { %>
    <div class="adm-box adm-espaco"><p class="adm-vazio">Ninguém respondeu <%= cursoAtual ? 'neste curso' : '' %> ainda.</p></div>
  <% } else { %>
    <div class="adm-box adm-espaco">
      <div class="adm-box-head">
        <h2 class="adm-h2"><i class="fa-solid fa-table-cells"></i> Quantos podem em cada horário <%= cursoAtual ? '· ' + cursoAtual.nome : '' %></h2>
      </div>
      <div class="adm-hz-corpo">
      <div class="adm-hz-rolagem">
        <table class="adm-hz-grade">
          <caption class="adm-mut">Alunos que podem em cada dia e período. Quanto mais forte a cor, mais alunos.</caption>
          <thead>
            <tr>
              <th scope="col"><span class="adm-hz-sr">Período</span></th>
              <% hs.DIAS.forEach(function (d) { %><th scope="col"><%= R.dias_curtos[d] %></th><% }) %>
            </tr>
          </thead>
          <tbody>
            <% hs.PERIODOS.forEach(function (p) { %>
              <tr>
                <th scope="row"><%= R.periodos[p] %><small><%= R.horas[p] %></small></th>
                <% hs.DIAS.forEach(function (d) {
                     const n = mapa.grade[p][d];
                     const forca = mapa.maximo ? (n / mapa.maximo).toFixed(2) : 0; %>
                  <td class="<%= n ? '' : 'zero' %> <%= n && n === mapa.maximo ? 'max' : '' %>" style="--n:<%= forca %>"
                      title="<%= R.dias[d] %> <%= String(R.periodos[p]).toLowerCase() %>: <%= n %> aluno(s)"><%= n || '' %></td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (mapa.top.length) { %>
        <p class="adm-hz-top"><b>Mais pedidos:</b>
          <%= mapa.top.map(t => hs.slotTexto(t.slot, R) + ' (' + t.n + ')').join(' · ') %></p>
      <% } %>
      <p class="adm-hz-resumo"><b>Quando podem começar:</b>
        <% Object.keys(R.inicio).forEach(function (k, i) { %><%= i ? ' · ' : '' %><%= R.inicio[k].replace(/^Já na /, 'na ').replace(/^Daqui a (cerca de )?/, 'em ') %> <b><%= mapa.inicio[k] || 0 %></b><% }) %>
      </p>
      </div>
    </div>
  <% } %>

  <% if (h.cursoSel) { %>
    <div class="adm-box adm-espaco">
      <div class="adm-box-head">
        <h2 class="adm-h2"><i class="fa-solid fa-calendar-days"></i> Próximas turmas deste curso na escola</h2>
      </div>
      <% if (!cursoAtual || !cursoAtual.cursoId) { %>
        <p class="adm-vazio adm-hz-nota">Este curso do site não está ligado a um curso da escola.</p>
      <% } else if (!turmas.length) { %>
        <p class="adm-vazio adm-hz-nota">Nenhuma turma aberta ou confirmada a partir de hoje.
          <% if (pode('turmas:gerenciar')) { %><a href="/turmas/nova?curso=<%= cursoAtual.cursoId %>">Criar turma</a>.<% } %></p>
      <% } else { %>
        <ul class="adm-hz-turmas">
          <% turmas.forEach(function (t) {
               const dias = [...new Set(t.aulas.map(a => ['dom','seg','ter','qua','qui','sex','sáb'][new Date(a.data).getUTCDay()]))];
               const horas = [...new Set(t.aulas.map(a => a.horario).filter(Boolean))]; %>
            <li>
              <<%= pode('turmas:gerenciar') ? 'a href=/turmas/' + t.id + '/editar' : 'span' %> class="adm-hz-turma">
                <b><i class="fa-regular fa-calendar"></i> <%= t.inicioPrevisto.toLocaleDateString('pt-BR', { timeZone: 'UTC', day: '2-digit', month: '2-digit' }) %></b>
                <span><%= t.aulas.length ? t.aulas.length + (t.aulas.length > 1 ? ' aulas' : ' aula') + ' · ' + dias.join(', ') + (horas.length ? ' · ' + horas.join(', ') : '') : 'sem aulas cadastradas' %></span>
                <span><i class="fa-solid fa-user-group"></i> <%= t._count.matriculas %> de <%= t.vagas %> alunos</span>
                <em class="badge st-<%= t.status.toLowerCase() %>"><%= rotuloTurma(t.status) %></em>
              </<%= pode('turmas:gerenciar') ? 'a' : 'span' %>>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  <% } %>

  <% if (totalFaltam) { %>
    <details class="adm-box adm-espaco adm-hz-faltam" id="faltam">
      <summary><i class="fa-solid fa-hourglass-half"></i> <%= totalFaltam %> <%= totalFaltam > 1 ? 'alunos pagaram' : 'aluno pagou' %> e ainda não <%= totalFaltam > 1 ? 'responderam' : 'respondeu' %></summary>
      <p class="adm-mut adm-hz-nota">O site já manda até dois lembretes por e-mail (24 h e 72 h depois do pagamento).</p>
      <table class="adm-table adm-table-cards">
        <thead><tr><th>Aluno</th><% if (!h.cursoSel) { %><th>Curso</th><% } %><th>Pagou em</th><th>Contato</th></tr></thead>
        <tbody>
          <% h.semResposta.forEach(function (l) { const alunoId = alunoPorEmail[l.email.toLowerCase()]; %>
            <tr>
              <td><% if (alunoId) { %><a href="/alunos/<%= alunoId %>/matriculas" class="adm-link-aluno"><%= l.nome %></a><% } else { %><b><%= l.nome %></b><% } %>
                <small class="adm-mut adm-hz-contato"><%= l.email %></small></td>
              <% if (!h.cursoSel) { %><td><%= l.cursoNome %></td><% } %>
              <td><%= hs.dataBr(l.pagoEm) || '—' %></td>
              <td>
                <div class="adm-pend-acoes">
                  <% if (l.telefone) { %><a href="<%= zap(l.telefone) %>" target="_blank" rel="noopener" class="adm-pend-btn whats"><i class="fa-brands fa-whatsapp"></i> <%= hs.telefoneBonito(l.telefone) %></a><% } %>
                  <a href="mailto:<%= l.email %>" class="adm-pend-btn"><i class="fa-regular fa-envelope"></i> E-mail</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </details>
  <% } %>

  <% if (h.respostas.length) { %>
    <div class="adm-box adm-espaco">
      <div class="adm-box-head">
        <h2 class="adm-h2"><i class="fa-solid fa-list"></i> Respostas (<%= h.respostas.length %>)</h2>
      </div>
      <table class="adm-table adm-table-cards adm-hz-respostas">
        <thead>
          <tr><th>Aluno</th><th>Pode vir</th><th>Começo</th><th>Turma</th><th>Recado · resposta</th></tr>
        </thead>
        <tbody>
          <% h.respostas.forEach(function (l) { const alunoId = alunoPorEmail[l.email.toLowerCase()]; %>
            <tr>
              <td>
                <% if (alunoId) { %><a href="/alunos/<%= alunoId %>/matriculas" class="adm-link-aluno"><%= l.nome %></a><% } else { %><b><%= l.nome %></b><% } %>
                <% if (!h.cursoSel) { %><small class="adm-hz-curso"><%= l.cursoNome %></small><% } %>
                <small class="adm-mut adm-hz-contato">
                  <% if (l.telefone) { %><a href="<%= zap(l.telefone) %>" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> <%= hs.telefoneBonito(l.telefone) %></a><% } else { %><a href="mailto:<%= l.email %>"><%= l.email %></a><% } %>
                </small>
              </td>
              <td>
                <% porPeriodo(l.horarios).forEach(function (g) { %>
                  <span class="adm-hz-per"><b><%= g.nome %></b> <%= g.dias.join(', ') %></span>
                <% }) %>
              </td>
              <td><%= R.inicio[l.inicio] || '—' %></td>
              <td>
                <% if (l.turmaInicio) { %>
                  <b class="num"><%= dataCurta(l.turmaInicio) %></b>
                  <% if (l.turmaServe === 'nao') { %><span class="badge canc">precisa de outra data</span><% } else if (l.turmaServe === 'sim') { %><span class="badge ok">data serve</span><% } %>
                <% } else { %><span class="adm-mut">sem turma</span><% } %>
              </td>
              <td>
                <% if (l.observacao) { %><span class="adm-hz-recado"><%= l.observacao %></span><% } %>
                <small class="adm-mut adm-hz-quando" title="Respondeu em <%= hs.dataHoraBrt(l.respondidoEm) %>">respondeu <%= dataCurta(l.respondidoEm) %><%= l.vezes > 1 ? ' · mudou ' + (l.vezes - 1) + '×' : '' %></small>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <p class="adm-mut adm-hz-fonte">Dados do questionário no site<% if (h.dados.geradoEm) { %>, lidos em <%= hs.dataHoraBrt(h.dados.geradoEm) %><% } %>. CPF não é enviado.</p>
<% } %>

<%- include('foot') %>
