<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %>Secretaria · Cruz Vermelha</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/img/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">

  <!-- Tema: aplicado ANTES do CSS carregar, de propósito. Se ficasse no
       fim do body, a página pintaria branca por um instante e só depois
       viraria escura — aquele "flash" que incomoda em tela escura.
       Três opções: claro, escuro ou automático (segue o sistema e muda sozinho quando o
       sistema muda). Sem escolha salva, é automático. -->
  <script>
    (function () {
      var html = document.documentElement;
      var mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
      function aplicar(pref) {
        if (pref !== 'claro' && pref !== 'escuro') pref = 'auto';
        html.dataset.temaPref = pref;
        html.dataset.tema = pref === 'auto' ? (mq && mq.matches ? 'escuro' : 'claro') : pref;
      }
      var salvo = null;
      try { salvo = localStorage.getItem('adm-tema'); } catch (e) {}
      aplicar(salvo);
      if (mq) {
        var seguir = function () { if (html.dataset.temaPref === 'auto') aplicar('auto'); };
        if (mq.addEventListener) mq.addEventListener('change', seguir); else if (mq.addListener) mq.addListener(seguir);
      }
      window.admTema = function (pref) {
        aplicar(pref);
        try { localStorage.setItem('adm-tema', html.dataset.temaPref); } catch (e) {}
      };
    })();
  </script>

  <!-- Manrope (corpo) e Bricolage Grotesque (títulos e números):
       as mesmas fontes do site público. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800;12..96,900&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="<%= asset('/admin.css') %>">
</head>
<body class="adm">