<%- include('head', { titulo: 'Usuários Admin' }) %>
<%- include('header', { ativo: 'dev-usuarios' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Configurações</h1>
  <a href="/dev/usuarios/novo" class="adm-btn"><i class="fa-solid fa-plus"></i> Novo usuário</a>
</div>
<%- include('abas-config', { aba: 'usuarios' }) %>

<% if (ok) { %><div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= ok %></div><% } %>
<% if (erro) { %><div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div><% } %>

<div class="adm-box">
  <% if (!linhas.length) { %>
    <p class="adm-vazio">Nenhum usuário admin cadastrado.</p>
  <% } else { %>
    <%
      const NOMES = { SECRETARIA: 'Secretaria', COORDENADOR: 'Coordenador', FINANCEIRO: 'Financeiro', CONSULTA: 'Consulta', DEV: 'Dev' };
    %>
    <table class="adm-table adm-table-cards adm-usuarios">
      <thead>
        <tr>
          <th>Usuário</th>
          <th>Papel</th>
          <th>Permissões</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% linhas.forEach(function(u) { const eu = u.id === meuId; %>
          <tr>
            <td>
              <strong><%= u.nome %></strong><% if (eu) { %> <span class="adm-mut">(você)</span><% } %>
              <small class="adm-mut adm-hz-contato"><%= u.email %></small>
            </td>
            <td>
              <% if (eu) { %>
                <span class="badge ok" title="Você não pode alterar o próprio papel"><%= NOMES[u.papel] || u.papel %></span>
              <% } else { %>
                <form method="POST" action="/dev/usuarios/<%= u.id %>/papel" class="adm-papel-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <select name="papel" aria-label="Papel de <%= u.nome %>" data-atual="<%= u.papel %>">
                    <% papeis.forEach(function(p) { %>
                      <option value="<%= p %>" <%= p === u.papel ? 'selected' : '' %>><%= NOMES[p] || p %></option>
                    <% }) %>
                  </select>
                  <button type="submit" class="adm-pend-btn" hidden><i class="fa-solid fa-check"></i> Salvar</button>
                </form>
              <% } %>
            </td>
            <td>
              <% if (u.papel === 'DEV') { %><span class="adm-mut">todas (acesso total)</span>
              <% } else { %><a href="/dev/permissoes" class="adm-link"><%= u.permissoes.length %> <%= u.permissoes.length === 1 ? 'permissão' : 'permissões' %> <i class="fa-solid fa-arrow-right"></i></a><% } %>
            </td>
            <td class="adm-usuario-acoes">
              <% if (!eu) { %>
                <form method="POST" action="/dev/usuarios/<%= u.id %>/excluir"
                      data-confirmar="Excluir <%= u.nome %> (<%= u.email %>)? A pessoa perde o acesso ao painel na hora. Não dá para desfazer; para voltar, crie o usuário de novo."
                      data-botao="Excluir usuário">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="adm-pend-btn perigo" aria-label="Excluir <%= u.nome %>"><i class="fa-solid fa-trash"></i> Excluir</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <script>
      // O "Salvar" do papel só aparece depois de escolher outro papel.
      document.querySelectorAll('.adm-papel-form select').forEach(function (s) {
        s.addEventListener('change', function () { s.form.querySelector('button').hidden = s.value === s.dataset.atual; });
      });
    </script>
  <% } %>
</div>

<%- include('foot') %>