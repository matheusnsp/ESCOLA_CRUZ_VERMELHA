<%- include('head', { titulo: 'Turmas' }) %>
<%- include('header', { ativo: 'turmas' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Turmas</h1>
  <% if (pode('turmas:gerenciar')) { %>
    <a href="/turmas/nova" class="adm-btn"><i class="fa-solid fa-plus"></i> Nova turma</a>
  <% } %>
</div>

<% if (flash) { %><div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= flash %></div><% } %>
<% if (erro)  { %><div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div><% } %>

<%
  // Abas no lugar dos 6 cartões e das seções por status (que repetiam as mesmas contagens).
  const ROTULOS = [
    { id: 'por-comecar', rot: 'Por começar' },
    { id: 'andamento',   rot: 'Em andamento' },
    { id: 'concluidas',  rot: 'Concluídas' },
    { id: 'canceladas',  rot: 'Canceladas' },
  ];
  const lista = abas[aba];
  const dia = d => { const x = new Date(d); const p = n => String(n).padStart(2, '0'); return p(x.getUTCDate()) + '/' + p(x.getUTCMonth() + 1); };
  const ocupadas = lista.reduce((t, x) => t + x._count.matriculas, 0);
  const vagas = lista.reduce((t, x) => t + (x.vagas || 0), 0);
  const podeAlunos = pode('aluno:gerenciar') || pode('painel:leitura');
%>

<div class="adm-abas">
  <% ROTULOS.forEach(function (a) { %>
    <a href="/turmas?aba=<%= a.id %>" class="adm-aba <%= aba === a.id ? 'on' : '' %>">
      <%= a.rot %> <span class="adm-aba-num"><%= abas[a.id].length %></span>
    </a>
  <% }) %>
</div>

<div class="adm-box">
  <% if (lista.length && (aba === 'por-comecar' || aba === 'andamento')) { %>
    <p class="adm-box-intro"><i class="fa-solid fa-user-group"></i>
      <strong><%= ocupadas %> de <%= vagas %> vagas</strong> ocupadas nestas turmas (<%= vagas ? Math.round(ocupadas / vagas * 100) : 0 %>%).
      Contam as matrículas com a taxa paga.
    </p>
  <% } %>

  <% if (!lista.length) { %>
    <p class="adm-vazio">
      <%= aba === 'por-comecar' ? 'Nenhuma turma por começar.' : aba === 'andamento' ? 'Nenhuma turma em andamento.' : aba === 'concluidas' ? 'Nenhuma turma concluída.' : 'Nenhuma turma cancelada.' %>
      <% if (aba === 'por-comecar' && pode('turmas:gerenciar')) { %><a href="/turmas/nova">Criar uma turma</a>.<% } %>
    </p>
  <% } else { %>
    <table class="adm-table adm-table-cards">
      <thead>
        <tr>
          <th>Curso</th>
          <th>Início</th>
          <th>Aulas</th>
          <th>Vagas</th>
          <th>Status</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% lista.forEach(function (t) {
             const insc = t._count.matriculas;
             const pct = t.vagas ? Math.min(100, Math.round(insc / t.vagas * 100)) : 0;
             const abaixoMin = t.minimoAlunos && insc < t.minimoAlunos && (aba === 'por-comecar' || aba === 'andamento');
             const faltam = Math.ceil((new Date(t.inicioPrevisto) - Date.now()) / 86400000);
             const aulas = t.aulas || []; %>
        <tr>
          <td><strong><%= t.curso.nome %></strong></td>
          <td>
            <%= new Date(t.inicioPrevisto).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) %>
            <% if (aba === 'por-comecar') { %><br><small class="adm-mut">em <%= faltam %> <%= faltam === 1 ? 'dia' : 'dias' %></small><% } %>
          </td>
          <td>
            <% if (aulas.length) { %>
              <%= aulas.length %> <%= aulas.length === 1 ? 'aula' : 'aulas' %> · <%= aulas[0].horario %>
              <br><small class="adm-mut"><%= aulas.map(a => dia(a.data)).join(', ') %></small>
            <% } else { %>
              <span class="adm-mut">sem aulas cadastradas</span>
            <% } %>
          </td>
          <td class="adm-vagas-cel">
            <b class="num"><%= insc %>/<%= t.vagas %></b>
            <div class="adm-barra"><span class="<%= abaixoMin ? 'baixa' : '' %>" style="width: <%= pct %>%"></span></div>
            <% if (t.minimoAlunos) { %><small class="<%= abaixoMin ? 'adm-txt-alerta' : 'adm-mut' %>">mínimo <%= t.minimoAlunos %></small><% } %>
          </td>
          <td><span class="badge st-<%= t.status.toLowerCase() %>"><%= rotuloTurma(t.status) %></span></td>
          <td class="adm-acoes">
            <div class="adm-pend-acoes">
              <% if (podeAlunos) { %>
                <a href="/alunos?turma=<%= t.id %>" class="adm-pend-btn"><i class="fa-solid fa-user-graduate"></i> Alunos</a>
              <% } %>
              <% if (pode('turmas:gerenciar') || pode('secretaria:leitura')) { %>
                <a href="/turmas/<%= t.id %>/notas" class="adm-pend-btn"><i class="fa-solid fa-star-half-stroke"></i> Notas</a>
              <% } %>
              <% if (pode('turmas:gerenciar')) { %>
                <a href="/turmas/<%= t.id %>/editar" class="adm-pend-btn"><i class="fa-solid fa-pen"></i> Editar</a>
                <% if (!insc) { %>
                  <form method="POST" action="/turmas/<%= t.id %>/excluir"
                        data-confirmar="Excluir a turma de <%= t.curso.nome %> (<%= new Date(t.inicioPrevisto).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) %>)? Só é possível se ninguém se inscreveu." data-botao="Excluir">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="adm-pend-btn perigo"><i class="fa-solid fa-trash"></i> Excluir</button>
                  </form>
                <% } %>
              <% } %>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('foot') %>
