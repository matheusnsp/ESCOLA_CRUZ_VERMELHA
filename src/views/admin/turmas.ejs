<%- include('head', { titulo: 'Turmas' }) %>
<%- include('header', { ativo: 'turmas' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Turmas</h1>
  <% if (pode('turmas:gerenciar')) { %>
    <a href="/turmas/nova" class="adm-btn"><i class="fa-solid fa-plus"></i> Nova turma</a>
  <% } %>
</div>

<% if (flash) { %><div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= flash %></div><% } %>
<% if (erro)  { %><div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div><% } %>

<%
  const LIMITE_GRUPO = 5;

  const GRUPOS = [
    { chave: 'aberta',     label: 'Abertas',     icone: 'fa-door-open'    },
    { chave: 'confirmada', label: 'Confirmadas', icone: 'fa-circle-check' },
    { chave: 'cancelada',  label: 'Canceladas',  icone: 'fa-ban'          },
    { chave: 'encerrada',  label: 'Encerradas',  icone: 'fa-box-archive'  },
  ];

  const porStatus = {};
  GRUPOS.forEach(g => porStatus[g.chave] = []);
  turmas.forEach(function(t) {
    const s = t.status.toLowerCase();
    if (porStatus[s] !== undefined) porStatus[s].push(t);
    else { if (!porStatus[s]) porStatus[s] = []; porStatus[s].push(t); }
  });

  const totalInscritos = turmas.reduce((soma, t) => soma + (t._count?.matriculas || 0), 0);
  const totalVagas     = turmas.reduce((soma, t) => soma + (t.vagas || 0), 0);
%>

<!-- ===== Resumo ===== -->
<div class="adm-cards">
  <div class="adm-stat">
    <span><%= turmas.length %></span>
    <small><i class="fa-solid fa-layer-group"></i> Turmas no total</small>
  </div>
  <div class="adm-stat ok">
    <span><%= porStatus.aberta.length %></span>
    <small><i class="fa-solid fa-door-open"></i> Abertas</small>
  </div>
  <div class="adm-stat">
    <span><%= porStatus.confirmada.length %></span>
    <small><i class="fa-solid fa-circle-check"></i> Confirmadas</small>
  </div>
  <div class="adm-stat warn">
    <span><%= porStatus.cancelada.length + porStatus.encerrada.length %></span>
    <small><i class="fa-solid fa-box-archive"></i> Canceladas + Encerradas</small>
  </div>
</div>

<div class="adm-cards" style="grid-template-columns:repeat(2,1fr); margin-bottom:26px;">
  <div class="adm-stat">
    <span><%= totalInscritos %>/<%= totalVagas %></span>
    <small><i class="fa-solid fa-user-group"></i> Inscritos / vagas (todas as turmas)</small>
  </div>
  <div class="adm-stat">
    <span><%= totalVagas ? Math.round((totalInscritos / totalVagas) * 100) : 0 %>%</span>
    <small><i class="fa-solid fa-chart-simple"></i> Ocupação média</small>
  </div>
</div>

<% if (!turmas.length) { %>
  <div class="adm-box">
    <p class="adm-vazio">Nenhuma turma. <% if (pode('turmas:gerenciar')) { %><a href="/turmas/nova">Criar a primeira</a>.<% } %></p>
  </div>
<% } %>

<% GRUPOS.forEach(function(g) { %>
  <% const lista = porStatus[g.chave] || []; %>
  <% if (!lista.length) { return; } %>
  <% const recolhido = (g.chave === 'encerrada' || g.chave === 'cancelada'); %>

  <details class="adm-box adm-turmas-grupo" id="grupo-<%= g.chave %>" <%= recolhido ? '' : 'open' %> style="margin-bottom:20px;">
    <summary class="adm-grupo-summary">
      <span class="adm-grupo-left">
        <i class="fa-solid <%= g.icone %> st-ico-<%= g.chave %>"></i>
        <strong><%= g.label %></strong>
        <span class="adm-grupo-count"><%= lista.length %></span>
      </span>
      <i class="fa-solid fa-chevron-down adm-grupo-caret"></i>
    </summary>

    <table class="adm-table">
      <thead>
        <tr><th>Curso</th><th>Início</th><th>Dias / Horário</th><th>Inscritos</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% lista.forEach(function(t, i) { %>
        <tr<% if (i >= LIMITE_GRUPO) { %> class="adm-extra"<% } %>>
          <td><strong><%= t.curso.nome %></strong></td>
          <td><%= new Date(t.inicioPrevisto).toLocaleDateString('pt-BR') %></td>
          <td>
            <% if (t.aulas && t.aulas.length) { %>
              <%= t.aulas[0].horario %>
            <% } else { %>
              <span class="adm-mut">—</span>
            <% } %>
          </td>
          <td><a href="/inscricoes?turma=<%= t.id %>"><%= t._count.matriculas %>/<%= t.vagas %></a></td>
          <td><span class="badge st-<%= t.status.toLowerCase() %>"><%= t.status %></span></td>
          <td class="adm-acoes">
            <% if (pode('turmas:gerenciar') || pode('secretaria:leitura')) { %>
              <a href="/turmas/<%= t.id %>/notas" class="adm-mini" title="Lançar notas da turma"><i class="fa-solid fa-list-check"></i></a>
            <% } %>
            <% if (pode('turmas:gerenciar')) { %>
              <a href="/turmas/<%= t.id %>/editar" class="adm-mini" title="Editar"><i class="fa-solid fa-pen"></i></a>
              <form method="POST" action="/turmas/<%= t.id %>/excluir"
                    onsubmit="return confirm('Excluir esta turma? Só é possível se não houver alunos matriculados.')"
                    style="display:inline;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="adm-mini danger" title="Excluir turma"><i class="fa-solid fa-trash"></i></button>
              </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (lista.length > LIMITE_GRUPO) { %>
      <button type="button" class="adm-vermais" data-grupo="grupo-<%= g.chave %>" data-extra="<%= lista.length - LIMITE_GRUPO %>">
        Ver mais <%= lista.length - LIMITE_GRUPO %>
      </button>
    <% } %>
  </details>
<% }) %>

<script>
  document.querySelectorAll('.adm-vermais').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var box = document.getElementById(btn.dataset.grupo);
      var extra = btn.dataset.extra;
      var abrindo = !box.classList.contains('aberto');
      box.classList.toggle('aberto');
      btn.textContent = abrindo ? 'Ver menos' : ('Ver mais ' + extra);
    });
  });
</script>

<%- include('foot') %>