<%- include('head', { titulo: 'Certificados' }) %>
<%- include('header', { ativo: 'turmas' }) %>
<%
  const dia = (d) => new Date(d).toLocaleDateString('pt-BR', { timeZone: 'UTC' });
  const nota = (n) => n == null ? '—' : String(Math.round(n * 10) / 10).replace('.', ',');
%>

<div class="adm-h1-row">
  <div>
    <h1 class="adm-h1">Certificados</h1>
    <p class="adm-mut adm-bv-sub"><%= turma.curso.nome %> · <%= dia(turma.aulas[0] ? turma.aulas[0].data : turma.inicioPrevisto) %> · <%= rotuloTurma(turma.status) %></p>
  </div>
  <a href="/turmas?aba=concluidas" class="adm-link"><i class="fa-solid fa-arrow-left"></i> Turmas</a>
</div>

<% if (pendencias.length) { %>
  <div class="adm-aviso adm-cert-pend">
    <p><i class="fa-solid fa-triangle-exclamation"></i> <b>Antes de imprimir:</b></p>
    <ul>
      <% pendencias.forEach(function (p) { %>
        <li><%= p.texto %><% if (p.link) { %> <a href="<%= p.link %>" class="adm-link">Preencher</a><% } %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<form method="GET" action="/turmas/<%= turma.id %>/certificados/imprimir" target="_blank" class="adm-box" id="formCert">
  <div class="adm-box-head">
    <h2 class="adm-h2"><i class="fa-solid fa-award"></i> Aprovados (<%= aprovados.length %>)</h2>
    <% if (aprovados.length) { %>
      <button class="adm-btn" id="btnImprimir"><i class="fa-solid fa-print"></i> Imprimir selecionados</button>
    <% } %>
  </div>
  <% if (!aprovados.length) { %>
    <p class="adm-vazio">Ninguém aprovado nesta turma ainda. Marque a situação de cada aluno em <a href="/turmas/<%= turma.id %>/notas">Notas</a>.</p>
  <% } else { %>
    <table class="adm-table adm-table-cards">
      <thead><tr><th><input type="checkbox" id="certTodos" checked aria-label="Marcar todos"></th><th>Aluno</th><th>Documento</th><th>Nota</th><th>Livro / Registro</th><th></th></tr></thead>
      <tbody>
        <% aprovados.forEach(function (m) { const doc = documentoAluno(m.aluno); %>
          <tr>
            <td><input type="checkbox" name="m" value="<%= m.id %>" checked aria-label="Imprimir <%= m.aluno.nome %>"></td>
            <td><strong><%= m.aluno.nome %></strong></td>
            <td><% if (doc) { %><small class="adm-mut"><%= doc.tipo %></small> <%= doc.numero %><% } else { %><span class="adm-txt-alerta">sem documento</span><% } %></td>
            <td><%= nota(m.nota) %></td>
            <td><% if (m.certRegistro) { %>Livro <%= m.certLivro %> · Nº <%= m.certRegistro %><small class="adm-mut adm-hz-contato">emitido em <%= new Date(m.certEmitidoEm).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></small>
                <% } else { %><span class="adm-mut">gerado ao imprimir</span><% } %></td>
            <td><a href="/turmas/<%= turma.id %>/certificados/imprimir?m=<%= m.id %>" target="_blank" class="adm-pend-btn"><i class="fa-solid fa-print"></i> Imprimir</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="adm-hint adm-cert-dica">Abre numa aba nova, já no tamanho A4 deitado: cada aluno tem frente e verso. Na impressora, escolha
      <b>frente e verso</b> virando pela <b>borda curta</b>. O Livro <%= ajustes.livro %> e o registro são gerados na primeira impressão e mantidos depois.
      <a href="/modelos?voltar=/turmas/<%= turma.id %>/certificados">Ajustes do certificado</a>.</p>
  <% } %>
</form>

<% if (outros.length) { %>
  <details class="adm-box adm-espaco adm-hz-faltam">
    <summary><i class="fa-solid fa-user-clock"></i> <%= outros.length %> <%= outros.length === 1 ? 'aluno sem aprovação' : 'alunos sem aprovação' %></summary>
    <ul class="adm-bv-alunos">
      <% outros.forEach(function (m) { %>
        <li class="fraco"><span><%= m.aluno.nome %></span><em class="badge <%= m.situacao === 'REPROVADO' ? 'canc' : '' %>"><%= m.situacao === 'REPROVADO' ? 'reprovado' : 'sem situação' %></em></li>
      <% }) %>
    </ul>
  </details>
<% } %>

<script>
  (function () {
    var todos = document.getElementById('certTodos'); if (!todos) return;
    var caixas = document.querySelectorAll('#formCert input[name="m"]');
    var btn = document.getElementById('btnImprimir');
    function contar() { var n = 0; caixas.forEach(function (c) { if (c.checked) n++; }); btn.disabled = !n; btn.lastChild.textContent = ' Imprimir ' + (n === caixas.length ? 'todos' : n + ' selecionado' + (n === 1 ? '' : 's')); }
    todos.addEventListener('change', function () { caixas.forEach(function (c) { c.checked = todos.checked; }); contar(); });
    caixas.forEach(function (c) { c.addEventListener('change', contar); });
    contar();
  })();
</script>

<%- include('foot') %>
