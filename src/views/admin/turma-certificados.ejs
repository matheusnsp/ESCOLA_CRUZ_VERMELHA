<%- include('head', { titulo: 'Certificados' }) %>
<%- include('header', { ativo: 'turmas' }) %>
<%
  const dia = (d) => new Date(d).toLocaleDateString('pt-BR', { timeZone: 'UTC' });
  const temNota = aprovados.some((m) => m.nota != null);
  const nota = (n) => n == null ? '—' : String(Math.round(n * 10) / 10).replace('.', ',');
%>

<div class="adm-h1-row">
  <div>
    <h1 class="adm-h1">Certificados</h1>
    <p class="adm-mut adm-bv-sub"><%= turma.curso.nome %> · <%= dia(turma.aulas[0] ? turma.aulas[0].data : turma.inicioPrevisto) %> · <%= rotuloTurma(turma.status) %></p>
  </div>
  <a href="/turmas?aba=concluidas" class="adm-link"><i class="fa-solid fa-arrow-left"></i> Turmas</a>
</div>

<% if (ok) { %><div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= ok %></div><% } %>
<% if (erro) { %><div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div><% } %>

<form method="POST" action="/turmas/<%= turma.id %>/certificados/assinaturas" class="adm-box adm-espaco adm-cert-assin" id="formAssin">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="adm-box-head">
    <h2 class="adm-h2"><i class="fa-solid fa-signature"></i> Assinaturas deste certificado</h2>
    <a href="/modelos?voltar=/turmas/<%= turma.id %>/certificados" class="adm-link">Editar a lista de quem assina</a>
  </div>
  <div class="adm-cert-assin-corpo">
    <p class="adm-hint">Marque quem assina (até <%= maxNoCertificado %>). A ordem é a da lista.
      <% if (segueCurso) { %>Hoje segue o <a href="/cursos/<%= turma.curso.id %>/editar#assinaturas">padrão do curso</a>.<% } else { %>Esta turma tem escolha própria; marque igual ao <a href="/cursos/<%= turma.curso.id %>/editar#assinaturas">padrão do curso</a> para voltar a segui-lo.<% } %></p>
    <div class="adm-cert-assin-opcoes">
      <% ajustes.assinantes.forEach(function (a, i) { if (!a.nome) return; %>
        <label class="adm-cert-opcao">
          <input type="checkbox" name="assinatura" value="a<%= i %>" <%= escolha.includes('a' + i) ? 'checked' : '' %>>
          <span><b><%= a.nome %></b><small><%= a.cargo %></small></span>
        </label>
      <% }) %>
      <label class="adm-cert-opcao adm-cert-opcao-instrutor">
        <input type="checkbox" name="assinatura" value="instrutor" <%= escolha.includes('instrutor') ? 'checked' : '' %>>
        <span><b>Instrutor(a) da turma</b>
          <span class="adm-cert-instrutor">
            <input type="text" name="instrutorNome" maxlength="80" value="<%= turma.instrutorNome || '' %>" placeholder="Nome do(a) instrutor(a)" aria-label="Nome do instrutor">
            <input type="text" name="instrutorRegistro" maxlength="60" value="<%= turma.instrutorRegistro || '' %>" placeholder="Registro (ex.: COREN 477198-RJ)" aria-label="Registro do instrutor">
          </span>
        </span>
      </label>
    </div>
    <div class="adm-cert-assin-rodape">
      <button class="adm-pend-btn"><i class="fa-solid fa-floppy-disk"></i> Salvar assinaturas</button>
      <small class="adm-mut" id="assinConta"></small>
    </div>
  </div>
</form>

<p class="adm-hint adm-cert-redacao">
  <% if (redacaoLigada) { %>
    <i class="fa-solid fa-qrcode"></i> Cada certificado é registrado na Redação na primeira impressão: sai com o código de verificação e o QR code, e entra na trilha de auditoria.
  <% } else { %>
    <i class="fa-solid fa-circle-info"></i> O registro na Redação (código de verificação e QR code) ainda não está ligado: os certificados saem sem QR.
  <% } %>
</p>

<% if (pendencias.length) { %>
  <div class="adm-aviso adm-cert-pend">
    <p><i class="fa-solid fa-triangle-exclamation"></i> <b>Antes de imprimir:</b></p>
    <ul>
      <% pendencias.forEach(function (p) { %>
        <li><%= p.texto %><% if (p.link) { %> <a href="<%= p.link %>" class="adm-link">Preencher</a><% } %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<form method="GET" action="/turmas/<%= turma.id %>/certificados/imprimir" target="_blank" class="adm-box" id="formCert">
  <div class="adm-box-head">
    <h2 class="adm-h2"><i class="fa-solid fa-award"></i> Alunos com pagamento em dia (<%= aprovados.length %>)</h2>
    <% if (aprovados.length) { %>
      <button class="adm-btn" id="btnImprimir"><i class="fa-solid fa-print"></i> Imprimir selecionados</button>
    <% } %>
  </div>
  <% if (!aprovados.length) { %>
    <p class="adm-vazio">Nenhum aluno com o pagamento em dia nesta turma.</p>
  <% } else { %>
    <table class="adm-table adm-table-cards">
      <thead><tr><th><input type="checkbox" id="certTodos" checked aria-label="Marcar todos"></th><th>Aluno</th><th>Documento</th><% if (temNota) { %><th>Nota</th><% } %><th>Livro / Registro</th><th></th></tr></thead>
      <tbody>
        <% aprovados.forEach(function (m) { const doc = documentoAluno(m.aluno); %>
          <tr>
            <td><input type="checkbox" name="m" value="<%= m.id %>" checked aria-label="Imprimir <%= m.aluno.nome %>"></td>
            <td><strong><%= m.aluno.nome %></strong></td>
            <td><% if (doc) { %><small class="adm-mut"><%= doc.tipo %></small> <%= doc.numero %><% } else { %><span class="adm-txt-alerta">sem documento</span><% } %></td>
            <% if (temNota) { %><td><%= nota(m.nota) %></td><% } %>
            <td><% if (m.certRegistro) { %>Livro <%= m.certLivro %> · Nº <%= m.certRegistro %><small class="adm-mut adm-hz-contato">emitido em <%= new Date(m.certEmitidoEm).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></small>
                <% } else { %><span class="adm-mut">gerado ao imprimir</span><% } %></td>
            <td><a href="/turmas/<%= turma.id %>/certificados/imprimir?m=<%= m.id %>" target="_blank" class="adm-pend-btn"><i class="fa-solid fa-print"></i> Imprimir</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="adm-hint adm-cert-dica">Abre numa aba nova, já no tamanho A4 deitado: cada aluno tem frente e verso. Na impressora, escolha
      <b>frente e verso</b> virando pela <b>borda curta</b>. O Livro <%= ajustes.livro %> e o registro são gerados na primeira impressão e mantidos depois.
      <a href="/modelos?voltar=/turmas/<%= turma.id %>/certificados">Ajustes do certificado</a>.</p>
  <% } %>
</form>

<% if (outros.length) { %>
  <details class="adm-box adm-espaco adm-hz-faltam">
    <summary><i class="fa-solid fa-user-xmark"></i> <%= outros.length %> <%= outros.length === 1 ? 'aluno reprovado (sem certificado)' : 'alunos reprovados (sem certificado)' %></summary>
    <ul class="adm-bv-alunos">
      <% outros.forEach(function (m) { %>
        <li class="fraco"><span><%= m.aluno.nome %></span><em class="badge canc">reprovado</em></li>
      <% }) %>
    </ul>
  </details>
<% } %>

<script>
  (function () {
    var caixas = document.querySelectorAll('#formAssin input[name="assinatura"]'), conta = document.getElementById('assinConta');
    function atualizar() {
      var n = 0; caixas.forEach(function (c) { if (c.checked) n++; });
      caixas.forEach(function (c) { c.disabled = !c.checked && n >= <%= maxNoCertificado %>; });
      conta.textContent = n + ' de <%= maxNoCertificado %> marcadas';
    }
    caixas.forEach(function (c) { c.addEventListener('change', atualizar); });
    atualizar();
  })();
  (function () {
    var todos = document.getElementById('certTodos'); if (!todos) return;
    var caixas = document.querySelectorAll('#formCert input[name="m"]');
    var btn = document.getElementById('btnImprimir');
    function contar() { var n = 0; caixas.forEach(function (c) { if (c.checked) n++; }); btn.disabled = !n; btn.lastChild.textContent = ' Imprimir ' + (n === caixas.length ? 'todos' : n + ' selecionado' + (n === 1 ? '' : 's')); }
    todos.addEventListener('change', function () { caixas.forEach(function (c) { c.checked = todos.checked; }); contar(); });
    caixas.forEach(function (c) { c.addEventListener('change', contar); });
    contar();
  })();
</script>

<%- include('foot') %>
