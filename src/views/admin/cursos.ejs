<%- include('head', { titulo: 'Cursos' }) %>
<%- include('header', { ativo: 'cursos' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Cursos</h1>
  <span class="adm-mut">Total: <strong><%= total %></strong></span>
</div>

<% if (flash) { %>
  <div class="adm-ok">
    <i class="fa-solid fa-circle-check"></i> <%= flash %>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="adm-erro">
    <i class="fa-solid fa-circle-exclamation"></i> <%= erro %>
  </div>
<% } %>

<form method="GET" action="/cursos" class="adm-filtros">
  <% if (statusFiltro) { %><input type="hidden" name="status" value="<%= statusFiltro %>"><% } %>
  <label class="adm-campo cresce">
    <span>Buscar</span>
    <input type="text" name="q" value="<%= busca %>" placeholder="Nome do curso">
  </label>
  <button type="submit" class="adm-btn-neutro"><i class="fa-solid fa-magnifying-glass"></i> Buscar</button>
  <% if (pode('cursos:criar')) { %>
    <a href="/cursos/novo" class="adm-btn" data-criar><i class="fa-solid fa-plus"></i> Novo curso</a>
  <% } %>
</form>

<% var _q = busca ? 'q=' + encodeURIComponent(busca) : ''; var _filtros = [['', 'Todos', contagem.todos], ['ATIVO', 'No site', contagem.ativos], ['INATIVO', 'Fora do site', contagem.inativos]]; %>
<nav class="adm-abas" aria-label="Filtrar cursos">
  <% _filtros.forEach(function (f) { var u = '/cursos' + (f[0] ? '?status=' + f[0] + (_q ? '&' + _q : '') : (_q ? '?' + _q : '')); %>
    <a href="<%= u %>" class="adm-aba <%= (statusFiltro || '') === f[0] ? 'on' : '' %>">
      <%= f[1] %> · <%= f[2] %></a>
  <% }) %>
</nav>

<div class="adm-box">

  <% if (!cursos.length) { %>

    <p class="adm-vazio">

      <% if (busca) { %>

        Nenhum curso encontrado para essa busca.

      <% } else if (statusFiltro) { %>

        Nenhum curso
        <%= statusFiltro === 'ATIVO' ? 'visível no site' : 'oculto' %>.

      <% } else { %>

        Nenhum curso cadastrado.

        <% if (pode('cursos:gerenciar')) { %>
          <a href="/cursos/novo">Criar o primeiro</a>.
        <% } %>

      <% } %>

    </p>

  <% } else { %>

    <table class="adm-table adm-table-cards">

      <thead>
        <tr>
          <th>Curso</th>
          <th>Próximas turmas</th>
          <th>Site</th>
          <th>Falta</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% cursos.forEach(function (c) {
             const prox = c.turmas && c.turmas[0];
             const dt = d => { const x = new Date(d); return String(x.getUTCDate()).padStart(2, '0') + '/' + String(x.getUTCMonth() + 1).padStart(2, '0'); }; %>
        <tr>
          <td>
            <div class="adm-curso-cel">
              <% if (c.imagemUrl) { %>
                <img src="<%= c.imagemUrl %>" alt="" class="adm-curso-thumb" loading="lazy">
              <% } else { %>
                <span class="adm-curso-thumb vazio"><i class="fa-solid fa-image"></i></span>
              <% } %>
              <span>
                <strong><%= c.nome %></strong>
                <br><small class="adm-mut"><%= c.cargaHoraria %> h<%= c.categoria ? ' · ' + c.categoria : '' %></small>
              </span>
            </div>
          </td>
          <td>
            <%
              // Mostra as turmas abertas; sem nenhuma aberta, as confirmadas; sem essas, a última
              // concluída. Cada uma é um atalho para os alunos da turma.
              const podeAlunos = pode('aluno:gerenciar') || pode('painel:leitura');
              const todas = c.turmas || [];
              let mostrar = todas.filter(t => t.status === 'ABERTA');
              if (!mostrar.length) mostrar = todas.filter(t => t.status === 'CONFIRMADA');
              if (!mostrar.length) mostrar = todas.filter(t => t.status === 'ENCERRADA').slice(-1);
              const extra = mostrar.length > 3 ? mostrar.length - 3 : 0;
            %>
            <div class="adm-turmas-chips">
              <% mostrar.slice(0, 3).forEach(function (t) { const aberta = t.status === 'ABERTA'; %>
                <<%= podeAlunos ? 'a' : 'span' %><% if (podeAlunos) { %> href="/alunos?turma=<%= t.id %>"<% } %> class="adm-chip-turma <%= aberta ? '' : 'fechada' %>" title="<%= rotuloTurma(t.status) %> · <%= t._count.matriculas %> de <%= t.vagas %> vagas">
                  <b><i class="fa-regular fa-calendar"></i> <%= dt(t.inicioPrevisto) %></b>
                  <span><i class="fa-solid fa-user-group"></i> <%= t._count.matriculas %> de <%= t.vagas %> alunos</span>
                  <% if (!aberta) { %><em><%= rotuloTurma(t.status).toLowerCase() %></em><% } %>
                </<%= podeAlunos ? 'a' : 'span' %>>
              <% }) %>
              <% if (extra) { %><a href="/turmas" class="adm-chip-turma mais">+<%= extra %></a><% } %>
              <% if (!mostrar.length) { %><span class="adm-mut">nenhuma turma</span><% } %>
            </div>
            <% if (pode('turmas:gerenciar')) { %>
              <a href="/turmas/nova?curso=<%= c.id %>" class="adm-link adm-nova-turma"><i class="fa-solid fa-plus"></i> Nova turma</a>
            <% } %>
          </td>
          <td>
            <% if (c.ativo) { %>
              <span class="badge ok" title="Aparece no site da escola">No site</span>
            <% } else { %>
              <span class="badge mut" title="Não aparece no site da escola">Fora do site</span>
            <% } %>
          </td>
          <td>
            <% if ((c.faltas || []).length) { c.faltas.forEach(function (f) { %><span class="adm-falta"><%= f %></span> <% }) } else { %><span class="adm-mut">—</span><% } %>
          </td>
          <td class="adm-acoes">
            <% if (pode('cursos:gerenciar')) { %>
              <a href="/cursos/<%= c.id %>" class="adm-pend-btn">
                Abrir <i class="fa-solid fa-arrow-right"></i></a>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>

  <% } %>

</div>

<%- include('foot') %>