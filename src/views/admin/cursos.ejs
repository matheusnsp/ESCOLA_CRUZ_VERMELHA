<%- include('head', { titulo: 'Cursos' }) %>
<%- include('header', { ativo: 'cursos' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Cursos</h1>
  <span class="adm-mut">Total: <strong><%= total %></strong></span>
</div>

<% if (flash) { %>
  <div class="adm-ok">
    <i class="fa-solid fa-circle-check"></i> <%= flash %>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="adm-erro">
    <i class="fa-solid fa-circle-exclamation"></i> <%= erro %>
  </div>
<% } %>

<form method="GET" action="/cursos" class="adm-filtros">

  <label class="adm-campo cresce">
    <span>Buscar</span>
    <input
      type="text"
      name="q"
      value="<%= busca %>"
      placeholder="Nome do curso"
    >
  </label>

  <label class="adm-campo">
    <span>No site</span>
    <select name="status">
      <option value="">Todos</option>

      <option value="ATIVO" <%= statusFiltro === 'ATIVO' ? 'selected' : '' %>>
        Visíveis no site
      </option>

      <option value="INATIVO" <%= statusFiltro === 'INATIVO' ? 'selected' : '' %>>
        Ocultos
      </option>
    </select>
  </label>

  <button type="submit" class="adm-btn-neutro">
    <i class="fa-solid fa-filter"></i> Filtrar
  </button>

  <% if (pode('cursos:gerenciar')) { %>
    <a href="/cursos/novo" class="adm-btn">
      <i class="fa-solid fa-plus"></i> Novo curso
    </a>
  <% } %>

</form>

<div class="adm-box">

  <% if (!cursos.length) { %>

    <p class="adm-vazio">

      <% if (busca) { %>

        Nenhum curso encontrado para essa busca.

      <% } else if (statusFiltro) { %>

        Nenhum curso
        <%= statusFiltro === 'ATIVO' ? 'visível no site' : 'oculto' %>.

      <% } else { %>

        Nenhum curso cadastrado.

        <% if (pode('cursos:gerenciar')) { %>
          <a href="/cursos/novo">Criar o primeiro</a>.
        <% } %>

      <% } %>

    </p>

  <% } else { %>

    <table class="adm-table adm-table-cards">

      <thead>
        <tr>
          <th>Curso</th>
          <th>Carga</th>
          <th>Valores</th>
          <th>Turmas</th>
          <th>No site</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% cursos.forEach(function (c) {
             const prox = c.turmas && c.turmas[0];
             const dt = d => { const x = new Date(d); return String(x.getUTCDate()).padStart(2, '0') + '/' + String(x.getUTCMonth() + 1).padStart(2, '0'); }; %>
        <tr>
          <td>
            <div class="adm-curso-cel">
              <% if (c.imagemUrl) { %>
                <img src="<%= c.imagemUrl %>" alt="" class="adm-curso-thumb" loading="lazy">
              <% } else { %>
                <span class="adm-curso-thumb vazio"><i class="fa-solid fa-image"></i></span>
              <% } %>
              <span>
                <strong><%= c.nome %></strong>
                <% if (c.escolaridadeMinima) { %><br><small class="adm-mut"><%= c.escolaridadeMinima %></small><% } %>
              </span>
            </div>
          </td>
          <td><%= c.cargaHoraria %>h</td>
          <td>
            <%- include('valores-curso', { v: c.valores, compacto: true }) %>
          </td>
          <td>
            <%
              // Cada turma por começar é um atalho para a lista de alunos dela.
              const podeAlunos = pode('aluno:gerenciar') || pode('painel:leitura');
            %>
            <div class="adm-turmas-chips">
              <% (c.turmas || []).slice(0, 3).forEach(function (t) { %>
                <<%= podeAlunos ? 'a' : 'span' %><% if (podeAlunos) { %> href="/alunos?turma=<%= t.id %>"<% } %> class="adm-chip-turma" title="<%= rotuloTurma(t.status) %> · <%= t._count.matriculas %> de <%= t.vagas %> vagas">
                  <b><%= dt(t.inicioPrevisto) %></b> <span><%= t._count.matriculas %>/<%= t.vagas %></span>
                </<%= podeAlunos ? 'a' : 'span' %>>
              <% }) %>
              <% if (c.turmas && c.turmas.length > 3) { %>
                <a href="/turmas" class="adm-chip-turma mais">+<%= c.turmas.length - 3 %></a>
              <% } %>
              <% if (!(c.turmas && c.turmas.length)) { %>
                <span class="adm-mut">nenhuma aberta<% if (c._count.turmas) { %> · <%= c._count.turmas %> no histórico<% } %></span>
              <% } %>
            </div>
            <% if (pode('turmas:gerenciar')) { %>
              <a href="/turmas/nova?curso=<%= c.id %>" class="adm-link adm-nova-turma"><i class="fa-solid fa-plus"></i> Nova turma</a>
            <% } %>
          </td>
          <td>
            <% if (c.ativo) { %>
              <span class="badge ok" title="Aparece no site da escola">Visível</span>
            <% } else { %>
              <span class="badge mut" title="Não aparece no site da escola">Oculto</span>
            <% } %>
          </td>
          <td class="adm-acoes">
            <% if (pode('cursos:gerenciar')) { %>
              <div class="adm-pend-acoes">
                <a href="/cursos/<%= c.id %>/editar" class="adm-pend-btn"><i class="fa-solid fa-pen"></i> Editar</a>
                <form method="POST" action="/cursos/<%= c.id %>/ativar"
                      data-confirmar="<%= c.ativo ? 'Ocultar ' + c.nome + ' do site? As turmas e matrículas continuam; o curso só deixa de aparecer para os alunos.' : 'Mostrar ' + c.nome + ' no site da escola?' %>"
                      data-botao="<%= c.ativo ? 'Ocultar do site' : 'Mostrar no site' %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <% if (statusFiltro) { %><input type="hidden" name="status" value="<%= statusFiltro %>"><% } %>
                  <% if (busca) { %><input type="hidden" name="q" value="<%= busca %>"><% } %>
                  <button class="adm-pend-btn"><i class="fa-solid <%= c.ativo ? 'fa-eye-slash' : 'fa-eye' %>"></i> <%= c.ativo ? 'Ocultar' : 'Mostrar' %></button>
                </form>
                <% if (!c._count.turmas) { %>
                  <form method="POST" action="/cursos/<%= c.id %>/excluir"
                        data-confirmar="Excluir o curso <%= c.nome %>? Não dá para desfazer." data-botao="Excluir">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <% if (statusFiltro) { %><input type="hidden" name="status" value="<%= statusFiltro %>"><% } %>
                    <% if (busca) { %><input type="hidden" name="q" value="<%= busca %>"><% } %>
                    <button class="adm-pend-btn perigo"><i class="fa-solid fa-trash"></i> Excluir</button>
                  </form>
                <% } %>
              </div>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>

  <% } %>

</div>

<%- include('foot') %>