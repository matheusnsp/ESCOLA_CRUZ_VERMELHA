<%- include('head', { titulo: 'Financeiro' }) %>
<%- include('header', { ativo: 'financeiro' }) %>

<%
// Formata uma data (Date | string) no fuso de Brasília, dd/mm/aaaa.
function dataBR(d) {
  if (!d) return '—';
  return new Date(d).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });
}

// 💡 PERMISSÕES — esta tela distingue três níveis:
//
//   financeiro:leitura      entra aqui e vê tudo (Coordenador, Financeiro, Dev)
//   relatorio:baixar        exporta Excel/PDF/CSV/OFX (Coordenador, Financeiro, Dev)
//   financeiro:reembolsar   estorna e marca reembolso concluído (Financeiro, Dev)
//
// Uma tabela só de pagamentos (uma linha por matrícula), em vez de "Taxa paga" e "Matrículas
// geradas" repetindo as mesmas pessoas. O que ainda não foi pago fica na tela Pendentes.
const ROTULO = { curso: 'Matrícula + inscrição', taxa: 'Só a inscrição', estornado: 'Estornado' };
const BADGE  = { curso: 'ok', taxa: 'pend', estornado: 'est' };
const conta  = { curso: 0, taxa: 0, estornado: 0 };
pagamentos.forEach(p => { conta[p.tipo]++; });
%>

<div class="adm-h1-row">
  <h1 class="adm-h1">Financeiro</h1>
  <% if (pode('relatorio:baixar')) { %>
    <details class="adm-exportar">
      <summary class="adm-btn-sec"><i class="fa-solid fa-download"></i> Exportar <i class="fa-solid fa-chevron-down adm-exportar-seta"></i></summary>
      <div class="adm-exportar-menu">
        <a href="/relatorios/completo.xlsx"><i class="fa-solid fa-file-excel"></i><span><b>Excel</b><small>planilha completa</small></span></a>
        <a href="/relatorios/completo.pdf"><i class="fa-solid fa-file-pdf"></i><span><b>PDF</b><small>para imprimir</small></span></a>
        <a href="/relatorios/completo.csv"><i class="fa-solid fa-file-csv"></i><span><b>CSV</b><small>dados em texto</small></span></a>
        <%
          // OFX: extrato para o contador importar no sistema contábil (lido por máquina).
        %>
        <a href="/relatorios/completo.ofx"><i class="fa-solid fa-file-invoice-dollar"></i><span><b>OFX</b><small>extrato para o contador</small></span></a>
      </div>
    </details>
  <% } %>
</div>

<% if (flash) { %><div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= flash %></div><% } %>
<% if (erro)  { %><div class="adm-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div><% } %>

<!-- ═══ Recebido por conta (lib/financeiro-contas.js): só o total de cada conta ═══ -->
<%
  var CONTAS_FIN = ['principal', 'segunda', 'manual'];
  var ICONE_CONTA = { principal: 'fa-globe', segunda: 'fa-bolt', manual: 'fa-cash-register' };
  var DICA_CONTA = {
    principal: 'pago online no site da escola',
    segunda: 'inscrições da matrícula rápida, no site da instituição',
    manual: 'maquininha ou PIX direto, confirmado pela secretaria',
  };
%>
<div class="fin-contas-tit">
  <h2><i class="fa-solid fa-building-columns"></i> Recebido por conta</h2>
  <span>Escolha uma conta para ver o total e filtrar os pagamentos</span>
</div>
<div class="fin-contas" role="tablist" aria-label="Escolher a conta">
  <a href="/financeiro" class="fin-conta <%= contaFiltro === 'todas' ? 'on' : '' %>" role="tab" aria-selected="<%= contaFiltro === 'todas' %>">
    <small><i class="fa-solid fa-layer-group"></i> Todas as contas</small>
    <b><%= formatBRL(recebidoPorConta.principal + recebidoPorConta.segunda + recebidoPorConta.manual) %></b>
    <span>recebido no total</span>
    <em class="fin-conta-acao"><%- contaFiltro === 'todas' ? '<i class="fa-solid fa-circle-check"></i> Mostrando' : 'Ver todas →' %></em>
  </a>
  <% CONTAS_FIN.forEach(function (id) { %>
    <a href="/financeiro?conta=<%= id %>" class="fin-conta <%= contaFiltro === id ? 'on' : '' %>" role="tab" aria-selected="<%= contaFiltro === id %>">
      <small><i class="fa-solid <%= ICONE_CONTA[id] %>"></i> <%= nomesContas[id] %></small>
      <b><%= formatBRL(recebidoPorConta[id]) %></b>
      <span><%= DICA_CONTA[id] %></span>
      <em class="fin-conta-acao"><%- contaFiltro === id ? '<i class="fa-solid fa-circle-check"></i> Mostrando' : 'Ver só esta →' %></em>
    </a>
  <% }) %>
</div>
<% if (contaFiltro !== 'todas') { %>
  <p class="fin-filtro-aviso"><i class="fa-solid fa-filter"></i> Mostrando a conta <b><%= nomesContas[contaFiltro] %></b>: abaixo, só as matrículas que tiveram pagamento nela, com o valor total de cada uma (quem pagou parte em outra conta, como na matrícula rápida, aparece nas duas). <a href="/financeiro">Ver todas</a></p>
<% } %>

<!-- ═══ Resumo ═══════════════════════════════════════════════════════════ -->
<div class="adm-cards c3">
  <div class="adm-stat ok">
    <span><%= formatBRL(stats.totalRecebido) %></span>
    <small><i class="fa-solid fa-sack-dollar"></i> Recebido</small>
    <small class="adm-stat-sub"><%= conta.curso %> matrícula(s) paga(s) · <%= conta.taxa %> só com a inscrição</small>
  </div>
  <a class="adm-stat warn adm-stat-link" href="/pendentes">
    <span><%= formatBRL(stats.totalPendente) %></span>
    <small><i class="fa-solid fa-clock"></i> A receber</small>
    <small class="adm-stat-sub"><%= aReceberCount %> com inscrição paga e matrícula pendente · ver Pendentes →</small>
  </a>
  <div class="adm-stat">
    <span><%= formatBRL(stats.totalEstornado) %></span>
    <small><i class="fa-solid fa-rotate-left"></i> Estornado</small>
    <small class="adm-stat-sub"><%= stats.estornosCount %> estorno(s)</small>
  </div>
</div>

<!-- ═══ Reembolsos pendentes: só aparece quando existe algum ═════════════ -->
<% if (reembolsosPendentesLista.length) { %>
<div class="adm-box adm-espaco adm-box-alerta">
  <div class="adm-box-head">
    <h2><i class="fa-solid fa-money-bill-transfer"></i> Reembolsos a fazer</h2>
    <span class="badge canc"><%= stats.reembolsosCount %> · <%= formatBRL(stats.totalAReembolsar) %></span>
  </div>
  <table class="adm-table adm-table-cards">
    <thead>
      <tr><th>Aluno</th><th>Curso</th><th>Valor</th><th>Ação</th></tr>
    </thead>
    <tbody>
      <% reembolsosPendentesLista.forEach((m) => { %>
      <tr>
        <td><strong><%= m.aluno.nome %></strong></td>
        <td><%= m.turma.curso.nome %></td>
        <td><strong><%= formatBRL(Math.abs(Number(m.diferencaTransferencia))) %></strong></td>
        <td>
          <% if (pode('financeiro:reembolsar')) { %>
            <form method="POST" action="/inscricoes/<%= m.id %>/reembolso-concluido"
                  data-confirmar="Confirmar que o reembolso foi realizado?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="adm-btn-sec adm-btn-mini"><i class="fa-solid fa-check"></i> Marcar como feito</button>
            </form>
          <% } else { %>
            <span class="adm-mut">Aguardando o financeiro</span>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<!-- ═══ Pagamentos ═══════════════════════════════════════════════════════ -->
<div class="adm-box" id="pagamentos">
  <div class="adm-box-head adm-fin-head">
    <h2><i class="fa-solid fa-receipt"></i> Pagamentos</h2>
    <input type="search" class="adm-fin-busca" id="finBusca" placeholder="Buscar aluno ou curso" aria-label="Buscar aluno ou curso">
  </div>

  <div class="adm-abas adm-fin-abas" role="tablist">
    <button type="button" class="adm-aba on" data-filtro="todos">Todos <span class="adm-aba-num"><%= pagamentos.length %></span></button>
    <button type="button" class="adm-aba" data-filtro="curso">Matrícula paga <span class="adm-aba-num"><%= conta.curso %></span></button>
    <button type="button" class="adm-aba" data-filtro="taxa">Só a inscrição <span class="adm-aba-num"><%= conta.taxa %></span></button>
    <button type="button" class="adm-aba" data-filtro="estornado">Estornados <span class="adm-aba-num"><%= conta.estornado %></span></button>
  </div>

  <% if (!pagamentos.length) { %>
    <p class="adm-vazio">Nenhum pagamento recebido ainda.</p>
  <% } else { %>
    <table class="adm-table adm-table-cards">
      <thead>
        <tr><th>Aluno</th><th>Curso</th><th>Pagou</th><th>Data</th><th>Valor</th><th>Ação</th></tr>
      </thead>
      <tbody id="finLinhas">
        <% pagamentos.forEach((p) => { const m = p.m; %>
        <tr data-tipo="<%= p.tipo %>" data-busca="<%= (m.aluno.nome + ' ' + m.aluno.email + ' ' + m.turma.curso.nome).toLowerCase() %>">
          <td>
            <strong><%= m.aluno.nome %></strong>
            <% if (p.tipo === 'curso') { %><br><span class="badge mut"><%= codigoMatricula(m) %></span><% } %>
            <% if (valorMatricula(m).rapida) { %><span class="adm-tag-rapida" title="Taxa de inscrição paga na matrícula rápida (site da instituição)"><i class="fa-solid fa-bolt"></i> Matrícula rápida</span><% } %>
          </td>
          <td><%= m.turma.curso.nome %></td>
          <td>
            <span class="badge <%= BADGE[p.tipo] %>"><%= ROTULO[p.tipo] %></span>
            <% if (p.tipo !== 'estornado' && m.forma) { %><br><small class="adm-mut"><%= m.forma === 'PIX' ? 'PIX' : 'Cartão' %><%= m.statusPagamento === 'PARCELADO' ? ' · parcelado' : '' %></small><% } %>
            <% if (p.tipo === 'estornado') { %><br><small class="adm-mut"><%= motivos[m.id] || 'Motivo não informado' %></small><% } %>
          </td>
          <td><%= dataBR(p.data) %></td>
          <td><strong><%= formatBRL(p.valor) %></strong></td>
          <td>
            <%
              // Estorno devolve dinheiro e é irreversível: só Financeiro e Dev.
              // O Coordenador vê a linha, mas não a ação.
            %>
            <% if (p.tipo === 'curso' && pode('financeiro:reembolsar')) { %>
              <% if (m.forma === 'PIX') { %>
                <span class="adm-aviso-cel"
                      title="Reembolsos de PIX precisam ser feitos manualmente pelo painel da Únicopag">
                  <i class="fa-solid fa-triangle-exclamation"></i> PIX: estornar na Únicopag
                </span>
              <% } else { %>
                <form method="POST" action="/inscricoes/<%= m.id %>/estornar"
                      data-confirmar="Estornar <%= formatBRL(p.valor) %> de <%= m.aluno.nome %> (<%= m.turma.curso.nome %>)? O valor volta para o aluno e não dá para desfazer."
                      data-motivo="Motivo do estorno" data-contabil data-botao="Estornar">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="adm-link-perigo"><i class="fa-solid fa-rotate-left"></i> Estornar</button>
                </form>
              <% } %>
            <% } else { %>
              <span class="adm-mut">—</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="adm-vazio" id="finNada" hidden>Nenhum pagamento com esse filtro.</p>
    <button type="button" class="adm-vermais" id="finMais" hidden>Ver mais</button>
  <% } %>
</div>

<script>
  // Filtro por aba + busca, no navegador (a lista já veio inteira). Mostra 25 por vez.
  (function () {
    var linhas = Array.prototype.slice.call(document.querySelectorAll('#finLinhas tr'));
    if (!linhas.length) return;
    var abas = document.querySelectorAll('.adm-fin-abas .adm-aba');
    var busca = document.getElementById('finBusca');
    var mais = document.getElementById('finMais');
    var nada = document.getElementById('finNada');
    var POR_VEZ = 25, limite = POR_VEZ, filtro = 'todos';

    function aplicar() {
      var termo = (busca.value || '').trim().toLowerCase();
      var achadas = linhas.filter(function (tr) {
        return (filtro === 'todos' || tr.dataset.tipo === filtro) && (!termo || tr.dataset.busca.indexOf(termo) !== -1);
      });
      linhas.forEach(function (tr) { tr.hidden = true; });
      achadas.slice(0, limite).forEach(function (tr) { tr.hidden = false; });
      nada.hidden = achadas.length > 0;
      mais.hidden = achadas.length <= limite;
      mais.textContent = 'Ver mais ' + Math.min(POR_VEZ, achadas.length - limite);
    }

    abas.forEach(function (a) {
      a.addEventListener('click', function () {
        abas.forEach(function (b) { b.classList.toggle('on', b === a); });
        filtro = a.dataset.filtro; limite = POR_VEZ; aplicar();
      });
    });
    busca.addEventListener('input', function () { limite = POR_VEZ; aplicar(); });
    mais.addEventListener('click', function () { limite += POR_VEZ; aplicar(); });
    aplicar();
  })();
</script>

<%- include('foot') %>
