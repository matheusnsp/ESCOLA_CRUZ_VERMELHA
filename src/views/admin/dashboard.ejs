<%- include('head', { titulo: 'Painel' }) %>
<%- include('header', { ativo: 'home' }) %>

<%
  // Cada cartão e link só aparece (ou só vira link) se a pessoa puder abrir o destino, com as
  // mesmas permissões das rotas: /financeiro, /pendentes, /inscricoes, /turmas.
  const podeDinheiro = pode('financeiro:leitura') || pode('financeiro:aprovar');
  const podePend = pode('pendentes:gerenciar');
  const podeMatriculas = pode('doacao:confirmar') || pode('financeiro:aprovar') || pode('financeiro:leitura');
  const podeTurmas = pode('turmas:gerenciar') || pode('painel:leitura');
  const podeAlunos = pode('aluno:gerenciar') || pode('painel:leitura');
  const podeRapida = podeTurmas && mr.ok;
  const temAgir = podePend || podeDinheiro || podeRapida;
  const inscHoje = hoje.matriculasHoje + (mr.ok ? mr.hoje : 0);
  const inscSemana = hoje.matriculasSemana + (mr.ok ? mr.semana : 0);
  const hojeTxt = new Date().toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Sao_Paulo' });
  function dataUTC(d) { const x = new Date(d); const p = n => String(n).padStart(2, '0'); return p(x.getUTCDate()) + '/' + p(x.getUTCMonth() + 1); }
%>
<div class="adm-h1-row">
  <div>
    <h1 class="adm-h1">Painel</h1>
    <p class="adm-mut adm-painel-data"><%= hojeTxt.charAt(0).toUpperCase() + hojeTxt.slice(1) %></p>
  </div>
  <div class="adm-painel-agora">
    <button type="button" class="adm-pend-btn" id="cardAlunosOnline"><span class="adm-ponto-on"></span> <b id="alunosOnline"><%= stats.alunosOnline %></b> online agora</button>
    <button type="button" class="adm-pend-btn" id="cardAlunosHoje"><i class="fa-solid fa-right-to-bracket"></i> <b><%= stats.alunosHoje %></b> entraram hoje</button>
    <% if (visitas) { %><button type="button" class="adm-pend-btn" id="cardVisitas" title="Pessoas sem login que abriram o site hoje"><i class="fa-regular fa-eye"></i> <b><%= visitas.hoje %></b> visitantes hoje</button><% } %>
  </div>
</div>

<% if (typeof comprovantesParaConferir !== 'undefined' && comprovantesParaConferir && pode('aluno:gerenciar')) { %>
  <a href="/comprovantes-saude" class="adm-alerta adm-alerta-comprovante">
    <i class="fa-solid fa-user-doctor"></i>
    <span><%= comprovantesParaConferir %> comprovante<%= comprovantesParaConferir > 1 ? 's' : '' %> da área da saúde para conferir</span>
    <i class="fa-solid fa-arrow-right"></i>
  </a>
<% } %>

<!-- ═══ O dia em números ═════════════════════════════════════════════════ -->
<div class="adm-cards <%= podeDinheiro ? 'c3' : (podePend ? 'c2' : 'c1') %>">
  <<%= podeMatriculas ? 'a' : 'div' %><% if (podeMatriculas) { %> href="/inscricoes"<% } %> class="adm-stat <%= podeMatriculas ? 'adm-stat-clicavel' : '' %>">
    <span><%= inscHoje %></span>
    <small><i class="fa-solid fa-user-plus"></i> Inscrições hoje</small>
    <small class="adm-stat-sub"><%= inscSemana %> nos últimos 7 dias<% if (mr.ok && mr.semana) { %> · <%= mr.semana %> pela matrícula rápida<% } %></small>
  </<%= podeMatriculas ? 'a' : 'div' %>>
  <% if (podeDinheiro) { %>
  <a href="/financeiro" class="adm-stat ok adm-stat-clicavel">
    <span><%= formatBRL(hoje.recebidoMes) %></span>
    <small><i class="fa-solid fa-sack-dollar"></i> Recebido em <%= hoje.mesNome %></small>
    <small class="adm-stat-sub">matrículas e inscrições confirmadas no mês<%= mr.ok && mr.recebidoMes ? ', com a matrícula rápida' : '' %></small>
  </a>
  <% } %>
  <% if (podeDinheiro || podePend) { %>
  <a href="<%= podePend ? '/pendentes' : '/financeiro' %>" class="adm-stat warn adm-stat-clicavel">
    <span><%= formatBRL(hoje.emAberto) %></span>
    <small><i class="fa-solid fa-clock"></i> A receber</small>
    <small class="adm-stat-sub"><%= hoje.emAbertoCount %> com inscrição paga e matrícula pendente</small>
  </a>
  <% } %>
</div>

<div class="adm-painel-grade <%= temAgir ? '' : 'so-turmas' %>">

  <!-- ═══ Próximas turmas ═══════════════════════════════════════════════ -->
  <div class="adm-box">
    <div class="adm-box-head">
      <h2><i class="fa-solid fa-calendar-days"></i> Próximas turmas <span class="adm-mut adm-h2-sub"><%= stats.cursosAtivos %> de <%= stats.totalCursos %> cursos no site</span></h2>
      <% if (podeTurmas) { %><a href="/turmas" class="adm-link">Ver turmas</a><% } %>
    </div>
    <% if (!proximasTurmas.length) { %>
      <p class="adm-vazio">Nenhuma turma aberta com data futura.</p>
    <% } else { %>
      <ul class="adm-turmas-lista">
        <% proximasTurmas.forEach(function (t) {
             const insc = t._count.matriculas;
             const pct = t.vagas ? Math.min(100, Math.round(insc / t.vagas * 100)) : 0;
             const faltam = Math.ceil((new Date(t.inicioPrevisto) - Date.now()) / 86400000);
             const abaixoMin = t.minimoAlunos && insc < t.minimoAlunos; %>
          <li>
            <<%= podeAlunos ? 'a' : 'div' %><% if (podeAlunos) { %> href="/alunos?turma=<%= t.id %>"<% } %> class="adm-turma-item">
              <div class="adm-turma-data"><b><%= dataUTC(t.inicioPrevisto).slice(0, 2) %></b><span><%= new Date(t.inicioPrevisto).toLocaleDateString('pt-BR', { month: 'short', timeZone: 'UTC' }).replace('.', '') %></span></div>
              <div class="adm-turma-info">
                <strong><%= t.curso.nome %></strong>
                <small class="adm-mut">
                  <%= faltam <= 0 ? 'começa hoje' : 'em ' + faltam + (faltam === 1 ? ' dia' : ' dias') %>
                  <% if (t.aulas && t.aulas[0]) { %> · <%= t.aulas[0].horario %><% } %>
                  · <%= rotuloTurma(t.status).toLowerCase() %>
                </small>
                <% if (t.pag) { %><small class="adm-pag-divisao"><b><%= t.pag.matricula %></b> pagaram a inscrição · <b><%= t.pag.tudo %></b> pagaram a matrícula</small><% } %>
                <div class="adm-barra" title="<%= insc %> de <%= t.vagas %> vagas"><span class="<%= abaixoMin ? 'baixa' : '' %>" style="width: <%= pct %>%"></span></div>
              </div>
              <div class="adm-turma-vagas">
                <b><%= insc %>/<%= t.vagas %></b>
                <small class="<%= abaixoMin ? 'adm-txt-alerta' : 'adm-mut' %>"><%= abaixoMin ? 'mín. ' + t.minimoAlunos : 'vagas' %></small>
              </div>
            </<%= podeAlunos ? 'a' : 'div' %>>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <!-- ═══ Para agir (só para quem pode abrir Pendentes ou Financeiro) ═══ -->
  <% if (temAgir) { %>
  <div class="adm-box">
    <div class="adm-box-head">
      <h2><i class="fa-solid fa-list-check"></i> Para agir</h2>
    </div>
    <ul class="adm-agir">
      <% if (podeRapida) { %>
      <li><a href="/matricula-rapida">
        <span class="adm-agir-num <%= mr.aguardando ? 'warn' : '' %>"><%= mr.aguardando %></span>
        <span><b>Matrícula rápida sem turma</b><small class="adm-mut">pagaram no site da instituição, falta encaixar</small></span>
        <i class="fa-solid fa-chevron-right"></i></a></li>
      <% } %>
      <% if (podePend) { %>
      <li><a href="/pendentes?aba=com-taxa">
        <span class="adm-agir-num <%= hoje.emAbertoCount ? 'warn' : '' %>"><%= hoje.emAbertoCount %></span>
        <span><b>Inscrição paga, matrícula pendente</b><small class="adm-mut">vaga reservada, falta pagar a matrícula</small></span>
        <i class="fa-solid fa-chevron-right"></i></a></li>
      <li><a href="/pendentes?aba=sem-taxa">
        <span class="adm-agir-num"><%= hoje.pararamAntes %></span>
        <span><b>Pararam antes de pagar</b><small class="adm-mut">turma ainda não começou</small></span>
        <i class="fa-solid fa-chevron-right"></i></a></li>
      <% } %>
      <% if (podeDinheiro) { %>
      <li><a href="/financeiro">
        <span class="adm-agir-num <%= hoje.reembolsos ? 'perigo' : '' %>"><%= hoje.reembolsos %></span>
        <span><b>Reembolsos a fazer</b><small class="adm-mut">diferença de transferência a devolver</small></span>
        <i class="fa-solid fa-chevron-right"></i></a></li>
      <% } %>
    </ul>
  </div>
  <% } %>

</div>

<!-- ========================================================= -->
<!-- Modal: alunos que entraram hoje -->
<!-- ========================================================= -->

<div id="modalAlunosHoje" class="adm-modal-overlay">
  <% // Mesmo desenho da janela de visitantes; o "hoje" vem do banco (login ou cadastro no dia) e o
     // histórico dos 7 dias, da contagem do site (lib/visitas.js), que começou a valer agora.
     var va = visitasAlunos ? JSON.parse(JSON.stringify(visitasAlunos)) : null;
     if (va) { va.dias[6].unicos = Math.max(va.dias[6].unicos, stats.alunosHoje); va.semana = va.dias.reduce(function (t, d) { return t + d.unicos; }, 0); }
     var maxA = va ? Math.max(1, ...va.dias.map(function (d) { return d.unicos; })) : 1; %>
  <div class="adm-modal">
    <div class="adm-modal-head">
      <div>
        <h2>Alunos no site</h2>
        <small class="vis-sub">alunos com login (quem entra sem login aparece em "visitantes")</small>
      </div>
      <button type="button" id="fecharModalAlunosHoje" class="adm-modal-close" aria-label="Fechar">&times;</button>
    </div>
    <div class="adm-modal-body vis-corpo">
      <div class="vis-nums">
        <div><b><%= stats.alunosOnline %></b><span>online agora</span></div>
        <div><b><%= va ? va.dias[6].unicos : stats.alunosHoje %></b><span>usaram o site hoje</span></div>
        <div><b><%= va ? va.dias[6].paginas : '—' %></b><span>páginas abertas hoje</span></div>
        <div><b><%= va ? va.semana : '—' %></b><span>nos últimos 7 dias</span></div>
      </div>
      <% if (va) { %>
      <ul class="vis-dias">
        <% va.dias.forEach(function (d, i) { var dt = new Date(d.dia + 'T12:00:00-03:00'); %>
          <li class="<%= i === 6 ? 'hoje' : '' %>">
            <span class="vis-dia"><%= i === 6 ? 'Hoje' : dt.toLocaleDateString('pt-BR', { weekday: 'short', day: '2-digit', month: '2-digit', timeZone: 'America/Sao_Paulo' }).replace('.', '') %></span>
            <span class="vis-barra"><span style="width: <%= Math.round(d.unicos / maxA * 100) %>%"></span></span>
            <b><%= d.unicos %></b>
          </li>
        <% }) %>
      </ul>
      <% } %>
      <h3 class="vis-lista-tit">Quem fez login hoje <small>(<%= stats.alunosHoje %>)</small></h3>
      <% if (!alunosHojeLista.length) { %>

        <p class="adm-vazio">
          Ninguém entrou hoje ainda.
        </p>

      <% } else { %>

        <table class="adm-table">

          <thead>
            <tr>
              <th>Nome</th>
              <th>E-mail</th>
              <th>Horário</th>
            </tr>
          </thead>

          <tbody>

            <% alunosHojeLista.forEach(function(a){ %>

              <tr>

                <td>
                  <!-- 💡 Trocado /alunos/:id/editar por /alunos/:id/matriculas:
                       essa rota aceita tanto 'aluno:gerenciar' quanto
                       'painel:leitura', então não quebra pra quem só tem
                       leitura (editar exige 'aluno:gerenciar' e dava 403). -->
                  <a href="/alunos/<%= a.id %>/matriculas" class="adm-link-aluno">
                    <strong><%= a.nome %></strong>
                  </a>
                </td>

                <td>
                  <%= a.email %>
                </td>

                <td>
                  <% const quando = a.ultimoLogin || a.criadoEm; %>
                  <% if (quando) { %>
                    <%= new Date(quando).toLocaleTimeString('pt-BR', {
                      timeZone: 'America/Sao_Paulo',
                      hour: '2-digit',
                      minute: '2-digit'
                    }) %>
                    <% if (!a.ultimoLogin) { %>
                      <small class="adm-badge-sutil">(cadastro)</small>
                    <% } %>
                  <% } else { %>
                    —
                  <% } %>
                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      <% } %>

    </div>

  </div>

</div>


<% if (visitas) { var maxV = Math.max(1, ...visitas.dias.map(function (d) { return d.unicos; })); %>
<div id="modalVisitas" class="adm-modal-overlay">
  <div class="adm-modal">
    <div class="adm-modal-head">
      <div>
        <h2>Visitantes do site</h2>
        <small class="vis-sub">pessoas sem login (quem tem login aparece em "online agora" e "entraram hoje")</small>
      </div>
      <button type="button" id="fecharModalVisitas" class="adm-modal-close" aria-label="Fechar">&times;</button>
    </div>
    <div class="adm-modal-body vis-corpo">
      <div class="vis-nums">
        <div><b><%= visitas.agora %></b><span>no site agora</span></div>
        <div><b><%= visitas.hoje %></b><span>visitantes hoje</span></div>
        <div><b><%= visitas.paginasHoje %></b><span>páginas abertas hoje</span></div>
        <div><b><%= visitas.semana %></b><span>nos últimos 7 dias</span></div>
      </div>
      <ul class="vis-dias">
        <% visitas.dias.forEach(function (d, i) { var dt = new Date(d.dia + 'T12:00:00-03:00'); %>
          <li class="<%= i === 6 ? 'hoje' : '' %>">
            <span class="vis-dia"><%= i === 6 ? 'Hoje' : dt.toLocaleDateString('pt-BR', { weekday: 'short', day: '2-digit', month: '2-digit', timeZone: 'America/Sao_Paulo' }).replace('.', '') %></span>
            <span class="vis-barra"><span style="width: <%= Math.round(d.unicos / maxV * 100) %>%"></span></span>
            <b><%= d.unicos %></b>
          </li>
        <% }) %>
      </ul>
      <p class="vis-nota">Contagem anônima, sem cookie e sem guardar IP; robôs e buscadores ficam de fora. O número é aproximado.</p>
    </div>
  </div>
</div>
<% } %>

<!-- ========================================================= -->
<!-- Modal: alunos online agora -->
<!-- ========================================================= -->

<div id="modalAlunosOnline" class="adm-modal-overlay">

  <div class="adm-modal">

    <div class="adm-modal-head">

      <div>
        <h2>
          Alunos online agora
          (<span id="qtdOnlineModal"><%= stats.alunosOnline %></span>)
        </h2>
      </div>

      <button
        type="button"
        id="fecharModalAlunosOnline"
        class="adm-modal-close"
        aria-label="Fechar"
      >
        &times;
      </button>

    </div>

    <div class="adm-modal-body">

      <table
        class="adm-table"
        id="tabelaAlunosOnline"
        style="display:none;"
      >

        <thead>
          <tr>
            <th>Nome</th>
            <th>E-mail</th>
          </tr>
        </thead>

        <tbody></tbody>

      </table>

      <p
        class="adm-vazio"
        id="vazioAlunosOnline"
        style="display:none;"
      >
        Ninguém online no momento.
      </p>

      <p
        class="adm-vazio"
        id="carregandoAlunosOnline"
      >
        Carregando...
      </p>

    </div>

  </div>

</div>


<!-- ========================================================= -->
<!-- Últimas inscrições -->
<!-- ========================================================= -->

<div class="adm-box">

  <div class="adm-box-head">
    <h2><i class="fa-solid fa-clock-rotate-left"></i> Últimas inscrições</h2>

    <% if (podeMatriculas) { %><a href="/inscricoes" class="adm-link">Ver todas</a><% } %>
  </div>

  <% if (!ultimas.length) { %>

    <p class="adm-vazio">
      Nenhuma inscrição ainda.
    </p>

  <% } else { %>

    <table class="adm-table adm-table-cards">

      <thead>
        <tr>
          <th>Aluno</th>
          <th>Curso</th>
          <th>Pago</th>
          <th>Status</th>
          <th>Quando</th>
        </tr>
      </thead>

      <tbody>

        <% ultimas.forEach(function(u){ var m = u.m, r = u.r; %>

          <tr>

          <% if (u.tipo === 'rapida') { %>

            <td>
              <<%= podeTurmas ? 'a href="/matricula-rapida"' : 'span' %> class="adm-link-aluno"><strong><%= r.nome || '(sem nome)' %></strong></<%= podeTurmas ? 'a' : 'span' %>>
              <span class="adm-tag-rapida" title="Inscrição pelo site da instituição"><i class="fa-solid fa-bolt"></i> Matrícula rápida</span>
            </td>

            <td><%= r.curso %></td>

            <td><%= r.valor ? formatBRL(r.valor) : '—' %></td>

            <td><span class="badge pend" title="Pagou só a inscrição (na matrícula rápida); falta pagar a matrícula">PENDENTE</span><small class="adm-valor-de" title="Ainda não foi encaixado numa turma: Turmas → Matrícula rápida">sem turma · falta encaixar</small></td>

          <% } else { %>

            <td>
              <a href="/alunos/<%= m.aluno.id %>/matriculas" class="adm-link-aluno">
                <strong><%= m.aluno.nome %></strong>
              </a>
              <% if (u.rapida || valorMatricula(m).rapida) { %><span class="adm-tag-rapida" title="Taxa de inscrição paga na matrícula rápida (site da instituição)"><i class="fa-solid fa-bolt"></i> Matrícula rápida</span><% } %>
            </td>

            <td>
              <%= m.turma.curso.nome %>
            </td>

            <td>
              <%
                // O que já entrou, como no Financeiro: matrícula paga = total; só a inscrição paga =
                // a taxa, com o total da matrícula embaixo.
                var _vm = valorMatricula(m);
                var _soTaxa = m.statusPagamento === 'PENDENTE' && m.taxaConfirmada;
                var _pago = _soTaxa ? (Number(m.valorTaxaMatricula) || 0) : _vm.total;
              %>
              <span class="<%= _vm.rapida ? 'adm-valor-mr' : '' %>"<% if (_vm.rapida) { %> title="Curso <%= formatBRL(_vm.curso) %> + taxa <%= formatBRL(_vm.taxa) %> paga na matrícula rápida"<% } %>><%= formatBRL(_pago) %></span>
              <% if (_soTaxa) { %><small class="adm-valor-de">de <%= formatBRL(_vm.total) %></small><% } %>
            </td>

            <td>
              <%- statusMatricula(m) %>
            </td>

          <% } %>

            <td>
              <%= u.quando.toLocaleDateString('pt-BR', {
                timeZone: 'America/Sao_Paulo'
              }) %>
            </td>

          </tr>

        <% }) %>

      </tbody>

    </table>

  <% } %>

</div>


<%- include('foot') %>


<script>

  /* =========================================================
     Alunos online em tempo real
     ========================================================= */

  const es = new EventSource('/stats/online/stream');

  es.onmessage = (e) => {

    document.getElementById('alunosOnline').textContent = e.data;

  };


  /* =========================================================
     Modal: Entraram hoje
     ========================================================= */

  const cardAlunosHoje =
    document.getElementById('cardAlunosHoje');

  const modalAlunosHoje =
    document.getElementById('modalAlunosHoje');

  const fecharModalAlunosHoje =
    document.getElementById('fecharModalAlunosHoje');


  cardAlunosHoje.addEventListener('click', () => {

    modalAlunosHoje.classList.add('aberto');

  });


  fecharModalAlunosHoje.addEventListener('click', () => {

    modalAlunosHoje.classList.remove('aberto');

  });


  modalAlunosHoje.addEventListener('click', (e) => {

    if (e.target === modalAlunosHoje) {

      modalAlunosHoje.classList.remove('aberto');

    }

  });


  /* =========================================================
     Modal: Alunos online agora
     ========================================================= */

  const cardAlunosOnline =
    document.getElementById('cardAlunosOnline');

  const modalAlunosOnline =
    document.getElementById('modalAlunosOnline');

  const fecharModalAlunosOnline =
    document.getElementById('fecharModalAlunosOnline');

  const tabelaOnline =
    document.getElementById('tabelaAlunosOnline');

  const tbodyOnline =
    tabelaOnline.querySelector('tbody');

  const vazioOnline =
    document.getElementById('vazioAlunosOnline');

  const carregandoOnline =
    document.getElementById('carregandoAlunosOnline');

  const qtdOnlineModal =
    document.getElementById('qtdOnlineModal');


  async function carregarAlunosOnline() {

    tabelaOnline.style.display = 'none';

    vazioOnline.style.display = 'none';

    carregandoOnline.style.display = 'block';

    try {

      const res =
        await fetch('/stats/online/lista');

      const alunos =
        await res.json();

      qtdOnlineModal.textContent =
        alunos.length;

      tbodyOnline.innerHTML = '';

      carregandoOnline.style.display =
        'none';


      if (!alunos.length) {

        vazioOnline.style.display =
          'block';

        return;

      }


      alunos.forEach(a => {

        const tr =
          document.createElement('tr');


        const tdNome =
          document.createElement('td');

        const link =
          document.createElement('a');

        // 💡 Trocado /alunos/:id/editar por /alunos/:id/matriculas: rota
        // acessível também com 'painel:leitura', evitando 403 pra quem
        // não tem 'aluno:gerenciar'.
        link.href =
          `/alunos/${a.id}/matriculas`;

        link.className =
          'adm-link-aluno';

        const strongNome =
          document.createElement('strong');

        strongNome.textContent =
          a.nome;

        link.appendChild(strongNome);

        tdNome.appendChild(link);


        const tdEmail =
          document.createElement('td');

        tdEmail.textContent =
          a.email;


        tr.appendChild(tdNome);

        tr.appendChild(tdEmail);

        tbodyOnline.appendChild(tr);

      });


      tabelaOnline.style.display =
        'table';

    } catch (e) {

      carregandoOnline.textContent =
        'Erro ao carregar a lista.';

    }

  }


  cardAlunosOnline.addEventListener('click', () => {

    modalAlunosOnline.classList.add('aberto');

    carregarAlunosOnline();

  });


  fecharModalAlunosOnline.addEventListener('click', () => {

    modalAlunosOnline.classList.remove('aberto');

  });


  modalAlunosOnline.addEventListener('click', (e) => {

    if (e.target === modalAlunosOnline) {

      modalAlunosOnline.classList.remove('aberto');

    }

  });


  /* Modal: visitantes do site */
  const cardVisitas = document.getElementById('cardVisitas');
  const modalVisitas = document.getElementById('modalVisitas');
  if (cardVisitas && modalVisitas) {
    cardVisitas.addEventListener('click', () => modalVisitas.classList.add('aberto'));
    document.getElementById('fecharModalVisitas').addEventListener('click', () => modalVisitas.classList.remove('aberto'));
    modalVisitas.addEventListener('click', (e) => { if (e.target === modalVisitas) modalVisitas.classList.remove('aberto'); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') modalVisitas.classList.remove('aberto'); });
  }


  /* =========================================================
     ESC fecha os modais
     ========================================================= */

  document.addEventListener('keydown', (e) => {

    if (e.key === 'Escape') {

      modalAlunosHoje.classList.remove('aberto');

      modalAlunosOnline.classList.remove('aberto');

    }

  });

</script>