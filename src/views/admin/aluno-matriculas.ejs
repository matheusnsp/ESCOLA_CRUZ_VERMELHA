<%- include('head', { titulo: 'Matrículas do aluno' }) %>
<%- include('header', { ativo: 'alunos' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Matrículas de <%= aluno.nome %></h1>
  <a href="/alunos" class="adm-voltar">
    <i class="fa-solid fa-arrow-left"></i> Voltar
  </a>
</div>

<% if (ok) { %>
  <div class="adm-ok"><i class="fa-solid fa-circle-check"></i> <%= ok %></div>
<% } %>

<div class="adm-box">
  <% if (!matriculas.length) { %>

    <div class="adm-vazio">Este aluno ainda não possui matrículas.</div>

  <% } else { %>

    <div class="adm-linhas">
      <% matriculas.forEach(function (m) { %>
      <div>
        <div class="adm-linha-txt">
          <strong><%= m.turma.curso.nome %></strong>
          <div><small class="adm-mut"><%= m.turma.diasSemana %> · <%= m.turma.horario %></small></div>
        </div>

        <div class="adm-linha-acao">
          <% if (m.taxaConfirmada) { %>
            <span class="adm-selo-ok"><i class="fa-solid fa-check"></i> Confirmada</span>
          <% } else { %>
            <form method="POST" action="/alunos/<%= aluno.id %>/matriculas/<%= m.id %>/confirmar-taxa">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="adm-btn-mini">
                <i class="fa-solid fa-money-bill"></i> Confirmar (R$ 100)
              </button>
            </form>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>

  <% } %>
</div>

<%- include('foot') %>