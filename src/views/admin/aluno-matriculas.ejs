<%- include('head', { titulo: aluno.nome }) %>
<%- include('header', { ativo: 'alunos' }) %>

<div class="adm-h1-row">
  <h1 class="adm-h1">Inscrições de <%= aluno.nome %></h1>

  <div class="adm-pend-acoes">
    <% if (pode('aluno:gerenciar')) { %>
      <a href="/alunos/<%= aluno.id %>/editar" class="adm-pend-btn"><i class="fa-solid fa-pen-to-square"></i> Editar dados</a>
    <% } %>
    <a href="/alunos" class="adm-link"><i class="fa-solid fa-arrow-left"></i> Voltar</a>
  </div>
</div>

<% if (ok) { %>
  <div class="adm-ok">
    <i class="fa-solid fa-circle-check"></i> <%= ok %>
  </div>
<% } %>

<!-- DADOS DO ALUNO: em grade, campos vazios aparecem como "não informado" -->
<%
  const _nd = '<span class="adm-mut">não informado</span>';
  const _cel = String(aluno.celular || '').replace(/\D/g, '');
  const _celFmt = _cel.length === 11 ? `(${_cel.slice(0,2)}) ${_cel.slice(2,7)}-${_cel.slice(7)}`
                : _cel.length === 10 ? `(${_cel.slice(0,2)}) ${_cel.slice(2,6)}-${_cel.slice(6)}` : aluno.celular;
%>
<div class="adm-box adm-espaco adm-ficha">
  <div class="adm-ficha-item">
    <small>E-mail</small>
    <span><%= aluno.email %></span>
  </div>
  <div class="adm-ficha-item">
    <small>Celular</small>
    <span><% if (_celFmt) { %><%= _celFmt %><% } else { %><%- _nd %><% } %></span>
  </div>
  <div class="adm-ficha-item">
    <% const _doc = documentoAluno(aluno); %>
    <small><%= _doc ? _doc.tipo : 'Documento' %></small>
    <span><% if (_doc) { %><%= _doc.numero %><% } else { %><%- _nd %><% } %></span>
  </div>
  <div class="adm-ficha-item">
    <small>Escolaridade</small>
    <span><% if (aluno.escolaridade) { %><%= aluno.escolaridade %><%= aluno.escolaridadeSituacao ? ' (' + aluno.escolaridadeSituacao + ')' : '' %><% } else { %><%- _nd %><% } %></span>
  </div>
  <div class="adm-ficha-item">
    <small>Cadastrado em</small>
    <span><%= new Date(aluno.criadoEm).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %>
      <% if (aluno.bloqueioTotal) { %> <span class="badge canc">Banido</span><% } %></span>
  </div>
</div>

<!-- INSCRIÇÕES -->
<%- include('legenda-status') %>

<% if (typeof comprovante !== 'undefined' && comprovante && pode('aluno:gerenciar')) { var _rc = { enviado: 'para conferir', aprovado: 'aprovado', recusado: 'recusado' }; %>
<a href="/comprovantes-saude?aba=<%= comprovante.status === 'enviado' ? 'conferir' : comprovante.status === 'recusado' ? 'recusados' : 'aprovados' %>" class="adm-alerta adm-alerta-comprovante">
  <i class="fa-solid fa-user-doctor"></i>
  <span>Comprovante da área da saúde: <b><%= _rc[comprovante.status] || comprovante.status %></b><%= comprovante.status === 'recusado' && comprovante.motivo ? ' (' + comprovante.motivo + ')' : '' %></span>
  <i class="fa-solid fa-arrow-right"></i>
</a>
<% } %>

<div class="adm-box">

  <% if (!matriculas.length) { %>

    <p class="adm-vazio">
      Este aluno ainda não possui inscrições.
    </p>

  <% } else { %>

    <table class="adm-table adm-table-cards adm-table-fixa">

      <colgroup>
        <col>
        <col>
        <col>
        <col>
        <col>
        <col>
      </colgroup>

      <thead>
        <tr>
          <th>Curso / Turma</th>
          <th>Plano</th>
          <th>Valor</th>
          <th>Status</th>
          <th>Alimento</th>
          <th>Ações</th>
        </tr>
      </thead>

      <tbody>

        <% matriculas.forEach(function (m) { %>

          <tr>

            <!-- CURSO / TURMA -->
            <td>

              <strong>
                <%= m.turma.curso.nome %>
              </strong>

              <!-- DATA DA TURMA -->
              <br>

              <small class="adm-mut">
                <i class="fa-regular fa-calendar"></i>
                Turma:
                <%= new Date(m.turma.inicioPrevisto).toLocaleDateString('pt-BR', {
                  timeZone: 'America/Sao_Paulo',
                  weekday: 'long',
                  day: '2-digit',
                  month: '2-digit',
                  year: 'numeric'
                }) %>
              </small>

              <!-- DATA DA INSCRIÇÃO -->
              <br>

              <small class="adm-mut">
                <i class="fa-regular fa-clock"></i>
                Inscrição:
                <%= new Date(m.criadoEm).toLocaleDateString('pt-BR', {
                  timeZone: 'America/Sao_Paulo'
                }) %>
              </small>

              <!-- DIAS / HORÁRIO -->
              <% if (m.turma.diasSemana || m.turma.horario) { %>

                <br>

                <small class="adm-mut">
                  <%= [m.turma.diasSemana, m.turma.horario]
                        .filter(Boolean)
                        .join(' · ') %>
                </small>

              <% } %>

            </td>

            <!-- PLANO / STATUS TAXA -->
            <td>

              <% if (!m.taxaConfirmada) { %>

                <span class="adm-mut">
                  Aguardando confirmação da taxa de inscrição
                </span>

              <% } else { %>

                <%= m.plano === 'A_VISTA' ? 'À vista' : 'Parcelado' %>

                <br>

                <small class="adm-mut">
                  <%= m.forma %>
                </small>

              <% } %>

            </td>

            <!-- VALOR -->
            <td>

              <% if (m.taxaConfirmada) { %>

                <% var _vm = valorMatricula(m); %><% if (_vm.rapida) { %><span class="adm-valor-mr" title="Curso <%= formatBRL(_vm.curso) %> + taxa <%= formatBRL(_vm.taxa) %> paga na matrícula rápida"><%= formatBRL(_vm.total) %></span><% } else { %><%= formatBRL(_vm.total) %><% } %>

              <% } else { %>

                <span class="adm-mut">—</span>

              <% } %>

            </td>

            <!-- STATUS -->
            <td>

              <% if (!m.taxaConfirmada) { %>

                <span class="adm-mut">
                  Taxa de inscrição pendente
                </span>

              <% } else { %>

                <%- statusMatricula(m) %>

              <% } %>

            </td>

            <!-- ALIMENTO -->
            <td>

              <% if (m.taxaConfirmada) { %>

                <span class="adm-chip estatico <%= m.alimentoEntregue ? 'on' : '' %>">

                  <i class="fa-solid <%= m.alimentoEntregue
                    ? 'fa-check'
                    : 'fa-xmark' %>"></i>

                  1kg

                </span>

              <% } else { %>

                <span class="adm-mut">—</span>

              <% } %>

            </td>

            <!-- AÇÕES (as mesmas da tela de Inscrições: acoes-matricula.ejs) -->
            <td class="adm-acoes">
              <%- include('acoes-matricula', { m: Object.assign({}, m, { aluno: aluno }) }) %>
            </td>
          </tr>

        <% }) %>

      </tbody>

    </table>

  <% } %>

</div>

<%- include('foot') %>