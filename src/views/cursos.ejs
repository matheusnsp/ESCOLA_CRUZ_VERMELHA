<%- include('partials/site-head', {
  titulo: 'Cursos',
  bodyClass: 'v-claro',
  descricao: 'Catálogo de cursos presenciais da Escola de Educação e Saúde da Cruz Vermelha Brasileira no Rio de Janeiro.'
}) %>
<%- include('partials/site-header', { menuAtivo: 'cursos' }) %>

<%
  var _cats = vitrine.categoriasEmUso(cursos);
  var _abertos = cursos.filter(function (c) { return c.turmas && c.turmas.length; }).length;
%>

<main>
  <section class="v-topo">
    <div class="v-wrap">
      <p class="v-olho">Escola de Educação e Saúde CVB-RJ</p>
      <h1>Cursos disponíveis</h1>
      <p>Capacitação presencial da Cruz Vermelha Brasileira no Centro do Rio. Escolha um curso, confira as turmas abertas e faça sua inscrição.</p>
    </div>
  </section>

  <section class="v-catalogo">
    <div class="v-wrap">
      <% if (!cursos.length) { %>
        <div class="v-vazio">
          <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
          Nenhum curso disponível no momento. Novas capacitações são publicadas com frequência; volte em breve.
        </div>
      <% } else { %>
        <div class="v-catalogo-barra">
          <% if (_cats.length >= 2) { %>
            <div class="v-filtros" data-filtros="gradeCursos" role="group" aria-label="Filtrar cursos por área">
              <button type="button" class="v-chip" data-valor="" aria-pressed="true">Todos <span><%= cursos.length %></span></button>
              <% _cats.forEach(function (c) { %>
                <button type="button" class="v-chip" data-valor="<%= c.nome %>" aria-pressed="false"><%= c.nome %> <span><%= c.n %></span></button>
              <% }) %>
            </div>
          <% } else { %><span></span><% } %>
          <span class="v-catalogo-n"><%= cursos.length %> <%= cursos.length === 1 ? 'curso' : 'cursos' %><%= _abertos ? ' · ' + _abertos + ' com inscrições abertas' : '' %></span>
        </div>
        <div class="v-grade v-grade-catalogo" id="gradeCursos">
          <% cursos.forEach(function (curso) { %>
            <%- include('partials/v-card', { curso: curso, largura: 4, vitrine: vitrine, taxaExibicao: taxaExibicao, cfgMap: cfgMap }) %>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/site-footer') %>
