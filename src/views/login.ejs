<%- include('partials/head', { titulo: 'Entrar' }) %>

<main class="auth-wrap">
  <div class="auth-card">

    <div class="auth-brand">
      <img
        src="/img/logo-cvb-rj.webp"
        alt="Cruz Vermelha Brasileira — Rio de Janeiro"
        class="auth-logo"
      >

      <div class="auth-brand-text">
        <strong>ESCOLA DE EDUCAÇÃO</strong>
        <span>E SAÚDE CVB-RJ</span>
      </div>
    </div>

    <h1>Entrar</h1>
    <p class="auth-sub">Acesse sua conta para ver seus cursos.</p>

    <% if (typeof sucesso !== 'undefined' && sucesso) { %>
      <div class="auth-erros ok">
        <p>
          <i class="fa-solid fa-circle-check"></i>
          <%= sucesso %>
        </p>
      </div>
    <% } %>

    <% if (erro) { %>
      <div class="auth-erros" role="alert">
        <p>
          <i class="fa-solid fa-circle-exclamation"></i>
          <%= erro %>
        </p>
      </div>
    <% } %>

    <form method="POST" action="/login" novalidate>

      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <label class="auth-field">
        <span>E-mail ou CPF</span>
        <input
          type="text"
          name="identificador"
          value="<%= typeof identificador !== 'undefined' ? identificador : '' %>"
          autocomplete="username"
          required
        >
      </label>

      <label class="auth-field">
        <span>Senha</span>
        <input
          type="password"
          name="senha"
          autocomplete="current-password"
          required
        >
      </label>

      <button type="submit" class="auth-btn">
        Entrar
      </button>

    </form>

    <p class="auth-alt discreto auth-alt-junto">
      <a href="/esqueci-senha">Esqueci minha senha</a>
    </p>

    <p class="auth-alt">
      Não tem conta? <a href="/cadastro">Criar conta</a>
    </p>

  </div>
</main>

<script src="/js/senha.js"></script>
<%- include('partials/foot') %>