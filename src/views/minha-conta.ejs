<%- include('partials/site-head', { titulo: 'Minha conta' }) %>
<%- include('partials/site-header') %>

<main class="cx">
  <div class="ct-wrap">

    <% if (inscrito) { %>
      <div class="ct-ok">
        <i class="fa-solid fa-circle-check"></i>
        Inscrição registrada. Ela fica pendente até a confirmação do pagamento.
      </div>
    <% } %>

    <%
      // Campos que realmente faltam preencher — mesma lógica usada em
      // completar-dados.ejs, pra manter os dois lugares consistentes.
      var faltaCep        = !usuario.cep;
      var faltaLogradouro = !usuario.logradouro;
      var faltaNumero     = !usuario.numero;
      var faltaBairro     = !usuario.bairro;
      var faltaCidade     = !usuario.cidade;
      var faltaUf         = !usuario.uf;

      var faltaEndereco = faltaCep || faltaLogradouro || faltaNumero || faltaBairro || faltaCidade || faltaUf;

      var faltaEscolaridade = !usuario.escolaridade;
      var faltaSituacao     = !usuario.escolaridadeSituacao;

      var cadastroIncompleto = faltaEndereco || faltaEscolaridade || faltaSituacao;
    %>

    <% if (cadastroIncompleto) { %>
      <div class="ct-aviso-topo">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>Seu cadastro está incompleto. Complete seus dados para evitar problemas com sua matrícula.</span>
        <a href="/completar-dados">Completar agora</a>
      </div>
    <% } %>

    <% if (senhaPrecisaTrocar) { %>
      <div class="ct-aviso-topo">
        <i class="fa-solid fa-key"></i>
        <span>Sua senha atual não atende aos requisitos mínimos de segurança. Recomendamos trocá-la agora.</span>
        <a href="/minha-conta?sec=seguranca">Trocar senha</a>
      </div>
    <% } %>

    <header class="ct-topo">
      <p class="ct-olho">Área do aluno</p>
      <h1>Minha conta</h1>
    </header>

    <div class="ct-layout">

      <!-- ══ Lateral ══════════════════════════════════════════════════════ -->
      <aside class="ct-side">
        <div class="ct-perfil">
          <div class="ct-avatar"><%= usuario.nome.charAt(0).toUpperCase() %></div>
          <div class="ct-perfil-txt">
            <strong><%= usuario.nome.split(' ')[0] %></strong>
            <span title="<%= usuario.email %>"><%= usuario.email %></span>
          </div>
        </div>

        <nav class="ct-nav">
          <a href="/minha-conta?sec=inscricoes" class="<%= sec === 'inscricoes' ? 'ativo' : '' %>">
            <i class="fa-solid fa-graduation-cap"></i> Inscrições
          </a>
          <a href="/minha-conta?sec=dados" class="<%= sec === 'dados' ? 'ativo' : '' %>">
            <i class="fa-solid fa-id-card"></i> Meus dados
          </a>
          <a href="/minha-conta?sec=seguranca" class="<%= sec === 'seguranca' ? 'ativo' : '' %>">
            <i class="fa-solid fa-key"></i> Segurança
          </a>
          <a href="/minha-conta?sec=excluir" class="perigo <%= sec === 'excluir' ? 'ativo' : '' %>">
            <i class="fa-solid fa-trash"></i> Excluir conta
          </a>
        </nav>
      </aside>

      <!-- ══ Conteúdo ═════════════════════════════════════════════════════ -->
      <section class="ct-main">

        <!-- ── Inscrições ────────────────────────────────────────────────── -->
        <% if (sec === 'inscricoes') { %>

          <div class="ct-head">
            <h2>Minhas inscrições</h2>
            <a href="/cursos" class="ct-head-acao">
              <i class="fa-solid fa-plus"></i> Nova inscrição
            </a>
          </div>

          <% if (!matriculas.length) { %>

            <div class="ct-vazio">
              <i class="fa-regular fa-folder-open"></i>
              <p>Você ainda não tem inscrições. Escolha um curso e garanta sua
              vaga na próxima turma.</p>
              <a href="/cursos">Ver cursos disponíveis <i class="fa-solid fa-arrow-right"></i></a>
            </div>

          <% } else { %>

            <div class="ct-lista">
              <% matriculas.forEach(function (m) { %>
              <%
                // PAGO e PARCELADO são os dois estados de "quitado" — PARCELADO
                // significa cartão aprovado em N vezes, não pagamento pendente.
                var pago = m.statusPagamento === 'PAGO' || m.statusPagamento === 'PARCELADO';
                var cls  = pago ? 'pago' : (m.statusPagamento === 'PENDENTE' ? 'pendente' : 'cancelado');

                // Estorno/cancelamento devolvem o valor: nem confirmada, nem
                // aguardando — é um terceiro estado.
                var devolvido = m.statusPagamento === 'ESTORNADO' || m.statusPagamento === 'CANCELADO';
                var taxaOk = (m.taxaConfirmada || pago) && !devolvido;

                var labelPlano = m.plano === 'A_VISTA'   ? 'À vista'
                               : m.plano === 'PRESENCIAL' ? 'Presencial'
                               : 'Parcelado';
              %>
              <article class="ct-insc">

                <a class="card-link-overlay" href="/cursos/<%= m.turma.curso.id %>"
                   aria-label="Ver <%= m.turma.curso.nome %>"></a>

                <div class="ct-insc-capa">
                  <% if (m.turma.curso.imagemUrl) { %>
                    <img src="<%= m.turma.curso.imagemUrl %>" alt="<%= m.turma.curso.nome %>" loading="lazy">
                  <% } else { %>
                    <div class="ct-insc-semfoto"><i class="fa-solid fa-kit-medical"></i></div>
                  <% } %>
                </div>

                <div class="ct-insc-corpo">

                  <div class="ct-insc-topo">
                    <h3><%= m.turma.curso.nome %></h3>
                    <span class="ct-selo ct-selo-<%= cls %>"><%= m.statusPagamento %></span>
                  </div>

                  <p class="ct-insc-sub">
                    <% if (m.turma.aulas && m.turma.aulas.length) { %><%= m.turma.aulas[0].horario %> · <% } %>
                    início em <b><%= new Date(m.turma.inicioPrevisto).toLocaleDateString('pt-BR') %></b>
                    · inscrito em <%= new Date(m.criadoEm).toLocaleDateString('pt-BR') %>
                  </p>

                  <div class="ct-pills">
                    <% if (taxaOk) { %>
                      <span class="ct-pill ct-pill-ok">
                        <i class="fa-solid fa-circle-check"></i> Taxa de inscrição confirmada
                      </span>
                    <% } else if (devolvido) { %>
                      <span class="ct-pill ct-pill-devolvido">
                        <i class="fa-solid fa-rotate-left"></i> Valor devolvido
                      </span>
                    <% } else { %>
                      <span class="ct-pill ct-pill-espera">
                        <i class="fa-regular fa-clock"></i> Taxa aguardando confirmação
                      </span>
                    <% } %>
                  </div>

                  <div class="ct-insc-pe">
                    <span class="ct-insc-plano">
                      <%= labelPlano %><% if (m.plano !== 'PRESENCIAL') { %> · <%= m.forma %><% } %>
                    </span>
                    <span class="ct-insc-valor num"><%= formatBRL(m.valorCurso) %></span>
                  </div>

                  <% if ((m.nota !== null && m.nota !== undefined) || m.situacao) { %>
                  <div class="ct-nota">
                    <% if (m.nota !== null && m.nota !== undefined) { %>
                      <span>Nota: <strong><%= m.nota %></strong></span>
                    <% } %>
                    <% if (m.situacao) { %>
                      <span class="ct-selo ct-selo-<%= m.situacao === 'APROVADO' ? 'pago' : 'cancelado' %>">
                        <%= m.situacao === 'APROVADO' ? 'Aprovado' : 'Reprovado' %>
                      </span>
                    <% } %>
                  </div>
                  <% } %>

                </div>
              </article>
              <% }) %>
            </div>

          <% } %>

        <!-- ── Meus dados ────────────────────────────────────────────────── -->
        <% } else if (sec === 'dados') { %>

          <div class="ct-head"><h2>Meus dados</h2></div>

          <div class="ct-card">

            <% if (typeof salvo !== 'undefined' && salvo) { %>
              <div class="ct-ok">
                <i class="fa-solid fa-circle-check"></i> Dados atualizados.
              </div>
            <% } %>
            <% if (typeof erroDados !== 'undefined' && erroDados) { %>
              <div class="ct-erro">
                <i class="fa-solid fa-circle-exclamation"></i> <%= erroDados %>
              </div>
            <% } %>

            <form method="POST" action="/conta/dados" novalidate class="ct-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <label class="ct-campo">
                <span>Escolaridade</span>
                <select name="escolaridade" required>
                  <option value="" disabled <%= usuario.escolaridade ? '' : 'selected' %>>Selecione...</option>
                  <% escolaridades.forEach(function (e) { %>
                    <option value="<%= e %>" <%= (usuario.escolaridade === e) ? 'selected' : '' %>><%= e %></option>
                  <% }) %>
                </select>
              </label>

              <label class="ct-campo">
                <span>Situação</span>
                <select name="escolaridadeSituacao" required>
                  <option value="" disabled <%= usuario.escolaridadeSituacao ? '' : 'selected' %>>Cursando ou completo?</option>
                  <% situacoes.forEach(function (s) { %>
                    <option value="<%= s %>" <%= (usuario.escolaridadeSituacao === s) ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
              </label>

              <label class="ct-campo">
                <span>Gênero <em>(opcional)</em></span>
                <select name="genero">
                  <option value="">— selecione —</option>
                  <% generos.forEach(function (g) { %>
                    <option value="<%= g %>" <%= (usuario.genero === g) ? 'selected' : '' %>><%= g %></option>
                  <% }) %>
                </select>
              </label>

              <!-- ── Endereço: aqui é só leitura/preservação. Se estiver
                   faltando, não oferecemos pra preencher nesta aba — quem
                   estiver com cadastro incompleto vai pelo banner do topo
                   até /completar-dados. ── -->
              <input type="hidden" name="cep" value="<%= usuario.cep || '' %>">
              <input type="hidden" name="logradouro" value="<%= usuario.logradouro || '' %>">
              <input type="hidden" name="numero" value="<%= usuario.numero || '' %>">
              <input type="hidden" name="complemento" value="<%= usuario.complemento || '' %>">
              <input type="hidden" name="bairro" value="<%= usuario.bairro || '' %>">
              <input type="hidden" name="cidade" value="<%= usuario.cidade || '' %>">
              <input type="hidden" name="uf" value="<%= usuario.uf || '' %>">

              <button type="submit" class="ct-btn">Salvar alterações</button>
            </form>

            <div class="ct-dados">
              <div><span>Nome completo</span><strong><%= usuario.nome %></strong></div>
              <div><span>E-mail</span><strong><%= usuario.email %></strong></div>
              <div>
                <span><%= usuario.tipoDocumento === 'PASSAPORTE' ? 'Passaporte' : 'CPF/CNPJ' %></span>
                <strong><%= docMascarado %></strong>
              </div>
              <% if (usuario.tipoDocumento === 'PASSAPORTE' && usuario.paisOrigem) { %>
                <div><span>País de origem</span><strong><%= usuario.paisOrigem %></strong></div>
              <% } %>
              <% if (!faltaEndereco) { %>
                <div><span>Endereço</span>
                  <strong><%= usuario.logradouro %>, <%= usuario.numero %><% if (usuario.complemento) { %> - <%= usuario.complemento %><% } %> · <%= usuario.bairro %>, <%= usuario.cidade %>/<%= usuario.uf %> · <%= usuario.cep %></strong>
                </div>
              <% } %>
              <div><span>E-mail confirmado</span><strong><%= usuario.emailVerificado ? 'Sim' : 'Não' %></strong></div>
              <div><span>Cadastro em</span><strong class="num"><%= new Date(usuario.criadoEm).toLocaleDateString('pt-BR') %></strong></div>
            </div>

            <p class="ct-aviso">
              <i class="fa-solid fa-lock"></i>
              Nome, e-mail e documento não podem ser alterados por aqui — o nome
              vai no certificado, e o e-mail e o documento identificam você.
              Para corrigir algum deles, fale com a secretaria.
            </p>

          </div>

        <!-- ── Segurança ─────────────────────────────────────────────────── -->
        <% } else if (sec === 'seguranca') { %>

          <div class="ct-head"><h2>Segurança</h2></div>

          <div class="ct-card">

            <% if (senhaPrecisaTrocar) { %>
              <div class="ct-aviso">
                <i class="fa-solid fa-circle-exclamation"></i>
                Sua senha atual é temporária (gerada a partir do seu documento). Defina uma senha só sua.
              </div>
            <% } %>

            <% if (typeof senhaAlterada !== 'undefined' && senhaAlterada) { %>
              <div class="ct-ok"><i class="fa-solid fa-circle-check"></i> Senha alterada com sucesso.</div>
            <% } %>
            <% if (typeof erroSenha !== 'undefined' && erroSenha) { %>
              <div class="ct-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erroSenha %></div>
            <% } %>

            <form method="POST" action="/conta/senha" novalidate class="ct-form" style="max-width:400px;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="nome" value="<%= usuario.nome %>">
              <input type="hidden" name="email" value="<%= usuario.email %>">

              <label class="ct-campo">
                <span>Senha atual</span>
                <input type="password" name="senhaAtual" required autocomplete="current-password">
              </label>

              <label class="ct-campo">
                <span>Nova senha</span>
                <input type="password" name="novaSenha" required minlength="10" autocomplete="new-password">
                <div class="senha-forca" id="senhaForca" hidden>
                  <div class="senha-barra"><span></span></div>
                  <small class="senha-label"></small>
                </div>
              </label>

              <label class="ct-campo">
                <span>Confirmar nova senha</span>
                <input type="password" name="confirmarNovaSenha" required autocomplete="new-password">
              </label>

              <button type="submit" class="ct-btn">Salvar nova senha</button>
            </form>
          </div>

        <!-- ── Excluir conta ─────────────────────────────────────────────── -->
        <% } else if (sec === 'excluir') { %>

          <div class="ct-head"><h2>Excluir conta</h2></div>

          <div class="ct-card">
            <p class="ct-grupo-nota" style="margin-bottom:18px;">
              Esta ação é permanente e remove seus dados. Não é possível excluir
              com matrículas ativas.
            </p>

            <% if (erro) { %>
              <div class="ct-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
            <% } %>

            <% if (matriculasAtivas > 0) { %>
              <div class="ct-bloqueio">
                <i class="fa-solid fa-lock"></i>
                Você tem <%= matriculasAtivas %> matrícula(s) ativa(s). Resolva
                com a secretaria antes de excluir.
              </div>
            <% } else { %>
              <form method="POST" action="/conta/excluir" novalidate class="ct-form" style="max-width:400px;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="ct-campo">
                  <span>Confirme sua senha para excluir</span>
                  <input type="password" name="senha" required autocomplete="current-password">
                </label>
                <button type="submit" class="ct-btn ct-btn-perigo">Excluir minha conta</button>
              </form>
            <% } %>
          </div>

        <% } %>

      </section>
    </div>

  </div>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/zxcvbn/4.4.2/zxcvbn.js"></script>
<script src="/js/senha.js"></script>
<%- include('partials/site-footer') %>